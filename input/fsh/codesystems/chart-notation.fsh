CodeSystem: SGHILabourCareGuideNotationCodeSystem
Id: labour-care-guide-notation
Title: "WHO Labour Care Guide Notation"
Description: "The marks the WHO Labour Care Guide (2020) is written in. One mark can mean different things on different rows, as it does on paper: N is no for a companion and none for a deceleration."
* ^status = #active
* ^experimental = false
* ^content = #complete
* ^caseSensitive = true
* #Y "Yes"
* #N "No, or none" "No for companion, pain relief and oral fluid; none for a fetal heart rate deceleration."
* #D "Declined" "Offered and declined."
* #MO "Mobile" "The woman is up and mobile."
* #SP "Supine" "The woman is lying on her back."
* #E "Early deceleration"
* #L "Late deceleration"
* #V "Variable deceleration"
* #I "Membranes intact"
* #C "Clear liquor"
* #M "Meconium-stained liquor"
* #"M+" "Meconium-stained liquor, thin"
* #"M++" "Meconium-stained liquor, moderate"
* #"M+++" "Meconium-stained liquor, thick"
* #B "Blood-stained liquor"
* #A "Anterior" "Fetal position: occiput anterior."
* #P "Posterior" "Fetal position: occiput posterior."
* #T "Transverse" "Fetal position: occiput transverse."
* #0 "None" "Caput or moulding: none."
* #"+" "One plus" "Caput or moulding: first degree. Urine dipstick: one plus."
* #"++" "Two plus" "Caput or moulding: second degree. Urine dipstick: two plus."
* #"+++" "Three plus" "Caput or moulding: third degree. Urine dipstick: three plus."
* #"++++" "Four plus" "Urine dipstick: four plus."
* #"-" "Negative" "Urine dipstick: negative."

CodeSystem: SGHIACVPUCodeSystem
Id: acvpu-codesystem
Title: "SGHI ACVPU Code System"
Description: "The ACVPU scale as the National Early Warning Score 2 uses it. The codes are the letters so an observation chart can print them."
* ^status = #active
* ^experimental = false
* ^content = #complete
* ^caseSensitive = true
* #A "Alert"
* #C "New confusion" "New onset of confusion, disorientation or agitation."
* #V "Responds to voice"
* #P "Responds to pain"
* #U "Unresponsive"
