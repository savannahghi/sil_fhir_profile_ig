// ── Admission consent clauses (shared with the house rules form) ──
* #consent.treatment "I wish to undertake the rehabilitation programme, which has been explained to me, and I ..."
  * ^definition = "I wish to undertake the rehabilitation programme, which has been explained to me, and I consent to treatment as advised and recommended."
* #consent.duration "I understand that the programme takes a minimum of ninety (90) days, and I agree to the ..."
  * ^definition = "I understand that the programme takes a minimum of ninety (90) days, and I agree to the terms and conditions below for that period."
* #cardinalRules.drugs "Drugs: I shall not at any time use or be found in possession of drugs, within or outside ..."
  * ^definition = "Drugs: I shall not at any time use or be found in possession of drugs, within or outside the premises, during the treatment period."
* #cardinalRules.sex "Sex: no sexual act of any kind is acceptable during the treatment period."
* #cardinalRules.violence "Violence: no verbal, physical or emotional abuse, including threats to staff or fellow ..."
  * ^definition = "Violence: no verbal, physical or emotional abuse, including threats to staff or fellow clients, is allowed."
* #cardinalRules.property "Destruction of property: I shall respect the property of clients, staff, the centre and ..."
  * ^definition = "Destruction of property: I shall respect the property of clients, staff, the centre and the neighbourhood; destroying it will be penalised."
* #cardinalRules.theft "Theft: no theft of property belonging to fellow clients, staff, the centre or neighbours ..."
  * ^definition = "Theft: no theft of property belonging to fellow clients, staff, the centre or neighbours will be tolerated."
* #groundNorms.permission "I shall never leave the compound without permission from staff."
* #groundNorms.stealing "I shall not steal or abuse."
* #groundNorms.hygiene "I shall maintain the required standards of hygiene."
* #groundNorms.abstinence "I shall abstain from all mood-altering substances."
* #groundNorms.programme "I shall adhere to the daily programme and all required activities, and shall not abscond ..."
  * ^definition = "I shall adhere to the daily programme and all required activities, and shall not abscond from the programme or any of its activities."
* #groundNorms.conduct "I shall be responsible and uphold the set virtues and the moral and spiritual standards."
* #groundNorms.prohibitedItems "I shall not be found in possession of illegal items, for example knives, phones or drugs."

// ── Client rights and responsibilities clauses ──
* #rights.informed "To be informed of your rights verbally and in writing, and to extend those same rights to ..."
  * ^definition = "To be informed of your rights verbally and in writing, and to extend those same rights to fellow clients in treatment and to the management and staff of the centre."
* #rights.confidentiality "To have the confidentiality of your treatment and treatment records protected. ..."
  * ^definition = "To have the confidentiality of your treatment and treatment records protected. Information about your treatment will not be disclosed to any person or agency without your written permission, except where the law requires disclosure."
* #rights.limitsOfConfidentiality "To know the limits of confidentiality and the situations in which the clinician or the ..."
  * ^definition = "To know the limits of confidentiality and the situations in which the clinician or the centre is legally required to disclose information."
* #rights.informedConsent "To give informed consent, acknowledging your permission for the centre to provide ..."
  * ^definition = "To give informed consent, acknowledging your permission for the centre to provide treatment."
* #rights.promptTreatment "To receive prompt and adequate treatment, and to refuse treatment you do not want."
* #rights.medication "To be free from unnecessary or excessive medication, and to receive clear information ..."
  * ^definition = "To be free from unnecessary or excessive medication, and to receive clear information about any recommended medication, its possible benefits, side effects and alternatives."
* #rights.safeEnvironment "To be provided a safe environment, free from physical, sexual and emotional abuse."
* #rights.treatmentPlan "To receive complete and accurate information about your treatment plan, its goals ..."
  * ^definition = "To receive complete and accurate information about your treatment plan, its goals, methods, potential risks, benefits and progress."
* #rights.fees "To receive information about fees, payment methods, co-payment, and the length and ..."
  * ^definition = "To receive information about fees, payment methods, co-payment, and the length and duration of sessions and treatment."
* #rights.qualifiedProviders "To receive services from providers who are qualified and competent."
* #rights.clinicianCapabilities "To receive information about the professional capabilities and limitations of any ..."
  * ^definition = "To receive information about the professional capabilities and limitations of any clinician involved in your treatment."
* #rights.recording "To be free from audio or video recording without informed consent."
* #rights.recordAccess "To have access to information in your treatment records, with the approval of the ..."
  * ^definition = "To have access to information in your treatment records, with the approval of the clinical coordinator, during treatment."
* #rights.recordsForwarded "To have information forwarded to a new clinician following your treatment at this ..."
  * ^definition = "To have information forwarded to a new clinician following your treatment at this facility."
* #rights.grievance "To file a grievance if your rights have been denied or limited, verbally or in writing to ..."
  * ^definition = "To file a grievance if your rights have been denied or limited, verbally or in writing to the clinical coordinator, and to receive information about the grievance procedure in writing."
* #responsibilities.participate "To follow and fully participate in the outlined treatment programme of the centre."
* #responsibilities.fullInformation "To provide full information about yourself, to enable a proper assessment."
* #responsibilities.askQuestions "To ask questions and understand your condition."
* #responsibilities.respect "To show respect to the staff and other clients in the centre."
* #responsibilities.goalPlanning "To participate in planning your goals for treatment."
* #responsibilities.cooperate "To cooperate in treatment planning."
* #responsibilities.rules "To fully abide by the centre's rules and regulations as stipulated."

// ── Confidentiality exception clauses ──
* #exceptions.imminentHarm "It is necessary to protect you or someone else from imminent physical harm."
* #exceptions.courtOrder "The centre receives a valid court order or subpoena that mandates release of your ..."
  * ^definition = "The centre receives a valid court order or subpoena that mandates release of your information."
* #exceptions.abuseReporting "The centre is reporting abuse of children, the elderly, or persons with disabilities."
* #exceptions.internalConsultation "Clinicians within the agency consult with each other about your treatment in order to ..."
  * ^definition = "Clinicians within the agency consult with each other about your treatment in order to provide the best possible care."
* #acknowledgement.agreed "I acknowledge that I have read, understood and agreed with the above information."

// ── Guardian treatment consent clauses ──
* #acknowledgements.consent "I voluntarily consent that the client will take part in a mental health evaluation and/or ..."
  * ^definition = "I voluntarily consent that the client will take part in a mental health evaluation and/or treatment — psychological or psychiatric — to help them overcome substance use disorder and other mental health problems."
* #acknowledgements.conductedBy "I understand the evaluation or treatment will be conducted by a psychologist, addiction ..."
  * ^definition = "I understand the evaluation or treatment will be conducted by a psychologist, addiction professional, psychiatrist or psychiatric nurse practitioner, or by someone supervised by one of them, and within the boundaries of the relevant Kenyan law."
* #acknowledgements.duration "Duration and charges: the minimum duration of treatment is ninety (90) days, and I have ..."
  * ^definition = "Duration and charges: the minimum duration of treatment is ninety (90) days, and I have been informed of the charges for those ninety days."
* #acknowledgements.absconding "Absconding: I have been informed of the possibility and consequences of the client ..."
  * ^definition = "Absconding: I have been informed of the possibility and consequences of the client absconding from the centre or any other location during treatment. The centre shall not be held responsible for the consequences, and I shall not claim compensation or damages in any form."
* #acknowledgements.dischargeAgainstAdvice "Discharge against the centre's advice: I have been informed of the possibility and ..."
  * ^definition = "Discharge against the centre's advice: I have been informed of the possibility and consequences, and understand such a discharge may adversely affect the client's progress and recovery."
* #acknowledgements.relapse "Relapse: I acknowledge that relapse is possible after treatment if the necessary ..."
  * ^definition = "Relapse: I acknowledge that relapse is possible after treatment if the necessary aftercare support is not adequately provided by family and significant others, and that the centre shall not be held responsible for it."
* #acknowledgements.compensation "Compensation: I agree that I shall not be compensated for any accidental or incidental ..."
  * ^definition = "Compensation: I agree that I shall not be compensated for any accidental or incidental occurrence affecting the client during the treatment period, whether inside or outside the centre."

// ── Chemical use history questions ──
* #history.firstDrink "How old were you when you had your first drink? Describe what happened and how you felt."
* #history.drugsUsed "List all of the drugs you have ever used, and the age at which you first used each one."
* #history.habits "What are your drug-using habits? Where do you use? With whom? Under what circumstances?"
* #history.heavyPeriod "Was there ever a period in your life when you used too much or too often? Explain."
* #history.problemsCaused "Has using chemicals ever caused a problem for you? Describe the problem or problems."
* #history.moreThanIntended "When you were using, did you find that you used more, or for longer, than you had ..."
  * ^definition = "When you were using, did you find that you used more, or for longer, than you had originally intended? Give some examples."
* #history.tolerance "Do you have to use more of the chemical now to get the same effect? How much more than ..."
  * ^definition = "Do you have to use more of the chemical now to get the same effect? How much more than when you first started?"
* #history.cuttingDown "Did you ever try to cut down, and what happened to your attempt?"
* #history.cuttingDownHow "What did you do to cut down? Did you change your beverage, limit the amount, or restrict ..."
  * ^definition = "What did you do to cut down? Did you change your beverage, limit the amount, or restrict your use to a certain time of day?"
* #history.stoppedCompletely "Did you ever stop using completely? What happened? Why did you start again?"
* #history.timeIntoxicated "Did you spend a lot of time intoxicated or hung over?"
* #history.dangerousUse "Did you ever use while doing something dangerous, such as driving a car? Give some ..."
  * ^definition = "Did you ever use while doing something dangerous, such as driving a car? Give some examples."
* #history.missedWork "Were you ever so high, or so hung over, that you missed work or school? Give some ..."
  * ^definition = "Were you ever so high, or so hung over, that you missed work or school? Give some examples."
* #history.missedFamilyEvents "Did you ever miss family events because you were high or hung over? Give a few examples."
* #history.familyProblems "Did you ever cause family problems? Give examples."
* #history.annoyedWhenChallenged "Did you ever feel annoyed when someone talked to you about your drinking or drug use? Who ..."
  * ^definition = "Did you ever feel annoyed when someone talked to you about your drinking or drug use? Who was it, and what did they say?"
* #history.guilt "Did you ever feel bad or guilty about your use? Give examples."
* #history.psychologicalProblems "Did using ever cause you psychological problems, such as being depressed? Explain the ..."
  * ^definition = "Did using ever cause you psychological problems, such as being depressed? Explain the problem, with examples."
* #history.physicalProblems "Did using ever cause physical problems, or make a physical problem worse? Give a few ..."
  * ^definition = "Did using ever cause physical problems, or make a physical problem worse? Give a few examples."
* #history.blackouts "Did you ever have a blackout? How old were you when you had your first one? Give some ..."
  * ^definition = "Did you ever have a blackout? How old were you when you had your first one? Give some examples."
* #history.sickFromUse "Did you ever get sick because you were too intoxicated? Give some examples."
* #history.badHangovers "Did you ever have a really bad hangover? Describe how you felt."
* #history.withdrawal "Did you ever get the shakes or suffer withdrawal symptoms when you quit using? Describe ..."
  * ^definition = "Did you ever get the shakes or suffer withdrawal symptoms when you quit using? Describe what happened when you stopped."
* #history.useToAvoidWithdrawal "Did you ever use to avoid withdrawal symptoms? Give examples of when you used a substance ..."
  * ^definition = "Did you ever use to avoid withdrawal symptoms? Give examples of when you used a substance to control them."
* #history.previousHelp "Have you ever sought help for your drug problem? When? Who did you see? Did the treatment ..."
  * ^definition = "Have you ever sought help for your drug problem? When? Who did you see? Did the treatment help, and how?"
* #history.reasonsToContinue "Why do you want to continue to use? Give five reasons."
* #history.reasonsToStop "Why do you want to stop using? Give ten reasons."
* #history.reputation "Has alcohol or drug use ever affected your reputation? Describe what happened and how you ..."
  * ^definition = "Has alcohol or drug use ever affected your reputation? Describe what happened and how you felt, and how you feel about yourself now."
* #history.financialImpact "How has using affected you financially? Give a few examples of money wasted in your ..."
  * ^definition = "How has using affected you financially? Give a few examples of money wasted in your addiction."
* #history.selfImage "Has your addiction changed how you feel about yourself? Give some examples."
* #history.ambition "Has your ambition decreased since you started using? Give some examples."
* #history.selfConfidence "Are you as self-confident as you were before?"
* #history.whyTreatmentNow "Describe the reasons why you want treatment now."

