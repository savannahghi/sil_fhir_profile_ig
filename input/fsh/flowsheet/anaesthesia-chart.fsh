Instance: anaesthesia-chart-baseline-sbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(baseline-sbp, Baseline systolic BP)
* code = $sghi-concept#anaes-baseline-sbp "Baseline systolic BP"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"

Instance: anaesthesia-chart-baseline-dbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(baseline-dbp, Baseline diastolic BP)
* code = $sghi-concept#anaes-baseline-dbp "Baseline diastolic BP"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"

Instance: anaesthesia-chart-pulse
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(pulse, Heart rate)
* code = $loinc#8867-4 "Heart rate"
* permittedDataType = #Quantity
* permittedUnit = $ucum#/min "/min"
* extension[FlowsheetAlert].valueString = "<50, ≥120"
* extension[FlowsheetPlot].valueRange.low = 40 '/min'
* extension[FlowsheetPlot].valueRange.high = 200 '/min'
* insert AbsoluteRange(20, 250, /min)

Instance: anaesthesia-chart-sbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(sbp, Systolic BP)
* code = $loinc#8480-6 "Systolic blood pressure"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "<90, ≥160; 20% from baseline"
* extension[FlowsheetPlot].valueRange.low = 40 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 200 'mm[Hg]'
* insert AbsoluteRange(40, 300, mm[Hg])

Instance: anaesthesia-chart-dbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(dbp, Diastolic BP)
* code = $loinc#8462-4 "Diastolic blood pressure"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "≥100"
* extension[FlowsheetPlot].valueRange.low = 40 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 200 'mm[Hg]'
* insert AbsoluteRange(20, 200, mm[Hg])

Instance: anaesthesia-chart-map
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(map, Mean arterial pressure)
* code = $loinc#8478-0 "Mean blood pressure"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "<65"
* extension[FlowsheetPlot].valueRange.low = 40 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 200 'mm[Hg]'
* insert AbsoluteRange(20, 250, mm[Hg])

Instance: anaesthesia-chart-spo2
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(spo2, SpO2)
* code = $loinc#59408-5 "Oxygen saturation in Arterial blood by Pulse oximetry"
* permittedDataType = #Quantity
* permittedUnit = $ucum#% "%"
* extension[FlowsheetAlert].valueString = "<94"
* extension[FlowsheetPlot].valueRange.low = 85 '%'
* extension[FlowsheetPlot].valueRange.high = 100 '%'
* insert AbsoluteRange(50, 100, %)

Instance: anaesthesia-chart-rr
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(rr, Respiratory rate)
* code = $loinc#9279-1 "Respiratory rate"
* permittedDataType = #Quantity
* permittedUnit = $ucum#/min "/min"
* extension[FlowsheetAlert].valueString = "<10, ≥25"
* extension[FlowsheetPlot].valueRange.low = 5 '/min'
* extension[FlowsheetPlot].valueRange.high = 40 '/min'
* insert AbsoluteRange(0, 80, /min)

Instance: anaesthesia-chart-temperature
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(temperature, Temperature)
* code = $loinc#8310-5 "Body temperature"
* permittedDataType = #Quantity
* permittedUnit = $ucum#Cel "°C"
* extension[FlowsheetDecimals].valueInteger = 1
* extension[FlowsheetAlert].valueString = "<36.0"
* extension[FlowsheetPlot].valueRange.low = 34 'Cel'
* extension[FlowsheetPlot].valueRange.high = 40 'Cel'
* insert AbsoluteRange(30, 43, Cel)

Instance: anaesthesia-chart-etco2
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(etco2, End-tidal CO2)
* code = $loinc#19889-5 "Carbon dioxide [Partial pressure] in Exhaled gas --at end expiration"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "<30, ≥50"
* extension[FlowsheetPlot].valueRange.low = 20 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 60 'mm[Hg]'
* insert AbsoluteRange(0, 100, mm[Hg])

Instance: anaesthesia-chart-oxygen
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(oxygen, Oxygen given)
* code = $loinc#3151-8 "Inhaled oxygen flow rate"
* permittedDataType = #Quantity
* permittedUnit = $ucum#L/min "L/min"
