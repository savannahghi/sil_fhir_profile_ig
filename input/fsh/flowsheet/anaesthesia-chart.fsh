// Generated by fhir-templates build_anaesthesia_chart.py; edit the row list there.
// The revised anaesthetic record: core rows always, a section per technique
// (general, regional, sedation) that the procedure page hides when the case
// is under another, and the events and case facts above the grid.

Instance: anaesthesia-chart
InstanceOf: ObservationDefinition
Usage: #definition
Title: "Anaesthesia chart"
Description: "The flowsheet template for the intra-operative anaesthesia record."
* status = #active
* name = "anaesthesia-chart"
* title = "Anaesthesia chart"
* version = "2.0.0"
* code = SGHIDocumentTypeCodeSystem#anaesthesia-chart "Anaesthesia chart"
* useContext[+].code = $usage-context-type#workflow
* useContext[=].valueCodeableConcept = SGHIFlowsheetContextCodeSystem#theatre
* extension[FlowsheetGrouping].valueCode = #5min
* extension[FlowsheetScope].valueCode = #encounter
* extension[FlowsheetDefaultWindow].valueQuantity = 12 'h'
* extension[FlowsheetMaxWindow].valueQuantity = 3 'd'
* extension[FlowsheetAliases].valueCanonical = Canonical(flowsheet-observation-aliases)
* extension[FlowsheetEntryQuestionnaire].valueCanonical = "https://fhir.slade360.co.ke/fhir/Questionnaire/97f82613-658a-5166-add6-565d7ae331e3"
* extension[FlowsheetCaseQuestionnaire].valueCanonical = "https://fhir.slade360.co.ke/fhir/Questionnaire/82c423cf-ebf3-5f1f-aeba-4a5fa3604f94"
* hasMember[+] = Reference(anaesthesia-chart-case)
* hasMember[+] = Reference(anaesthesia-chart-core)
* hasMember[+] = Reference(anaesthesia-chart-general)
* hasMember[+] = Reference(anaesthesia-chart-regional)
* hasMember[+] = Reference(anaesthesia-chart-sedation)
* hasMember[+] = Reference(anaesthesia-chart-fluids)
* hasMember[+] = Reference(anaesthesia-chart-recovery)

Instance: anaesthesia-chart-case
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetSection(case, The case)
* code = SGHIDocumentTypeCodeSystem#anaesthesia-chart "Anaesthesia chart"
* extension[FlowsheetHeader].valueBoolean = true
* hasMember[+] = Reference(anaesthesia-chart-anaesthesia-start)
