// Generated by fhir-templates build_dialysis_chart.py; edit the row list there.
// One haemodialysis session: the session facts above the grid, then vital signs,
// the machine, and heparin and saline with the complications, one column per observation.

Instance: haemodialysis-chart
InstanceOf: ObservationDefinition
Usage: #definition
Title: "Haemodialysis chart"
Description: "The flowsheet template for a haemodialysis session."
* status = #active
* name = "haemodialysis-chart"
* title = "Haemodialysis chart"
* version = "2.0.0"
* code = SGHIDocumentTypeCodeSystem#haemodialysis-chart "Haemodialysis chart"
* useContext[+].code = $usage-context-type#workflow
* useContext[=].valueCodeableConcept = SGHIFlowsheetContextCodeSystem#dialysis
* extension[FlowsheetGrouping].valueCode = #raw
* extension[FlowsheetScope].valueCode = #encounter
* extension[FlowsheetDefaultWindow].valueQuantity = 12 'h'
* extension[FlowsheetMaxWindow].valueQuantity = 3 'd'
* extension[FlowsheetAliases].valueCanonical = Canonical(flowsheet-observation-aliases)
* extension[FlowsheetEntryQuestionnaire].valueCanonical = "https://fhir.slade360.co.ke/fhir/Questionnaire/6c91e0f0-f180-5615-8976-6bbefe6adbb1"
* extension[FlowsheetCaseQuestionnaire].valueCanonical = "https://fhir.slade360.co.ke/fhir/Questionnaire/ad5cc739-3272-51fe-abba-8467fb9d1fbd"
* hasMember[+] = Reference(haemodialysis-chart-session)
* hasMember[+] = Reference(haemodialysis-chart-vitals)
* hasMember[+] = Reference(haemodialysis-chart-circuit)
* hasMember[+] = Reference(haemodialysis-chart-fluids)

Instance: haemodialysis-chart-session
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetSection(session, The session)
* code = SGHIDocumentTypeCodeSystem#haemodialysis-chart "Haemodialysis chart"
* extension[FlowsheetHeader].valueBoolean = true
* hasMember[+] = Reference(haemodialysis-chart-mode)
* hasMember[+] = Reference(haemodialysis-chart-access-type)
* hasMember[+] = Reference(haemodialysis-chart-dry-weight)
* hasMember[+] = Reference(haemodialysis-chart-pre-weight)
* hasMember[+] = Reference(haemodialysis-chart-weight-gain)
* hasMember[+] = Reference(haemodialysis-chart-uf-goal)
* hasMember[+] = Reference(haemodialysis-chart-pre-sbp)
* hasMember[+] = Reference(haemodialysis-chart-dialysis-start)
* hasMember[+] = Reference(haemodialysis-chart-dialysis-end)
* hasMember[+] = Reference(haemodialysis-chart-post-weight)
* hasMember[+] = Reference(haemodialysis-chart-uf-achieved)
* hasMember[+] = Reference(haemodialysis-chart-ktv)

Instance: haemodialysis-chart-vitals
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetSection(vitals, Vital signs)
* code = SGHIDocumentTypeCodeSystem#haemodialysis-chart "Haemodialysis chart"
* hasMember[+] = Reference(haemodialysis-chart-sbp)
* hasMember[+] = Reference(haemodialysis-chart-dbp)
* hasMember[+] = Reference(haemodialysis-chart-pulse)
* hasMember[+] = Reference(haemodialysis-chart-temperature)
* hasMember[+] = Reference(haemodialysis-chart-spo2)

Instance: haemodialysis-chart-circuit
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetSection(circuit, Machine)
* code = SGHIDocumentTypeCodeSystem#haemodialysis-chart "Haemodialysis chart"
* hasMember[+] = Reference(haemodialysis-chart-qb)
* hasMember[+] = Reference(haemodialysis-chart-ap)
* hasMember[+] = Reference(haemodialysis-chart-vp)
* hasMember[+] = Reference(haemodialysis-chart-tmp)
* hasMember[+] = Reference(haemodialysis-chart-uf-rate)
* hasMember[+] = Reference(haemodialysis-chart-uf-removed)

Instance: haemodialysis-chart-fluids
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetSection(fluids, Heparin and saline)
* code = SGHIDocumentTypeCodeSystem#haemodialysis-chart "Haemodialysis chart"
* hasMember[+] = Reference(haemodialysis-chart-heparin)
* hasMember[+] = Reference(haemodialysis-chart-saline)
* hasMember[+] = Reference(haemodialysis-chart-complication)

Instance: haemodialysis-chart-mode
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(mode, Mode)
* code = $sghi-concept#dial-mode "Mode"
* permittedDataType = #CodeableConcept

Instance: haemodialysis-chart-access-type
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(access-type, Access)
* code = $loinc#72050-8 "Dialysis access"
* permittedDataType = #CodeableConcept

Instance: haemodialysis-chart-dry-weight
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(dry-weight, Dry weight)
* code = $sghi-concept#dial-dry-weight "Dry weight"
* permittedDataType = #Quantity
* permittedUnit = $ucum#kg "kg"
* extension[FlowsheetDecimals].valueInteger = 1

Instance: haemodialysis-chart-pre-weight
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(pre-weight, Pre weight)
* code = $loinc#8347-7 "Body weight pre dialysis"
* permittedDataType = #Quantity
* permittedUnit = $ucum#kg "kg"
* extension[FlowsheetDecimals].valueInteger = 1

Instance: haemodialysis-chart-weight-gain
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(weight-gain, Weight gained since the last session)
* code = $sghi-concept#dial-interdialytic-weight-gain "Weight gained since the last session"
* permittedDataType = #Quantity
* permittedUnit = $ucum#kg "kg"
* extension[FlowsheetDecimals].valueInteger = 1

Instance: haemodialysis-chart-uf-goal
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(uf-goal, UF goal)
* code = $loinc#99738-7 "Hemodialysis fluid removal goal Vol"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL "mL"

Instance: haemodialysis-chart-pre-sbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(pre-sbp, Pre systolic BP)
* code = $sghi-concept#dial-pre-sbp "Systolic BP"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"

Instance: haemodialysis-chart-dialysis-start
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(dialysis-start, Dialysis start)
* code = $sghi-concept#dial-event-dialysis-start "Dialysis start"
* permittedDataType = #boolean

Instance: haemodialysis-chart-dialysis-end
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(dialysis-end, Dialysis end)
* code = $sghi-concept#dial-event-dialysis-end "Dialysis end"
* permittedDataType = #boolean

Instance: haemodialysis-chart-post-weight
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(post-weight, Post weight)
* code = $loinc#8344-4 "Body weight post dialysis"
* permittedDataType = #Quantity
* permittedUnit = $ucum#kg "kg"
* extension[FlowsheetDecimals].valueInteger = 1

Instance: haemodialysis-chart-uf-achieved
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(uf-achieved, UF achieved)
* code = $loinc#99739-5 "Hemodialysis fluid removed Vol"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL "mL"

Instance: haemodialysis-chart-ktv
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(ktv, Kt/V)
* code = $loinc#70965-9 "Kt/V.hemodialysis"
* permittedDataType = #Quantity
* extension[FlowsheetDecimals].valueInteger = 2

Instance: haemodialysis-chart-sbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(sbp, Systolic BP)
* code = $loinc#8480-6 "Systolic blood pressure"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "<100 or a fall of 30 from pre; <90, ≥180 critical"
* extension[FlowsheetPlot].valueRange.low = 40 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 200 'mm[Hg]'
* insert AbsoluteRange(40, 300, mm[Hg])

Instance: haemodialysis-chart-dbp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(dbp, Diastolic BP)
* code = $loinc#8462-4 "Diastolic blood pressure"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "≥100"
* extension[FlowsheetPlot].valueRange.low = 40 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 200 'mm[Hg]'
* insert AbsoluteRange(20, 200, mm[Hg])

Instance: haemodialysis-chart-pulse
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(pulse, Pulse)
* code = $loinc#8867-4 "Heart rate"
* permittedDataType = #Quantity
* permittedUnit = $ucum#/min "/min"
* extension[FlowsheetAlert].valueString = "<50, >100"
* extension[FlowsheetPlot].valueRange.low = 40 '/min'
* extension[FlowsheetPlot].valueRange.high = 200 '/min'
* insert AbsoluteRange(20, 250, /min)

Instance: haemodialysis-chart-temperature
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(temperature, Temperature)
* code = $loinc#8310-5 "Body temperature"
* permittedDataType = #Quantity
* permittedUnit = $ucum#Cel "°C"
* extension[FlowsheetDecimals].valueInteger = 1
* extension[FlowsheetAlert].valueString = "≥38.0"
* insert AbsoluteRange(30, 43, Cel)

Instance: haemodialysis-chart-spo2
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(spo2, SpO2)
* code = $loinc#59408-5 "Oxygen saturation in Arterial blood by Pulse oximetry"
* permittedDataType = #Quantity
* permittedUnit = $ucum#% "%"
* extension[FlowsheetAlert].valueString = "<92"
* insert AbsoluteRange(50, 100, %)

Instance: haemodialysis-chart-qb
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(qb, Blood flow (QB\))
* code = $loinc#99711-4 "Blood flow rate RRT circuit"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL/min "mL/min"

Instance: haemodialysis-chart-ap
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(ap, Arterial pressure (AP\))
* code = $loinc#99717-1 "Access pressure RRT circuit"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "Below −200"
* extension[FlowsheetPlot].valueRange.low = -300 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 300 'mm[Hg]'

Instance: haemodialysis-chart-vp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(vp, Venous pressure (VP\))
* code = $loinc#99721-3 "Return pressure RRT circuit"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "Above 200"
* extension[FlowsheetPlot].valueRange.low = -300 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 300 'mm[Hg]'

Instance: haemodialysis-chart-tmp
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(tmp, Transmembrane pressure (TMP\))
* code = $loinc#99720-5 "Transmembrane pressure RRT circuit"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mm[Hg] "mmHg"
* extension[FlowsheetAlert].valueString = "Above 250"
* extension[FlowsheetPlot].valueRange.low = -300 'mm[Hg]'
* extension[FlowsheetPlot].valueRange.high = 300 'mm[Hg]'

Instance: haemodialysis-chart-uf-rate
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(uf-rate, UF rate)
* code = $sghi-concept#dial-uf-rate "UF rate"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL/h "mL/h"
* extension[FlowsheetAlert].valueString = "Above 13 mL/kg/h of dry weight"

Instance: haemodialysis-chart-uf-removed
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(uf-removed, UF removed so far)
* code = $loinc#99741-1 "Ultrafiltrate volume removed"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL "mL"
* extension[FlowsheetPlot].valueRange.low = 0 'mL'
* extension[FlowsheetPlot].valueRange.high = 4000 'mL'

Instance: haemodialysis-chart-heparin
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(heparin, Heparin given)
* code = $sghi-concept#dial-heparin-given "Heparin given"
* permittedDataType = #Quantity
* permittedUnit = $ucum#[iU] "IU"
* extension[FlowsheetAggregate].valueCode = #sum

Instance: haemodialysis-chart-saline
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(saline, Saline given)
* code = $sghi-concept#dial-saline-given "Saline given"
* permittedDataType = #Quantity
* permittedUnit = $ucum#mL "mL"
* extension[FlowsheetAggregate].valueCode = #sum

Instance: haemodialysis-chart-complication
InstanceOf: ObservationDefinition
Usage: #definition
* insert FlowsheetRow(complication, Complication)
* code = $sghi-concept#dial-complication "Complication"
* permittedDataType = #string
