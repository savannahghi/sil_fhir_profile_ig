group PsychiatricDomain(source qr : QR, source grp, target bundle : Bundle) {
  grp -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    grp -> obs.code as code then {
      grp -> code.coding as coding then {
        grp -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        grp -> coding.code = 'psychiatric' "codeCode";
        grp -> coding.display = 'Psychiatric status' "codeDisplay";
      } "codeCoding";
      grp -> code.text = 'Psychiatric status' "codeText";
    } "code";

    grp.item as itm where (linkId = 'psychiatric.P21') then {
      itm.answer as ans then {
        ans.value as v -> obs.value =
            evaluate(v, $this.code.substring($this.code.indexOf('-') + 1).toInteger()) "severityValue";
