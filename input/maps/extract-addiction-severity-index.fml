/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractAddictionSeverityIndex"
/// name = "ExtractAddictionSeverityIndex"
/// title = "Addiction Severity Index Extraction"
/// status = "active"
/// description = "The comprehensive assessment (Addiction Severity Index) as one survey Observation per answered domain, each carrying that domain\'s interviewer severity rating as its value and its answers as components. Two domains have no single rating: general information has none at all, and alcohol/drug has two (D30 for alcohol, D31 for drugs), so for those the Observation carries no top-level value and every rating stays a component. The suicidality items (P9 serious thoughts, P10 attempt, P20 observed at interview) each raise their own Observation when answered yes, so they are findable without unpacking a domain score. Answer codes are prefixed with their question (M8-4 rates 4), so a rating is always the part after the hyphen."
//
// GATE: item.where(linkId = 'general' or linkId = 'medical' or linkId = 'employment' or linkId = 'drugs' or linkId = 'legal' or linkId = 'family' or linkId = 'psychiatric').item.answer.exists() or item.where(linkId = 'drugs').item.item.answer.exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractAddictionSeverityIndex(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // One Observation per domain, and only for domains with at least one answer:
  // a section nobody reached is not an assessment of it. The drugs domain nests
  // its substance grid one level down, hence the second exists() arm.
  qr.item as grp where (linkId = 'general' and (item.answer.exists() or item.item.answer.exists())) then
      GeneralDomain(qr, grp, bundle) "generalDomain";
  qr.item as grp where (linkId = 'medical' and (item.answer.exists() or item.item.answer.exists())) then
      MedicalDomain(qr, grp, bundle) "medicalDomain";
  qr.item as grp where (linkId = 'employment' and (item.answer.exists() or item.item.answer.exists())) then
      EmploymentDomain(qr, grp, bundle) "employmentDomain";
  qr.item as grp where (linkId = 'drugs' and (item.answer.exists() or item.item.answer.exists())) then
      DrugsDomain(qr, grp, bundle) "drugsDomain";
  qr.item as grp where (linkId = 'legal' and (item.answer.exists() or item.item.answer.exists())) then
      LegalDomain(qr, grp, bundle) "legalDomain";
  qr.item as grp where (linkId = 'family' and (item.answer.exists() or item.item.answer.exists())) then
      FamilyDomain(qr, grp, bundle) "familyDomain";
  qr.item as grp where (linkId = 'psychiatric' and (item.answer.exists() or item.item.answer.exists())) then
      PsychiatricDomain(qr, grp, bundle) "psychiatricDomain";

  qr.item as grp where (linkId = 'psychiatric') then {
    grp.item as itm where (linkId = 'psychiatric.P9') then
        SuicidalThoughtsReportedFlag(qr, itm, bundle) "suicidalThoughtsReportedCall";
    grp.item as itm where (linkId = 'psychiatric.P10') then
        SuicideAttemptReportedFlag(qr, itm, bundle) "suicideAttemptReportedCall";
    grp.item as itm where (linkId = 'psychiatric.P20') then
        SuicidalThoughtsObservedFlag(qr, itm, bundle) "suicidalThoughtsObservedCall";
  } "riskFlags";
}

group GeneralDomain(source qr : QR, source grp, target bundle : Bundle) {
  grp -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    grp -> obs.code as code then {
      grp -> code.coding as coding then {
        grp -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        grp -> coding.code = 'general-information' "codeCode";
        grp -> coding.display = 'General information' "codeDisplay";
      } "codeCoding";
      grp -> code.text = 'General information' "codeText";
    } "code";

    grp.item as itm then Component(itm, obs) "components";
  } "observationEntry";
}

group MedicalDomain(source qr : QR, source grp, target bundle : Bundle) {
  grp -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    grp -> obs.code as code then {
      grp -> code.coding as coding then {
        grp -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        grp -> coding.code = 'medical' "codeCode";
        grp -> coding.display = 'Medical status' "codeDisplay";
      } "codeCoding";
      grp -> code.text = 'Medical status' "codeText";
    } "code";

    // Answer codes are prefixed with their question ("M8-4"), so the rating is
    // the part after the hyphen -- code.toInteger() on the whole string yields
    // nothing.
    grp.item as itm where (linkId = 'medical.M8') then {
      itm.answer as ans then {
        ans.value as v -> obs.value =
            evaluate(v, $this.code.substring($this.code.indexOf('-') + 1).toInteger()) "severityValue";
      } "severityAnswer";
    } "severityItem";

    grp.item as itm where (linkId != 'medical.M8') then Component(itm, obs) "components";
  } "observationEntry";
}

group EmploymentDomain(source qr : QR, source grp, target bundle : Bundle) {
  grp -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    grp -> obs.code as code then {
      grp -> code.coding as coding then {
        grp -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        grp -> coding.code = 'employment' "codeCode";
        grp -> coding.display = 'Employment and support status' "codeDisplay";
      } "codeCoding";
      grp -> code.text = 'Employment and support status' "codeText";
    } "code";

    grp.item as itm where (linkId = 'employment.E14') then {
      itm.answer as ans then {
        ans.value as v -> obs.value =
            evaluate(v, $this.code.substring($this.code.indexOf('-') + 1).toInteger()) "severityValue";
      } "severityAnswer";
    } "severityItem";

    grp.item as itm where (linkId != 'employment.E14') then Component(itm, obs) "components";
  } "observationEntry";
}

group DrugsDomain(source qr : QR, source grp, target bundle : Bundle) {
  grp -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    grp -> obs.code as code then {
      grp -> code.coding as coding then {
        grp -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        grp -> coding.code = 'alcohol-drug' "codeCode";
        grp -> coding.display = 'Alcohol and drug use' "codeDisplay";
      } "codeCoding";
      grp -> code.text = 'Alcohol and drug use' "codeText";
    } "code";

    // This domain has two ratings (D30 alcohol, D31 drugs), so there is no
    // single top-level value and both stay components.
    grp.item as itm then Component(itm, obs) "components";
  } "observationEntry";
}

