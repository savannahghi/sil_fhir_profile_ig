// One answered item -> one component, labelled with the item's own linkId and
// text. Recurses into nested groups, which is how the twelve-substance grid
// lands without naming each row here.
group Component(source itm, target obs : Observation) {
  itm.answer as ans then {
    ans.value as v -> obs.component as component then {
      itm.linkId as lid -> component.code as code then {
        lid -> code.coding as coding then {
          lid -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "componentSystem";
          lid -> coding.code = lid "componentCode";
        } "componentCoding";
        itm.text as t -> code.text = t "componentText";
      } "code";

      // component.value[x] is a choice, so each answer type needs its own
      // target: a Coding has to be wrapped in a CodeableConcept, and a date
      // cast to a dateTime.
      ans.value as iv where ($this is integer) -> component.value = iv "valueInteger";
      ans.value as sv where ($this is string) -> component.value = sv "valueString";
      ans.value as tv where ($this is time) -> component.value = tv "valueTime";
      ans.value as dv where ($this is date) -> component.value = cast(dv, 'dateTime') "valueDateTime";
      ans.value as cv where ($this is Coding) -> component.value = create('CodeableConcept') as concept,
          concept.coding = cv "valueCodeableConcept";
    } "component";
  } "answered";

  itm.item as child then Component(child, obs) "nestedItems";
}

group SuicidalThoughtsReportedFlag(source qr : QR, source itm, target bundle : Bundle) {
  itm.answer as ans where (value.code.endsWith('-1')) then {
    ans.value as v -> bundle.entry as entry, entry.resource = create('Observation') as flag then {
      qr -> flag then SetResponseProvenance(qr, flag) "responseProvenance";
      qr -> flag, entry then BuildObsBase(qr, flag, entry) "base";
      qr -> flag then SetSurveyCategory(qr, flag) "category";

      v -> flag.code as code then {
        v -> code.coding as coding then {
          v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "flagCodeSystem";
          v -> coding.code = 'suicidal-thoughts-reported' "flagCodeCode";
          v -> coding.display = 'Serious thoughts of suicide reported' "flagCodeDisplay";
        } "flagCodeCoding";
        v -> code.text = 'Serious thoughts of suicide reported' "flagCodeText";
      } "flagCode";

      v -> flag.value = true "flagValue";
      itm.text as t -> flag.note as note, note.text = t "flagNote";
    } "flagEntry";
  } "answeredYes";
}

group SuicideAttemptReportedFlag(source qr : QR, source itm, target bundle : Bundle) {
  itm.answer as ans where (value.code.endsWith('-1')) then {
    ans.value as v -> bundle.entry as entry, entry.resource = create('Observation') as flag then {
      qr -> flag then SetResponseProvenance(qr, flag) "responseProvenance";
      qr -> flag, entry then BuildObsBase(qr, flag, entry) "base";
      qr -> flag then SetSurveyCategory(qr, flag) "category";

      v -> flag.code as code then {
        v -> code.coding as coding then {
          v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "flagCodeSystem";
          v -> coding.code = 'suicide-attempt-reported' "flagCodeCode";
          v -> coding.display = 'Suicide attempt reported' "flagCodeDisplay";
        } "flagCodeCoding";
        v -> code.text = 'Suicide attempt reported' "flagCodeText";
      } "flagCode";

      v -> flag.value = true "flagValue";
      itm.text as t -> flag.note as note, note.text = t "flagNote";
    } "flagEntry";
  } "answeredYes";
}

group SuicidalThoughtsObservedFlag(source qr : QR, source itm, target bundle : Bundle) {
  itm.answer as ans where (value.code.endsWith('-1')) then {
    ans.value as v -> bundle.entry as entry, entry.resource = create('Observation') as flag then {
      qr -> flag then SetResponseProvenance(qr, flag) "responseProvenance";
      qr -> flag, entry then BuildObsBase(qr, flag, entry) "base";
      qr -> flag then SetSurveyCategory(qr, flag) "category";

      v -> flag.code as code then {
        v -> code.coding as coding then {
          v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "flagCodeSystem";
          v -> coding.code = 'suicidal-thoughts-observed' "flagCodeCode";
          v -> coding.display = 'Suicidal thoughts observed at interview' "flagCodeDisplay";
        } "flagCodeCoding";
