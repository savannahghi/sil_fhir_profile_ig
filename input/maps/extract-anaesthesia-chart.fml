            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 30, 'L', iif(answer.value.ofType(Quantity).value >= 50, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 30, 'Low', iif(answer.value.ofType(Quantity).value >= 50, 'High', 'Normal'))) "dsp";
