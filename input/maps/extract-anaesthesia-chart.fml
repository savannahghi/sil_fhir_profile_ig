/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractAnaesthesiaChart"
/// name = "ExtractAnaesthesiaChart"
/// title = "Anaesthesia Chart Extraction"
/// status = "active"
/// description = "One Observation per answer of the anaesthesia chart's two forms, coded like the anaesthesia-chart row it is charted on. A reading comes out at its own time, with the core vital signs interpreted against the chart's alerts; a named event comes out as true at the time it happened; the recovery score at the time it was scored. Generated by fhir-templates build_anaesthesia_chart.py."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractAnaesthesiaChart(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── A reading, charted at its own time ───────────────────────────────
  qr.item as row where (linkId = 'reading') then {
    row.item as sec where (linkId = 'reading/core') then {
      sec.item as it where (linkId = 'reading/pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 50, 'L', iif(answer.value.ofType(Quantity).value >= 120, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 50, 'Low', iif(answer.value.ofType(Quantity).value >= 120, 'High', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_pulse";
      sec.item as it where (linkId = 'reading/sbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8480-6' "cd";
            it -> cg.display = 'Systolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'L', iif(answer.value.ofType(Quantity).value >= 160, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'Low', iif(answer.value.ofType(Quantity).value >= 160, 'High', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_sbp";
      sec.item as it where (linkId = 'reading/dbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8462-4' "cd";
            it -> cg.display = 'Diastolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 100, 'H', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 100, 'High', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_dbp";
      sec.item as it where (linkId = 'reading/map' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8478-0' "cd";
            it -> cg.display = 'Mean blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 65, 'L', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 65, 'Low', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_map";
      sec.item as it where (linkId = 'reading/spo2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '59408-5' "cd";
            it -> cg.display = 'Oxygen saturation in Arterial blood by Pulse oximetry' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 94, 'L', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 94, 'Low', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_spo2";
      sec.item as it where (linkId = 'reading/rr' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '9279-1' "cd";
            it -> cg.display = 'Respiratory rate' "dsp";
