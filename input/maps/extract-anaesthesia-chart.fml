        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 40, 'HH', iif(answer.value.ofType(Quantity).value >= 35, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 40, 'Critically high', iif(answer.value.ofType(Quantity).value >= 35, 'High', 'Normal'))) "dsp";
