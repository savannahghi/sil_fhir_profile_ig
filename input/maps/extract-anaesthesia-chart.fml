/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractAnaesthesiaChart"
/// name = "ExtractAnaesthesiaChart"
/// title = "Anaesthesia Chart Extraction"
/// status = "active"
/// description = "One Observation per answer of the anaesthesia chart's two forms, coded like the anaesthesia-chart row it is charted on. A reading comes out at its own time, with the core vital signs interpreted against the chart's alerts and critical alerts; a named event comes out as true at the time it happened; a drug or a complication as one line of text; the transfer and the recovery score at their own times. Generated by fhir-templates build_anaesthesia_chart.py."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractAnaesthesiaChart(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── A reading, charted at its own time ───────────────────────────────
  qr.item as row where (linkId = 'reading') then {
    row.item as sec where (linkId = 'reading/core') then {
      sec.item as it where (linkId = 'reading/pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 40, 'LL', iif(answer.value.ofType(Quantity).value >= 140, 'HH', iif(answer.value.ofType(Quantity).value < 50, 'L', iif(answer.value.ofType(Quantity).value >= 120, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 40, 'Critically low', iif(answer.value.ofType(Quantity).value >= 140, 'Critically high', iif(answer.value.ofType(Quantity).value < 50, 'Low', iif(answer.value.ofType(Quantity).value >= 120, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_pulse";
      sec.item as it where (linkId = 'reading/sbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8480-6' "cd";
            it -> cg.display = 'Systolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 80, 'LL', iif(answer.value.ofType(Quantity).value >= 180, 'HH', iif(answer.value.ofType(Quantity).value < 90, 'L', iif(answer.value.ofType(Quantity).value >= 160, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 80, 'Critically low', iif(answer.value.ofType(Quantity).value >= 180, 'Critically high', iif(answer.value.ofType(Quantity).value < 90, 'Low', iif(answer.value.ofType(Quantity).value >= 160, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_sbp";
      sec.item as it where (linkId = 'reading/dbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8462-4' "cd";
            it -> cg.display = 'Diastolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 110, 'HH', iif(answer.value.ofType(Quantity).value >= 100, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 110, 'Critically high', iif(answer.value.ofType(Quantity).value >= 100, 'High', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_dbp";
      sec.item as it where (linkId = 'reading/map' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8478-0' "cd";
            it -> cg.display = 'Mean blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 55, 'LL', iif(answer.value.ofType(Quantity).value < 65, 'L', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 55, 'Critically low', iif(answer.value.ofType(Quantity).value < 65, 'Low', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_map";
      sec.item as it where (linkId = 'reading/spo2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '59408-5' "cd";
            it -> cg.display = 'Oxygen saturation in Arterial blood by Pulse oximetry' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'LL', iif(answer.value.ofType(Quantity).value < 94, 'L', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'Critically low', iif(answer.value.ofType(Quantity).value < 94, 'Low', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_spo2";
      sec.item as it where (linkId = 'reading/rr' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '9279-1' "cd";
            it -> cg.display = 'Respiratory rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 8, 'LL', iif(answer.value.ofType(Quantity).value >= 30, 'HH', iif(answer.value.ofType(Quantity).value < 10, 'L', iif(answer.value.ofType(Quantity).value >= 25, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 8, 'Critically low', iif(answer.value.ofType(Quantity).value >= 30, 'Critically high', iif(answer.value.ofType(Quantity).value < 10, 'Low', iif(answer.value.ofType(Quantity).value >= 25, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_rr";
      sec.item as it where (linkId = 'reading/temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8310-5' "cd";
            it -> cg.display = 'Body temperature' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 35, 'LL', iif(answer.value.ofType(Quantity).value < 36, 'L', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 35, 'Critically low', iif(answer.value.ofType(Quantity).value < 36, 'Low', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_temperature";
      sec.item as it where (linkId = 'reading/etco2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '19889-5' "cd";
            it -> cg.display = 'Carbon dioxide [Partial pressure] in Exhaled gas --at end expiration' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 25, 'LL', iif(answer.value.ofType(Quantity).value >= 60, 'HH', iif(answer.value.ofType(Quantity).value < 30, 'L', iif(answer.value.ofType(Quantity).value >= 50, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 25, 'Critically low', iif(answer.value.ofType(Quantity).value >= 60, 'Critically high', iif(answer.value.ofType(Quantity).value < 30, 'Low', iif(answer.value.ofType(Quantity).value >= 50, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_etco2";
      sec.item as it where (linkId = 'reading/oxygen' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '3151-8' "cd";
            it -> cg.display = 'Inhaled oxygen flow rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_oxygen";
      sec.item as it where (linkId = 'reading/fio2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '3150-0' "cd";
            it -> cg.display = 'Inhaled oxygen concentration' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_fio2";
      sec.item as it where (linkId = 'reading/rhythm' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-rhythm' "cd";
            it -> cg.display = 'Cardiac rhythm' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as cv -> obs.value = create('CodeableConcept') as cc then {
            cv -> cc.coding = cv "valueCoding";
            cv.display as d -> cc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_rhythm";
      sec.item as it where (linkId = 'reading/cvp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-cvp' "cd";
            it -> cg.display = 'Central venous pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_cvp";
    } "reading_core";
    row.item as sec where (linkId = 'reading/general') then {
      sec.item as it where (linkId = 'reading/inspired-agent' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-inspired-agent' "cd";
            it -> cg.display = 'Inspired agent' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_inspired_agent";
      sec.item as it where (linkId = 'reading/tidal-volume' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-tidal-volume' "cd";
            it -> cg.display = 'Tidal volume' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_tidal_volume";
      sec.item as it where (linkId = 'reading/ventilation-rate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-ventilation-rate' "cd";
            it -> cg.display = 'Ventilation rate' "dsp";
