    qr where ((iif(repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) > 3 and (iif(repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 26) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'assist-brief-intervention' "cd";
        qr -> cg.display = 'Brief intervention' "dsp";
      } "coding";
      qr -> itp.text = 'Brief intervention' "text";
    } "assist_brief_intervention";
    qr where ((iif(repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/other/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/other').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) > 26) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'assist-brief-intervention-with-treatment' "cd";
        qr -> cg.display = 'Brief intervention with options that include treatment' "dsp";
      } "coding";
      qr -> itp.text = 'Brief intervention (offer options that include treatment)' "text";
    } "assist_brief_intervention_with_treatment";
    qr.item as it where (linkId = 'q2/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '95439-6' "cd";
          it -> cg.display = 'During the past 3 months, how often have you used other substances [NIDA]' "dsp";
        } "coding";
      } "code";
      it -> comp then AssistFrequencyAnswer(it, comp) "value";
    } "q2";
    qr.item as g where (linkId = 'q3') then {
      g.item as it where (linkId = 'q3/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '95449-5' "cd";
            it -> cg.display = 'During the past 3 months, how often have you had a strong desire or urge to use other substances [NIDA]' "dsp";
          } "coding";
        } "code";
        it -> comp then AssistFrequencyAnswer(it, comp) "value";
      } "q3";
    } "q3Group";
    qr.item as g where (linkId = 'q4') then {
      g.item as it where (linkId = 'q4/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '95459-4' "cd";
            it -> cg.display = 'During the past 3 months, how often has your use of other substances led to health, social, legal or financial problems [NIDA]' "dsp";
          } "coding";
        } "code";
        it -> comp then AssistFrequencyAnswer(it, comp) "value";
      } "q4";
    } "q4Group";
    qr.item as g where (linkId = 'q5') then {
      g.item as it where (linkId = 'q5/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '95469-3' "cd";
            it -> cg.display = 'During the past 3 months, how often have you failed to do what was normally expected of you because of your use of other substances [NIDA]' "dsp";
          } "coding";
        } "code";
        it -> comp then AssistFrequencyAnswer(it, comp) "value";
      } "q5";
    } "q5Group";
    qr.item as g where (linkId = 'q6') then {
      g.item as it where (linkId = 'q6/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '95479-2' "cd";
            it -> cg.display = 'Has a friend or relative or anyone else ever expressed concern about your use of other substances [NIDA]' "dsp";
          } "coding";
        } "code";
        it -> comp then AssistEverAnswer(it, comp) "value";
      } "q6";
    } "q6Group";
    qr.item as g where (linkId = 'q7') then {
      g.item as it where (linkId = 'q7/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '95491-7' "cd";
            it -> cg.display = 'Have you ever tried and failed to control, cut down or stop using other substances [NIDA]' "dsp";
          } "coding";
        } "code";
        it -> comp then AssistEverAnswer(it, comp) "value";
      } "q7";
    } "q7Group";
  } "other";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr -> obs.status = 'final' "status";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";
  // The hasValue() guard stops an unsaved response, posted straight to $extract,
  // from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source r : Observation, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// Questions 2 to 5: how often, as LOINC's answer code.
group AssistFrequencyAnswer(source it, target comp) {
  it.answer first as a then {
    a.value as cv where (code.contains('-never-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA6270-8' "cd";
        cv -> cg.display = 'Never' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Never' "text";
    } "answer_never";
    a.value as cv where (code.contains('-once-or-twice-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA26460-8' "cd";
        cv -> cg.display = 'Once or twice' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Once or twice' "text";
    } "answer_once_or_twice";
    a.value as cv where (code.contains('-monthly-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA18876-5' "cd";
        cv -> cg.display = 'Monthly' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Monthly' "text";
    } "answer_monthly";
    a.value as cv where (code.contains('-weekly-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA18891-4' "cd";
        cv -> cg.display = 'Weekly' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Weekly' "text";
    } "answer_weekly";
    a.value as cv where (code.contains('-daily-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA18934-2' "cd";
        cv -> cg.display = 'Daily or almost daily' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Daily or almost daily' "text";
    } "answer_daily";
  } "answer";
}

// Questions 6 and 7: never, in the past 3 months or before, as LOINC's answer code.
group AssistEverAnswer(source it, target comp) {
  it.answer first as a then {
    a.value as cv where (code.contains('-never-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA18386-5' "cd";
        cv -> cg.display = 'No, never' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'No, never' "text";
    } "answer_never";
    a.value as cv where (code.contains('-past-3-months-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA31151-6' "cd";
        cv -> cg.display = 'Yes, in the past 3 months' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Yes, in the past 3 months' "text";
    } "answer_past_3_months";
    a.value as cv where (code.contains('-before-3-months-')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA31150-8' "cd";
        cv -> cg.display = 'Yes, but not in the past 3 months' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Yes, but not in the past 3 months' "text";
    } "answer_before_3_months";
  } "answer";
}

// A coded answer kept as the coding the client sent, its display as the text.
group CopyCoding(source it, target t) {
  it.answer first as a then {
    a.value as cv -> t.value = create('CodeableConcept') as vc then {
      cv -> vc.coding = cv "valueCoding";
      cv.display as d -> vc.text = d "valueText";
    } "codedValue";
  } "answer";
}

// A string answer, as written.
group SetText(source it, target t) {
  it.answer first as a then {
    a.value as v -> t.value = v "value";
  } "answer";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'assist-screening' "provenanceCode";
      qr -> t.display = 'ASSIST screening tool' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}
