/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractAssistScreening"
/// name = "ExtractAssistScreening"
/// title = "ASSIST Screening Extraction"
/// status = "active"
/// description = "The ASSIST screening tool out as one summary Observation under LOINC 95513-8, the NIDA-Modified ASSIST, carrying lifetime use of each substance, drug injection with the two extra injection questions and the response they indicate, and the highest indicated response as its interpretation; and one Observation per substance ever used under LOINC's substance involvement score for it, valued with the total for questions 2 to 7 (the form's, or the answers summed here, questions 3 to 5 only when the substance was used in the past three months), interpreted with the response the score sheet indicates, and carrying each question as a component under LOINC's per-substance code."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractAssistScreening(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Summary: lifetime use, injection, and the highest indicated response ────
  qr where (item.where(linkId.startsWith('q1/')).answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";
    qr -> obs.code as cc then {
      qr -> cc.coding as cg then {
        qr -> cg.system = 'http://loinc.org' "sys";
        qr -> cg.code = '95513-8' "cd";
        qr -> cg.display = 'NIDA-Modified ASSIST version 2.0 [NIDA]' "dsp";
      } "coding";
      qr -> cc.text = 'ASSIST screening tool' "text";
    } "code";
    qr.item as it where (linkId = 'q1/cannabis' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-cannabis' "cd";
          it -> cg.display = 'Lifetime use of cannabis' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_cannabis";
    qr.item as it where (linkId = 'q1/cocaine' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-cocaine' "cd";
          it -> cg.display = 'Lifetime use of cocaine' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_cocaine";
    qr.item as it where (linkId = 'q1/prescription-stimulants' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-prescription-stimulants' "cd";
          it -> cg.display = 'Lifetime use of prescription stimulants' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_prescription_stimulants";
    qr.item as it where (linkId = 'q1/methamphetamine' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-methamphetamine' "cd";
          it -> cg.display = 'Lifetime use of methamphetamine' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_methamphetamine";
    qr.item as it where (linkId = 'q1/inhalants' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-inhalants' "cd";
          it -> cg.display = 'Lifetime use of inhalants' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_inhalants";
    qr.item as it where (linkId = 'q1/sedatives' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-sedatives' "cd";
          it -> cg.display = 'Lifetime use of sedatives' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_sedatives";
    qr.item as it where (linkId = 'q1/hallucinogens' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-hallucinogens' "cd";
          it -> cg.display = 'Lifetime use of hallucinogens' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_hallucinogens";
    qr.item as it where (linkId = 'q1/street-opioids' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-street-opioids' "cd";
          it -> cg.display = 'Lifetime use of street opioids' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_street_opioids";
    qr.item as it where (linkId = 'q1/prescription-opioids' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-prescription-opioids' "cd";
          it -> cg.display = 'Lifetime use of prescription opioids' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_prescription_opioids";
    qr.item as it where (linkId = 'q1/other' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-lifetime-use-other' "cd";
          it -> cg.display = 'Lifetime use of other drugs' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q1_other";
    qr.item as it where (linkId = 'q1/other-specify' and answer.value.ofType(string).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'assist-other-substance' "cd";
          it -> cg.display = 'Other substance used to get high' "dsp";
        } "coding";
      } "code";
      it -> comp then SetText(it, comp) "value";
    } "otherSpecified";
    qr.item as it where (linkId = 'q8' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '95492-5' "cd";
          it -> cg.display = 'Injection drug use Lifetime' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "q8";
    qr.item as g where (linkId = 'injection') then {
      g.item as it where (linkId = 'injection/frequency' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'assist-injection-frequency' "cd";
            it -> cg.display = 'How often drugs were injected in the past three months' "dsp";
          } "coding";
        } "code";
        it -> comp then CopyCoding(it, comp) "value";
      } "frequency";
      g.item as it where (linkId = 'injection/three-days' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'assist-injection-three-days-in-a-row' "cd";
            it -> cg.display = 'Injected drugs three or more days in a row in the past three months' "dsp";
          } "coding";
        } "code";
        it -> comp then CopyCoding(it, comp) "value";
      } "threeDays";
    } "injection";
    qr where (item.where(linkId = 'q8').answer.value.ofType(Coding).where(code = 'LA31151-6').exists() and item.where(linkId = 'injection').item.where(linkId = 'injection/frequency').answer.value.ofType(Coding).code.exists() and item.where(linkId = 'injection').item.where(linkId = 'injection/three-days').answer.value.ofType(Coding).code.exists() and (item.where(linkId = 'injection').item.where(linkId = 'injection/frequency').answer.value.ofType(Coding).code = 'assist-injection-weekly-or-less' and item.where(linkId = 'injection').item.where(linkId = 'injection/three-days').answer.value.ofType(Coding).code = 'N')) -> obs.component as comp then {
      qr -> comp.code as cc then {
        qr -> cc.coding as cg then {
          qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          qr -> cg.code = 'assist-injection-indicated-response' "cd";
          qr -> cg.display = 'Indicated response for drug injection' "dsp";
        } "coding";
      } "code";
      qr -> comp.value = create('CodeableConcept') as vc then {
        qr -> vc.coding as cg then {
          qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          qr -> cg.code = 'assist-brief-intervention' "cd";
          qr -> cg.display = 'Brief intervention' "dsp";
        } "coding";
        qr -> vc.text = 'Brief intervention' "text";
      } "value";
    } "injectionBrief";
    qr where (item.where(linkId = 'q8').answer.value.ofType(Coding).where(code = 'LA31151-6').exists() and item.where(linkId = 'injection').item.where(linkId = 'injection/frequency').answer.value.ofType(Coding).code.exists() and item.where(linkId = 'injection').item.where(linkId = 'injection/three-days').answer.value.ofType(Coding).code.exists() and (item.where(linkId = 'injection').item.where(linkId = 'injection/frequency').answer.value.ofType(Coding).code = 'assist-injection-weekly-or-less' and item.where(linkId = 'injection').item.where(linkId = 'injection/three-days').answer.value.ofType(Coding).code = 'N').not()) -> obs.component as comp then {
      qr -> comp.code as cc then {
        qr -> cc.coding as cg then {
          qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          qr -> cg.code = 'assist-injection-indicated-response' "cd";
          qr -> cg.display = 'Indicated response for drug injection' "dsp";
        } "coding";
      } "code";
      qr -> comp.value = create('CodeableConcept') as vc then {
        qr -> vc.coding as cg then {
          qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          qr -> cg.code = 'assist-brief-intervention-with-treatment' "cd";
          qr -> cg.display = 'Brief intervention with options that include treatment' "dsp";
        } "coding";
        qr -> vc.text = 'Brief intervention with options that include treatment' "text";
      } "value";
    } "injectionTreatment";
    qr where (iif(repeat(item).where(linkId = 'scores/highest-response').answer.value.ofType(string).exists(), repeat(item).where(linkId = 'scores/highest-response').answer.value.ofType(string) = 'Brief education', ((iif(item.where(linkId = 'q1/cannabis').answer.value.ofType(Coding).code = 'Y', iif((iif(repeat(item).where(linkId = 'scores/cannabis/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/cannabis/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 4, 0, iif((iif(repeat(item).where(linkId = 'scores/cannabis/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/cannabis/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/cannabis').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 26, 1, 2)), {}) | iif(item.where(linkId = 'q1/cocaine').answer.value.ofType(Coding).code = 'Y', iif((iif(repeat(item).where(linkId = 'scores/cocaine/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/cocaine/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 3, 0, iif((iif(repeat(item).where(linkId = 'scores/cocaine/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/cocaine/total').answer.value.ofType(integer).first(), repeat(item).where(linkId = 'q2/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + iif(repeat(item).where(linkId = 'q2/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) > 0, repeat(item).where(linkId = 'q3/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q4/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q5/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0), 0) + repeat(item).where(linkId = 'q6/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0) + repeat(item).where(linkId = 'q7/cocaine').answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 26, 1, 2)), {}) | iif(item.where(linkId = 'q1/prescription-stimulants').answer.value.ofType(Coding).code = 'Y', iif((iif(repeat(item).where(linkId = 'scores/prescription-stimulants/total').answer.value.ofType(integer).exists(), repeat(item).where(linkId = 'scores/prescription-stimulants/total').answer.value.o