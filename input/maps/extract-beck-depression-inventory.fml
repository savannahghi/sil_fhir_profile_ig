/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractBeckDepressionInventory"
/// name = "ExtractBeckDepressionInventory"
/// title = "Beck Depression Inventory Extraction"
/// status = "active"
/// description = "Beck\'s Depression Inventory as one scored survey Observation with a component per answered item, plus a standalone Observation whenever item 9 -- suicidal ideation -- scores above zero, so risk is findable without unpacking the components of a score. Answer codes carry their score after the hyphen (bdi.9-2 scores 2), the total is those scores summed with aggregate() because sum() is not available in every engine, and the same expression repeats in the severity band because FML has no way to bind an intermediate value to a variable."
//
// GATE: item.where(linkId = 'inventory').item.answer.exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractBeckDepressionInventory(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // Built only when at least one inventory item was answered: an inventory
  // nobody has started yet is not a score.
  qr where (item.where(linkId = 'inventory').item.answer.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";

    qr -> obs.code as code then {
      qr -> code.coding as coding then {
        qr -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "codeSystem";
        qr -> coding.code = 'bdi' "codeCode";
        qr -> coding.display = 'Beck\'s Depression Inventory' "codeDisplay";
      } "codeCoding";
      // The LOINC code beside the local one, so any system that knows LOINC can
      // find the score without our code system.
      qr -> code.coding as loinc then {
        qr -> loinc.system = 'http://loinc.org' "loincSystem";
        qr -> loinc.code = '89209-1' "loincCode";
        qr -> loinc.display = 'Beck Depression Inventory II total score [BDI]' "loincDisplay";
      } "loincCoding";
      qr -> code.text = 'Beck\'s Depression Inventory' "codeText";
    } "code";

    // Each answer's code carries its score after the hyphen, so the total is
    // those suffixes summed across every answered item.
    qr -> obs.value = evaluate(qr, $this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0)) "totalScore";

    qr -> obs.interpretation as interpretation,
        interpretation.text = evaluate(qr, iif($this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0) <= 10, 'These ups and downs are considered normal', iif($this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0) <= 16, 'Mild mood disturbance', iif($this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0) <= 20, 'Borderline clinical depression', iif($this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0) <= 30, 'Moderate depression', iif($this.repeat(item).answer.value.ofType(Coding).select(code.substring(code.indexOf('-') + 1).toInteger()).aggregate($this + $total, 0) <= 40, 'Severe depression', 'Extreme depression'))))))
        "severityBand";

    qr.item as grp where (linkId = 'inventory') then {
      grp.item as itm then Component(itm, obs) "componentPerItem";
    } "inventoryGroup";
  } "scoreEntry";

  // Item 9 is suicidal ideation. Any answer scoring above zero also produces
  // its own Observation, so it can be found without unpacking a score.
  qr.item as grp where (linkId = 'inventory') then {
    grp.item as itm where (linkId = 'bdi.9') then {
      itm.answer as ans where (value.code.substring(value.code.indexOf('-') + 1).toInteger() > 0) then {
        ans.value as v -> bundle.entry as entry, entry.resource = create('Observation') as risk then
            BuildRiskFlag(qr, v, risk, entry) "riskEntry";
      } "nonZero";
    } "item9";
  } "item9Group";
}

// One answered item -> one component: the chosen statement as the code, the
// item's wording as its text, and the score suffix as the value.
group Component(source itm, target obs : Observation) {
  itm.answer as ans then {
    ans.value as v -> obs.component as component then {
      v -> component.code as code then {
        v -> code.coding = v "componentCoding";
        itm.text as t -> code.text = t "componentText";
      } "code";
      v -> component.value = evaluate(v, $this.code.substring($this.code.indexOf('-') + 1).toInteger()) "componentValue";
    } "component";
  } "answered";
}

// Item 9 answered above zero -> a standalone Observation, so suicidal ideation
// is findable without reading the components of a score.
group BuildRiskFlag(source qr : QR, source v, target risk : Observation, target entry) {
  qr -> risk then SetResponseProvenance(qr, risk) "responseProvenance";
  qr -> risk, entry then BuildObsBase(qr, risk, entry) "base";
  qr -> risk then SetSurveyCategory(qr, risk) "category";

  v -> risk.code as code then {
    v -> code.coding as coding then {
      v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "riskCodeSystem";
      v -> coding.code = 'suicidal-ideation-reported' "riskCodeCode";
      v -> coding.display = 'Suicidal ideation reported' "riskCodeDisplay";
    } "riskCodeCoding";
    v -> code.text = 'Suicidal ideation reported' "riskCodeText";
  } "riskCode";

  v -> risk.value = evaluate(v, $this.code.substring($this.code.indexOf('-') + 1).toInteger()) "riskValue";

  v -> risk.interpretation as interpretation,
      interpretation.text = evaluate(v, $this.display) "riskInterpretation";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";
  qr.authored as t -> obs.effective = t "effective";

  qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))) -> obs.performer = src "performerFromSource";
  qr where (source.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))).exists().not()) then {
    qr.author as a where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))) -> obs.performer = a "performerFromAuthor";
  } "performerFallback";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is a
  // relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first --
  // from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Observation/',
    id
  ) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a record can always be traced to the form that made it. The
// second copies the tenant tags off the response, because nothing else on the
// path puts them there. The response's identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'beck-depression-inventory' "provenanceCode";
      qr -> t.display = 'Beck\'s depression inventory' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
