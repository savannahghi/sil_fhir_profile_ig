/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractCaseConference"
/// name = "ExtractCaseConference"
/// title = "Case Conference Extraction"
/// status = "active"
/// description = "The weekly case conference as the resources meant to hold each part of it: the stage of change as a survey Observation, each named problem as a Condition on the problem list, the current medication as a MedicationStatement, each stuck point\'s objective as a Goal whose note carries the intervention agreed for it, and the conference narrative itself -- progress, conjoint session, stuck points -- as a Composition. The Composition replaces the ClinicalImpression this map used to produce: ClinicalImpression sits at FMM 1 and nothing downstream implements it, while a progress-note Composition says the same thing in a shape other systems read. Week on week the Goals are what can be compared. The nurse on duty stays on the form response; a typed name is not a performer record."
//
// GATE: item.where(linkId = 'conference').item.where(linkId = 'conference.stage').answer.exists() or item.where(linkId = 'clinical').item.answer.exists() or item.where(linkId = 'progress').answer.value.exists() or item.where(linkId = 'stuckPoints').item.answer.value.exists() or item.where(linkId = 'conjoint').item.answer.value.exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/MedicationStatement" alias MedicationStatement as target
uses "http://hl7.org/fhir/StructureDefinition/Goal" alias Goal as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target

group ExtractCaseConference(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // The stage of change, as a survey Observation.
  qr.item as cg where (linkId = 'conference') then {
    cg.item as it where (linkId = 'conference.stage') then {
      it.answer as ans then {
        ans.value as v -> bundle.entry as entry, entry.resource = create('Observation') as obs then
            StageOfChange(qr, v, obs, entry) "stageEntry";
      } "stageAnswer";
    } "stageItem";
  } "conferenceGroup";

  // Each named problem a Condition, the medication a MedicationStatement.
  qr.item as grp where (linkId = 'clinical') then {
    grp.item as it where (linkId != 'clinical.currentMedication') then
        Problem(qr, it, bundle) "problemEntries";
    grp.item as it where (linkId = 'clinical.currentMedication') then
        Medication(qr, it, bundle) "medicationEntry";
  } "clinicalGroup";

  // Each stuck point's objective, as a Goal.
  qr.item as sp where (linkId = 'stuckPoints') then StuckPointGoal(qr, sp, bundle) "stuckPointGoals";

  // The conference narrative, as a progress-note Composition.
  qr where (item.where(linkId = 'progress').answer.value.exists() or item.where(linkId = 'stuckPoints').item.answer.value.exists() or item.where(linkId = 'conjoint').item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Composition') as comp then {
    qr -> comp, entry then BuildNoteBase(qr, comp, entry) "noteBase";
    qr -> comp.name = 'CaseConferenceNote' "noteName";
    qr -> comp.title = 'Case conference' "noteTitle";

    qr -> comp.type as ty then {
      qr -> ty.coding as mw then {
        qr -> mw.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "mwSystem";
        qr -> mw.code = 'case-conference' "mwCode";
        qr -> mw.display = 'Case conference note' "mwDisplay";
      } "mwCoding";
      qr -> ty.coding as loinc then {
        qr -> loinc.system = 'http://loinc.org' "loincSystem";
        qr -> loinc.code = '11506-3' "loincCode";
        qr -> loinc.display = 'Progress note' "loincDisplay";
      } "loincCoding";
      qr -> ty.text = 'Case conference note' "typeText";
    } "noteType";

    qr.item as it where (linkId = 'progress') then TextSection(it, comp) "progressSection";

    // The conjoint session is context for the conference rather than a resource
    // of its own, so it reads as a section.
    qr.item as cj where (linkId = 'conjoint') then {
      cj.item as it where (linkId = 'conjoint.withWhom' and answer.value.exists()) -> comp.section as sec then {
        it -> sec.title = 'Conjoint session' "conjointTitle";
        it -> sec then AddSectionText(it, sec) "conjointText";
      } "conjointRule";
    } "conjointGroup";

    // Each stuck-point row reads as its own sections: the stuck point, the
    // objective and the intervention, titled by the template's own item text.
    qr.item as sp2 where (linkId = 'stuckPoints') then {
      sp2.item as it then TextSection(it, comp) "stuckPointSections";
    } "stuckPointNarrative";

    // Composition.author is the response's author; when the response carries
    // none, the case manager's typed name stands in as a display.
    qr where (author.exists().not() and source.exists().not()) then {
      qr.item as sg where (linkId = 'signatures') then {
        sg.item as it where (linkId = 'signatures.caseManager' and answer.value.exists()) then {
          it.answer first as a then {
            a.value as v -> comp.author as author, author.display = v "authorFromCaseManager";
          } "caseManagerAnswer";
        } "caseManagerRule";
      } "signaturesGroup";
    } "authorFallbackFromForm";
  } "composition";
}

group StageOfChange(source qr : QR, source v, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
  qr -> obs then SetSurveyCategory(qr, obs) "category";

  v -> obs.code as code then {
    v -> code.coding as coding then {
      v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "stageCodeSystem";
      v -> coding.code = 'stage-of-change' "stageCodeCode";
      v -> coding.display = 'Stage of change' "stageCodeDisplay";
    } "stageCodeCoding";
    v -> code.text = 'Treatment process -- stage of change' "stageCodeText";
  } "stageCode";

  // The answer coding is copied as it is; the options carry the mental
  // wellness codes themselves.
  v -> obs.value = create('CodeableConcept') as concept, concept.coding = v "stageValue";

  // Effective is the conference's own date; the response's authored stamp only
  // stands in when the form carries none.
  qr.item as cg where (linkId = 'conference') then {
    cg.item as it where (linkId = 'conference.date' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as d -> obs.effective = cast(d, 'dateTime') "stageEffective";
      } "dateAnswer";
    } "dateRule";
  } "conferenceDateGroup";
  qr where (item.where(linkId = 'conference').item.where(linkId = 'conference.date').answer.value.exists().not()) then {
    qr.authored as t -> obs.effective = t "effectiveFromAuthored";
  } "effectiveFallback";
}

// One named problem -> one Condition. The second category coding's code is the
// linkId's own suffix, so the template names the category rather than this map
// hard-coding four of them. The suffixes today: primaryAddiction,
// secondaryAddiction, medicalProblem, psychiatricCondition.
group Problem(source qr : QR, source itm, target bundle : Bundle) {
  itm.answer as ans then {
    ans.value as v -> bundle.entry as entry, entry.resource = create('Condition') as cond then {
      qr -> cond, entry then BuildConditionBase(qr, cond, entry) "base";

      v -> cond.category as category then {
        v -> category.coding as coding then {
          v -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "categorySystem";
          v -> coding.code = evaluate(itm, $this.linkId.substring($this.linkId.indexOf('.') + 1)) "categoryCode";
        } "categoryCoding";
        itm.text as t -> category.text = t "categoryText";
      } "problemCategory";

      v -> cond.code as code, code.text = v "conditionCode";
    } "conditionEntry";
  } "answered";
}

group Medication(source qr : QR, source itm, target bundle : Bundle) {
  itm.answer as ans then {
    ans.value as v -> bundle.entry as entry, entry.resource = create('MedicationStatement') as statement then {
      qr -> statement then SetResponseProvenance(qr, statement) "responseProvenance";
      v -> statement.id = uuid() then SetMedicationStatementFullUrl(statement, entry) "idAndFullUrl";

      v -> entry.request as request then {
        v -> request.method = 'POST' "requestMethod";
        v -> request.url = 'MedicationStatement' "requestUrl";
      } "entryRequest";

      v -> statement.status = 'recorded' "statementStatus";
      v -> statement.medication as medication, medication.concept = create('CodeableConcept') as concept,
          concept.text = v "statementMedication";
      qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> statement.subject = s "statementSubject";
      qr.authored as t -> statement.dateAsserted = t "statementDateAsserted";
      qr.id as qid where ($this.hasValue()) -> statement.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
    } "medicationEntry";
  } "answered";
}

// One row of the stuck-points table: the objective becomes a Goal whose note
// carries the intervention agreed for it.
group StuckPointGoal(source qr : QR, source grp, target bundle : Bundle) {
  grp.item as itm where (linkId = 'stuckPoint.objective') then {
    itm.answer as ans then {
      ans.value as v -> bundle.entry as entry, entry.resource = create('Goal') as goal then {
        qr -> goal then SetResponseProvenance(qr, goal) "responseProvenance";
        v -> goal.id = uuid() then SetGoalFullUrl(goal, entry) "idAndFullUrl";

        v -> entry.request as request then {
          v -> request.method = 'POST' "requestMethod";
          v -> request.url = 'Goal' "requestUrl";
        } "entryRequest";

        v -> goal.lifecycleStatus = 'active' "goalStatus";
        v -> goal.description = create('CodeableConcept') as concept, concept.text = v "goalDescription";
        qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> goal.subject = s "goalSubject";

        grp.item as other where (linkId = 'stuckPoint.intervention') then {
          other.answer as otherAns then {
            otherAns.value as intervention -> goal.note as note,
                note.text = evaluate(intervention, 'Intervention: ' + $this) "goalNote";
          } "interventionAnswer";
        } "interventionItem";
      } "goalEntry";
    } "objectiveAnswer";
  } "objectiveItem";
}

// One answered item -> a titled section whose code is the item's own linkId and
// whose narrative is the prose as written.
group TextSection(source it, target comp : Composition) {
  it.answer as ans then {
    ans.value as v -> comp.section as sec then {
      it.text as t -> sec.title = t "sectionTitle";
      it.linkId as lid -> sec.code as code then {
        lid -> code.coding as coding then {
          lid -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "headingSystem";
          lid -> coding.code = lid "headingCode";
        } "headingCoding";
        it.text as ht -> code.text = ht "headingText";
      } "sectionCode";
      v -> sec then AddSectionText(it, sec) "sectionNarrative";
    } "section";
  } "answered";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

// This file's BuildObsBase sets no effective: the stage Observation takes the
// conference's own date, with the authored stamp as its fallback, at the call
// site.
group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))) -> obs.performer = src "performerFromSource";
  qr where (source.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))).exists().not()) then {
    qr.author as a where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient'))))) -> obs.performer = a "performerFromAuthor";
  } "performerFallback";

  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Observation/',
    id
  ) "assignFullUrl";
}

group BuildConditionBase(source qr : QR, target cond : Condition, target entry) {
  qr -> cond then SetResponseProvenance(qr, cond) "responseProvenance";
  qr -> cond.id = uuid() then SetConditionFullUrl(cond, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Condition' "requestUrl";
  } "entryRequest";

  qr -> cond.clinicalStatus as cs then {
    qr -> cs.coding as csc then {
      qr -> csc.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "clinSystem";
      qr -> csc.code = 'active' "clinCode";
      qr -> csc.display = 'Active' "clinDisplay";
    } "clinCoding";
  } "clinicalStatus";

  qr -> cond.category as cat then {
    qr -> cat.coding as catc then {
      qr -> catc.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "catSystem";
      qr -> catc.code = 'encounter-diagnosis' "catCode";
      qr -> catc.display = 'Encounter Diagnosis' "catDisplay";
    } "catCoding";
  } "category";

  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> cond.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> cond.encounter = e "encounter";
  qr.authored as t -> cond.recordedDate = t "recordedDate";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part then {
    qr -> part.actor = a "participantActor";
  } "participantFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part2 then {
      qr -> part2.actor = src "participantActorFromSource";
    } "participantFromSource";
  } "participantFallback";

  qr -> cond.evidence as ev then {
    qr -> ev.reference = create('Reference') as ref then {
      qr.id as qid -> ref.reference = qid "evidenceRef";
    } "evidenceTarget";
  } "linkQuestionnaireResponse";
}

group SetConditionFullUrl(source cond : Condition, target entry) {
  cond.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Condition/',
    id
  ) "assignFullUrl";
}

group SetMedicationStatementFullUrl(source statement : MedicationStatement, target entry) {
  statement.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/MedicationStatement/',
    id
  ) "assignFullUrl";
}

group SetGoalFullUrl(source goal : Goal, target entry) {
  goal.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Goal/',
    id
  ) "assignFullUrl";
}

group BuildNoteBase(source qr : QR, target comp : Composition, target entry) {
  qr -> comp then SetResponseProvenance(qr, comp) "responseProvenance";
  qr -> comp.id = uuid() then SetCompositionFullUrl(comp, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Composition' "requestUrl";
  } "entryRequest";

  qr -> comp.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> comp.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> comp.encounter = e "encounter";

  qr.authored as t -> comp.date = t "date";
  qr where (authored.exists().not()) then {
    qr -> comp.date = evaluate(qr, now()) "dateFromExtractionTime";
  } "dateFallback";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = a "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = src "authorFromSource";
  } "authorFallback";

  qr -> comp.relatesTo as rel then {
    qr -> rel.type = 'derived-from' "relatesToType";
    qr -> rel.resourceReference = create('Reference') as ref then {
      qr.id as qid -> ref.reference = qid "relatesToRef";
    } "relatesToTarget";
  } "linkQuestionnaireResponse";
}

group AddSectionText(source it, target sec) {
  it.answer first as a then {
    a.value as v -> sec.text as narrative then {
      v -> narrative.status = 'generated' "narrativeStatus";
      v -> narrative.div = create('xhtml') as xhtml then {
        v -> xhtml.value = evaluate(a, '<div xmlns="http://www.w3.org/1999/xhtml"><p>' + value.toString().escape('html') + '</p></div>') "narrativeDiv";
      } "narrativeXhtml";
    } "sectionText";
  } "sectionAnswer";
}

group SetCompositionFullUrl(source comp : Composition, target entry) {
  comp.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Composition/',
    id
  ) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a record can always be traced to the form that made it. The
// second copies the tenant tags off the response, because nothing else on the
// path puts them there. The response's identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'case-conference' "provenanceCode";
      qr -> t.display = 'Weekly case conference record' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
