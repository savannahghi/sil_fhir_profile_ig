/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractChemotherapyProtocolCycles"
/// name = "ExtractChemotherapyProtocolCycles"
/// title = "Chemotherapy Protocol Cycle Extraction"
/// status = "active"
/// description = "One laboratory Observation per value per cycle, each taking the cycle\'s own date rather than the form\'s, because the whole reason this sheet exists is to be read as a series: a neutrophil count means one thing on its own and another as the third fall in a row. The absolute neutrophil count carries an interpretation, low below 1.0 and critically low below 0.5, because those are the thresholds that defer a cycle."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractChemotherapyProtocolCycles(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  qr.item as g where (linkId = 'protocol') then {
    g.item as it where (linkId = 'protocol/regimen' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'chemotherapy-regimen' "cd";
          it -> cg.display = 'Chemotherapy regimen' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as txt -> obs.note as n, n.text = txt "text";
      } "answer";
    } "narr_chemotherapy_regimen";

    // The protocol's own weight, the one the BSA for dosing is worked out
    // from, under a code of its own. Under 29463-7 it was indistinguishable
    // from the weight charted at each cycle, and as the protocol carries no date
    // of its own it took the authored time, so the recall's "weight, last
    // recorded" showed the protocol weight instead of the latest cycle's.
    g.item as it where (linkId = 'protocol/weight' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'chemotherapy-protocol-weight' "cd";
          it -> cg.display = 'Protocol weight' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "set";
      } "answer";
    } "measure_protocol_weight";

    g.item as it where (linkId = 'protocol/height' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8302-2' "cd";
          it -> cg.display = 'Body height' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "set";
      } "answer";
    } "measure_8302_2";

    g.item as it where (linkId = 'protocol/body-surface-area' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8277-6' "cd";
          it -> cg.display = 'Body surface area' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = create('Quantity') as q then {
          v -> q.value = v "qValue";
          v -> q.unit = 'm2' "qUnit";
          v -> q.system = 'http://unitsofmeasure.org' "qSystem";
          v -> q.code = 'm2' "qCode";
        } "quantity";
      } "answer";
    } "measureq_8277_6";

  } "protocolGroup";

  // ── One cycle at a time ─────────────────────────────────────────────────
  qr.item as c where (linkId = 'cycle') then {
    c.item as it where (linkId = 'cycle/haemoglobin' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '718-7' "cd";
          it -> cg.display = 'Hemoglobin [Mass/volume] in Blood' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cyclelab_haemoglobin";

    c.item as it where (linkId = 'cycle/platelets' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '777-3' "cd";
          it -> cg.display = 'Platelets [#/volume] in Blood by Automated count' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cyclelab_platelets";

    c.item as it where (linkId = 'cycle/creatinine' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '2160-0' "cd";
          it -> cg.display = 'Creatinine [Mass/volume] in Serum or Plasma' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cyclelab_creatinine";

    c.item as it where (linkId = 'cycle/urea' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '3094-0' "cd";
          it -> cg.display = 'Urea nitrogen [Mass/volume] in Serum or Plasma' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cyclelab_urea";

    // The neutrophil count, interpreted. Below 1.0 x10^9/L most protocols
    // defer the cycle and below 0.5 the patient is neutropenic and at risk
    // from an infection they cannot mount a response to. Leaving a reader to
    // notice the number is not good enough on the one value that stops
    // treatment.
    c.item as it where (linkId = 'cycle/anc' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '751-8' "cd";
          it -> cg.display = 'Neutrophils [#/volume] in Blood by Automated count' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      it -> obs.interpretation as interp then {
        it -> interp.coding as icg then {
          it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
          it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 0.5, 'LL', iif(answer.value.ofType(Quantity).value < 1.0, 'L', 'N'))) "cd";
          it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 0.5, 'Critical low', iif(answer.value.ofType(Quantity).value < 1.0, 'Low', 'Normal'))) "dsp";
        } "coding";
      } "interpretation";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cycleAnc";

    c.item as it where (linkId = 'cycle/pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8867-4' "cd";
          it -> cg.display = 'Heart rate' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cyclePulse";

    c.item as it where (linkId = 'cycle/weight' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '29463-7' "cd";
          it -> cg.display = 'Body weight' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cycleWeight";

    // Blood pressure travels as typed -- "128/76" on one line -- and is kept as
    // typed in the note, which is what the form's recall reads back. When, and
    // only when, the string is exactly two numbers of two or three digits either
    // side of one slash, it is also split into the systolic and diastolic
    // components the vital-signs blood pressure profile requires. Anything else
    // ("128/", "140 over 90", "high") gets the same two components with no
    // numbers in them: a mis-parsed blood pressure is worse than a legible string.
    c.item as it where (linkId = 'cycle/blood-pressure' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '85354-9' "cd";
          it -> cg.display = 'Blood pressure panel with all children optional' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as txt -> obs.note as n, n.text = txt "bpText";
        a.value as txt where ($this.replace(' ', '').matches('^[0-9]{2,3}/[0-9]{2,3}$')) then {
          txt -> obs.component as comp then {
            txt -> comp.code as cc then {
              txt -> cc.coding as cg then {
                txt -> cg.system = 'http://loinc.org' "sys";
                txt -> cg.code = '8480-6' "cd";
                txt -> cg.display = 'Systolic blood pressure' "dsp";
              } "coding";
            } "code";
            txt -> evaluate(txt, $this.replace(' ', '').split('/').first().toDecimal()) as mm, comp.value = create('Quantity') as q then {
              txt -> q.value = mm "qValue";
              txt -> q.unit = 'mmHg' "qUnit";
              txt -> q.system = 'http://unitsofmeasure.org' "qSystem";
              txt -> q.code = 'mm[Hg]' "qCode";
            } "quantity";
          } "systolic";
          txt -> obs.component as comp then {
            txt -> comp.code as cc then {
              txt -> cc.coding as cg then {
                txt -> cg.system = 'http://loinc.org' "sys";
                txt -> cg.code = '8462-4' "cd";
                txt -> cg.display = 'Diastolic blood pressure' "dsp";
              } "coding";
            } "code";
            txt -> evaluate(txt, $this.replace(' ', '').split('/').last().toDecimal()) as mm, comp.value = create('Quantity') as q then {
              txt -> q.value = mm "qValue";
              txt -> q.unit = 'mmHg' "qUnit";
              txt -> q.system = 'http://unitsofmeasure.org' "qSystem";
              txt -> q.code = 'mm[Hg]' "qCode";
            } "quantity";
          } "diastolic";
        } "bpComponents";
        // Anything else still carries both components, each with the reason its
        // value is missing -- as-text, the reading is in the note -- because the
        // vital-signs blood pressure profile requires them, and a number read
        // out of "140 over 90" would be a guess.
        a.value as txt where ($this.replace(' ', '').matches('^[0-9]{2,3}/[0-9]{2,3}$').not()) then {
          txt -> obs.component as comp then {
            txt -> comp.code as cc then {
              txt -> cc.coding as cg then {
                txt -> cg.system = 'http://loinc.org' "sys";
                txt -> cg.code = '8480-6' "cd";
                txt -> cg.display = 'Systolic blood pressure' "dsp";
              } "coding";
            } "code";
            txt -> comp.dataAbsentReason as dar then {
              txt -> dar.coding as dc then {
                txt -> dc.system = 'http://terminology.hl7.org/CodeSystem/data-absent-reason' "sys";
                txt -> dc.code = 'as-text' "cd";
                txt -> dc.display = 'As Text' "dsp";
              } "coding";
            } "absent";
          } "systolic";
          txt -> obs.component as comp then {
            txt -> comp.code as cc then {
              txt -> cc.coding as cg then {
                txt -> cg.system = 'http://loinc.org' "sys";
                txt -> cg.code = '8462-4' "cd";
                txt -> cg.display = 'Diastolic blood pressure' "dsp";
              } "coding";
            } "code";
            txt -> comp.dataAbsentReason as dar then {
              txt -> dar.coding as dc then {
                txt -> dc.system = 'http://terminology.hl7.org/CodeSystem/data-absent-reason' "sys";
                txt -> dc.code = 'as-text' "cd";
                txt -> dc.display = 'As Text' "dsp";
              } "coding";
            } "absent";
          } "diastolic";
        } "bpAsText";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "cycleBloodPressure";
    c.item as it where (linkId = 'cycle/remarks' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'chemo-remarks-on-a-chemotherapy-cycle' "cd";
          it -> cg.display = 'Remarks on a chemotherapy cycle' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as txt -> obs.note as n, n.text = txt "text";
      } "answer";
      c -> obs then SetCycleContext(c, obs) "cycleContext";
    } "narr_chemo_remarks_on_a_chemotherapy_cycle";

  } "cycleRows";
}

// The cycle's own date and number, on every Observation from that cycle. The
// date overrides the response's authored time: a sheet written up at the end of
// six cycles would otherwise collapse all six onto one instant and the series
// -- which is the entire point of the sheet -- would be gone.
group SetCycleContext(source c, target obs : Observation) {
  c.item as it where (linkId = 'cycle/date' and answer.value.exists()) then {
    it.answer first as a then {
      a.value as v where ($this.toString().length() = 10) -> evaluate(v, $this.toString() + 'T00:00:00+03:00') as midnight, obs.effective = cast(midnight, 'dateTime') "effectiveFromCycle";
    } "answer";
  } "cycleDateRule";
  c.item as it where (linkId = 'cycle/number' and answer.value.exists()) then {
    it.answer first as a then {
      a.value as n -> evaluate(n, 'Chemotherapy protocol cycle number: ' + $this.toString()) as label, obs.note as note, note.text = label "cycleNote";
    } "answer";
  } "cycleNumberRule";
  c.item as it where (linkId = 'cycle/signed-by' and answer.value.exists()) then {
    it.answer first as a where (value.reference.empty() or (%obs.performer.reference contains value.reference).not()) then {
      a.value as ref where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> obs.performer = ref "performer";
    } "answer";
  } "signedByRule";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group SetComponentValue(source it, target comp) {
  it.answer first as a then {
    a.value as v -> comp.value = v "plainValue";
  } "componentAnswer";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetLaboratoryCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'laboratory' "categoryCode";
      qr -> coding.display = 'Laboratory' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'chemotherapy-protocol-cycles' "provenanceCode";
      qr -> t.display = 'Chemotherapy protocol cycle record' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}
