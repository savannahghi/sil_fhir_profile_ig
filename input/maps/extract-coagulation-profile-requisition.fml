/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractCoagulationProfileRequisition"
/// name = "ExtractCoagulationProfileRequisition"
/// title = "Coagulation Profile Requisition Extraction"
/// status = "active"
/// description = "PT under LOINC 5964-2, INR under 6301-6 and APTT under 3173-2, each carrying the reference range printed on the form. The INR range is the reason this map needs a question answered: the printed 2.0 to 3.5 applies only to a patient on stabilised oral anticoagulant therapy, so it is attached only when the form says yes. Attaching it unconditionally would flag every patient not on warfarin as out of range, which is the opposite of useful."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/ServiceRequest" alias ServiceRequest as target

group ExtractCoagulationProfileRequisition(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  qr -> bundle.entry as entry, entry.resource = create('ServiceRequest') as sr then {
    qr -> sr, entry then BuildServiceRequestBase(qr, sr, entry) "base";
    qr -> sr.status = 'active' "status";
    qr -> sr.intent = 'order' "intent";
    qr.encounter as e -> sr.encounter = e "encounter";
    qr.authored as t -> sr.authoredOn = t "authoredOn";
    qr -> sr.category as cat then {
      qr -> cat.coding as cg then {
        qr -> cg.system = 'http://snomed.info/sct' "sys";
        qr -> cg.code = '108252007' "cd";
        qr -> cg.display = 'Laboratory procedure' "dsp";
      } "coding";
    } "category";
    // A local code. LOINC publishes every individual coagulation analyte but
    // nothing for the profile as ordered -- the panel codes that look right
    // (34530-4, 34530-6) are an ABO and Rh group panel -- and a guessed panel
    // code on a laboratory order is worse than a local one that says exactly
    // what the form asks for.
    qr -> sr.code as cr, cr.concept as cc then {
      qr -> cc.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'anticoagulation-coagulation-profile' "cd";
        qr -> cg.display = 'Coagulation profile' "dsp";
      } "coding";
    } "code";
    qr.item as g where (linkId = 'request') then {
      g.item as it where (linkId = 'request/requester' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as ref -> sr.requester = ref "requester";
        } "answer";
      } "requesterRule";
      g.item as it where (linkId = 'request/urgency' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as cv where (code = 'lab-urgency-desperate') -> sr.priority = 'stat' "stat";
        } "desperateRule";
        it.answer first as a then {
          a.value as cv where (code = 'lab-urgency-urgent') -> sr.priority = 'urgent' "urgent";
        } "urgentRule";
        it.answer first as a then {
          a.value as cv where (code = 'lab-urgency-routine') -> sr.priority = 'routine' "routine";
        } "routineRule";
      } "urgencyRule";
      g.item as it where (linkId = 'request/specimen' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as txt -> sr.specimen = create('Reference') as spref, spref.display = txt "specimen";
        } "answer";
      } "specimenRule";
    } "requestGroup";
    qr.item as it where (linkId = 'clinical-history' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as txt -> sr.note as n, n.text = txt "historyNote";
      } "answer";
    } "historyRule";
  } "coagulationRequest";

  qr.item as g where (linkId = 'results') then {

    // ── Prothrombin time ──────────────────────────────────────────────────
    g.item as it where (linkId = 'results/prothrombin-time' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '5964-2' "cd";
          it -> cg.display = 'Prothrombin time (PT) in Blood by Coagulation assay' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      it -> obs.referenceRange as rr then {
        it -> rr.low = create('Quantity') as lo then {
          it -> lo.value = '11' "loValue";
          it -> lo.unit = 'seconds' "loUnit";
          it -> lo.system = 'http://unitsofmeasure.org' "loSystem";
          it -> lo.code = 's' "loCode";
        } "low";
        it -> rr.high = create('Quantity') as hi then {
          it -> hi.value = '16' "hiValue";
          it -> hi.unit = 'seconds' "hiUnit";
          it -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
          it -> hi.code = 's' "hiCode";
        } "high";
        it -> rr.text = 'Reference range printed on the coagulation profile form' "rrText";
      } "referenceRange";
      qr -> obs then SetCoagulationContext(qr, obs) "context";
    } "prothrombinTime";

    // ── APTT ──────────────────────────────────────────────────────────────
    g.item as it where (linkId = 'results/aptt' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '3173-2' "cd";
          it -> cg.display = 'aPTT in Blood by Coagulation assay' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      it -> obs.referenceRange as rr then {
        it -> rr.low = create('Quantity') as lo then {
          it -> lo.value = '26.1' "loValue";
          it -> lo.unit = 'seconds' "loUnit";
          it -> lo.system = 'http://unitsofmeasure.org' "loSystem";
          it -> lo.code = 's' "loCode";
        } "low";
        it -> rr.high = create('Quantity') as hi then {
          it -> hi.value = '36.3' "hiValue";
          it -> hi.unit = 'seconds' "hiUnit";
          it -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
          it -> hi.code = 's' "hiCode";
        } "high";
        it -> rr.text = 'Reference range printed on the coagulation profile form' "rrText";
      } "referenceRange";
      qr -> obs then SetCoagulationContext(qr, obs) "context";
    } "aptt";

    // ── INR ───────────────────────────────────────────────────────────────
    // Observation.value[x] has no decimal choice, so the INR -- a bare ratio
    // with no unit -- has to be built as a Quantity with UCUM's unity code.
    g.item as it where (linkId = 'results/inr' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '6301-6' "cd";
          it -> cg.display = 'INR in Platelet poor plasma by Coagulation assay' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = create('Quantity') as q then {
          v -> q.value = v "qValue";
          v -> q.unit = 'ratio' "qUnit";
          v -> q.system = 'http://unitsofmeasure.org' "qSystem";
          v -> q.code = '1' "qCode";
        } "quantity";
      } "answer";

      // The printed 2.0-3.5 range attaches only where the patient is on
      // stabilised oral anticoagulants. For anyone else it is not a target and
      // attaching it would mark every unanticoagulated patient abnormal.
      qr.item as ac where (linkId = 'anticoagulation') then {
        ac.item as oa where (linkId = 'anticoagulation/on-oral-anticoagulant' and answer.value.ofType(Coding).code = 'Y') then {
          oa -> obs.referenceRange as rr then {
            oa -> rr.low = create('Quantity') as lo then {
              oa -> lo.value = '2.0' "loValue";
              oa -> lo.unit = 'ratio' "loUnit";
              oa -> lo.system = 'http://unitsofmeasure.org' "loSystem";
              oa -> lo.code = '1' "loCode";
            } "low";
            oa -> rr.high = create('Quantity') as hi then {
              oa -> hi.value = '3.5' "hiValue";
              oa -> hi.unit = 'ratio' "hiUnit";
              oa -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
              oa -> hi.code = '1' "hiCode";
            } "high";
            oa -> rr.text = 'Therapeutic range for a patient on stabilised oral anticoagulant therapy, as printed on the form' "rrText";
          } "referenceRange";
        } "onAnticoagulantRule";
      } "anticoagulationGroup";
      qr -> obs then SetCoagulationContext(qr, obs) "context";
    } "inr";
  } "resultsGroup";

  qr.item as it where (linkId = 'clinical-history' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";
    it -> obs.code as cc then {
      it -> cc.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '55752-0' "cd";
        it -> cg.display = 'Clinical information' "dsp";
      } "coding";
      it -> cc.text = 'Clinical history given to the coagulation laboratory' "codeText";
    } "code";
    it.answer first as a then {
      a.value as txt -> obs.note as n, n.text = txt "text";
    } "answer";
  } "narr_55752_0";


  qr.item as g where (linkId = 'anticoagulation') then {
    g.item as it where (linkId = 'anticoagulation/on-oral-anticoagulant' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'anticoagulation-on-stabilised-oral-anticoagulant-therapy' "cd";
          it -> cg.display = 'On stabilised oral anticoagulant therapy' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "coded_anticoagulation";

    g.item as it where (linkId = 'anticoagulation/agent' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'anticoagulation-anticoagulant-agent-and-dose' "cd";
          it -> cg.display = 'Anticoagulant agent and dose' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as txt -> obs.note as n, n.text = txt "text";
      } "answer";
    } "narr_anticoagulation_anticoagulant_agent_and_dose";

  } "anticoagulationObs";
}

group SetCoagulationContext(source qr : QR, target obs : Observation) {
  qr.item as g where (linkId = 'laboratory') then {
    g.item as it where (linkId = 'laboratory/collected-at' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as v -> obs.effective = v "effective";
      } "answer";
    } "collectedAtRule";
    g.item as it where (linkId = 'laboratory/tested-by' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as ref -> obs.performer = ref "testedBy";
      } "answer";
    } "testedByRule";
    g.item as it where (linkId = 'laboratory/dispatched-at' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as v -> obs.issued = cast(v, 'instant') "issued";
      } "answer";
    } "dispatchedRule";
    g.item as it where (linkId = 'laboratory/lab-registration-number' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as txt -> obs.identifier as ident then {
          txt -> ident.system = 'https://fhir.slade360.co.ke/fhir/identifier/lab-registration' "identSystem";
          txt -> ident.value = txt "identValue";
        } "identifier";
      } "answer";
    } "labRegRule";
  } "laboratoryGroup";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s -> obs.subject = s "subject";
  qr.encounter as e -> obs.encounter = e "encounter";
  qr.authored as t -> obs.effective = t "effective";

  qr.source as src -> obs.performer = src "performerFromSource";
  qr where (source.exists().not()) then {
    qr.author as a -> obs.performer = a "performerFromAuthor";
  } "performerFallback";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group SetComponentValue(source it, target comp) {
  it.answer first as a then {
    a.value as v -> comp.value = v "plainValue";
  } "componentAnswer";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetLaboratoryCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'laboratory' "categoryCode";
      qr -> coding.display = 'Laboratory' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group BuildServiceRequestBase(source qr : QR, target r : ServiceRequest, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetServiceRequestFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'ServiceRequest' "requestUrl";
  } "entryRequest";
  qr.subject as s -> r.subject = s "subject";
}

group SetServiceRequestFullUrl(source r : ServiceRequest, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/ServiceRequest/', id) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'coagulation-profile-requisition' "provenanceCode";
      qr -> t.display = 'Coagulation profile requisition' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";
}
