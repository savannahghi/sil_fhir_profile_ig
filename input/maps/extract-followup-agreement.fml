/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractFollowupAgreement"
/// name = "ExtractFollowupAgreement"
/// title = "Follow-up Agreement Extraction"
/// status = "active"
/// description = "The follow-up agreement as a DocumentReference indexing the signed form, plus one RelatedPerson per parent or guardian named on it. The response itself is the agreement, kept verbatim, and the DocumentReference is how the rest of the system finds it against the client\'s record. It replaces the Contract and the Practitioner this map used to produce: Contract sits at FMM 1 and nothing downstream implements it, and a Practitioner invented from the counsellor\'s typed name is a duplicate of a record that already exists -- the counsellor who recorded the response is its author. The guardians stay as RelatedPersons because the form is where they enter the record at all: their names, relationships and phone numbers exist nowhere else to point at."
//
// GATE: item.where(linkId = 'undertakings').item.answer.value.exists() or item.where(linkId = 'guardians').item.where(linkId = 'guardian.name').answer.value.exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/DocumentReference" alias DocumentReference as target
uses "http://hl7.org/fhir/StructureDefinition/RelatedPerson" alias RelatedPerson as target

group ExtractFollowupAgreement(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // Built only once an undertaking has been made: an agreement with nothing
  // undertaken is a blank form.
  qr where (item.where(linkId = 'undertakings').item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('DocumentReference') as doc then {
    qr -> doc, entry then BuildDocRefBase(qr, doc, entry) "base";

    qr -> doc.type as ty then {
      qr -> ty.coding as coding then {
        qr -> coding.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "typeSystem";
        qr -> coding.code = 'follow-up-agreement' "typeCode";
        qr -> coding.display = 'Follow-up agreement' "typeDisplay";
      } "typeCoding";
      qr -> ty.text = 'Agreement on the one-year aftercare follow-up programme' "typeText";
    } "type";

    qr -> doc.description = 'Agreement between the centre, the client and the client\'s guardians on the one-year follow-up programme. The undertakings ticked, the contact details and the signatures are on the referenced form response, which is the agreement itself.' "description";

    // Final once the client has signed, preliminary until then. The typed
    // signatures stay on the form; see the signatures issue in the assessment
    // for where a real attestation would come from.
    qr where (item.where(linkId = 'client').item.where(linkId = 'client.signed').answer.value = true) -> doc.docStatus = 'final' "docStatusFinal";
    qr where ((item.where(linkId = 'client').item.where(linkId = 'client.signed').answer.value = true).not()) -> doc.docStatus = 'preliminary' "docStatusPreliminary";
  } "documentEntry";

  // One RelatedPerson per guardian named on the form. RelatedPerson.patient is
  // mandatory, so these are only built when the response carries a subject to
  // hang them on.
  qr where (subject.reference.exists() and subject.reference.startsWith('Patient/')) then {
    qr.item as gg where (linkId = 'guardians' and item.where(linkId = 'guardian.name').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('RelatedPerson') as rp then
        BuildGuardian(qr, gg, rp, entry) "guardianEntry";
  } "guardians";
}

// One named guardian -> one RelatedPerson carrying the name, relationship and
// phone number the form captured. The typed signature stays on the form.
group BuildGuardian(source qr : QR, source gg, target rp : RelatedPerson, target entry) {
  qr -> rp then SetResponseProvenance(qr, rp) "responseProvenance";
  qr -> rp.id = uuid() then SetRelatedPersonFullUrl(rp, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'RelatedPerson' "requestUrl";
  } "entryRequest";

  qr.subject as s -> rp.patient = s "patient";

  gg.item as it where (linkId = 'guardian.name') then {
    it.answer first as a then {
      a.value as v -> rp.name as name, name.text = v "guardianName";
    } "answer";
  } "nameRule";

  gg.item as it where (linkId = 'guardian.relation') then {
    it.answer first as a then {
      a.value as v -> rp.relationship as rel, rel.text = v "guardianRelation";
    } "answer";
  } "relationRule";

  gg.item as it where (linkId = 'guardian.mobile') then {
    it.answer first as a then {
      a.value as v -> rp.telecom as tel then {
        v -> tel.system = 'phone' "telecomSystem";
        v -> tel.value = v "telecomValue";
      } "telecom";
    } "answer";
  } "mobileRule";
}

group SetRelatedPersonFullUrl(source rp : RelatedPerson, target entry) {
  rp.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/RelatedPerson/', id) "assignFullUrl";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

group BuildDocRefBase(source qr : QR, target r : DocumentReference, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetDocRefFullUrl(r, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'DocumentReference' "requestUrl";
  } "entryRequest";

  qr -> r.status = 'current' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.context = e "context";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.author = a "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.author = src "authorFromSource";
  } "authorFallback";

  // The content IS the stored response: the attachment points at it rather
  // than copying it. A stored response's id already reads
  // "QuestionnaireResponse/<id>", so it is a relative URL as it stands; the
  // hasValue() guard stops an unsaved response from writing a null link.
  qr.id as qid where ($this.hasValue()) -> r.content as content, content.attachment as att then {
    qid -> att.url = qid "attachmentUrl";
    qid -> att.contentType = 'application/fhir+json' "attachmentContentType";
    qr.authored as t -> att.creation = t "attachmentCreation";
  } "content";
}

group SetDocRefFullUrl(source r : DocumentReference, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/DocumentReference/', id) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a record can always be traced to the form that made it. The
// second copies the tenant tags off the response, because nothing else on the
// path puts them there. The response's identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'followup-agreement' "provenanceCode";
      qr -> t.display = 'Follow-up agreement form' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
