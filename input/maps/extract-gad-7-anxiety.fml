/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractGad7Anxiety"
/// name = "ExtractGad7Anxiety"
/// title = "GAD-7 Anxiety Extraction"
/// status = "active"
/// description = "The GAD-7 out as one Observation under LOINC 70274-6, the GAD-7 total score, made once all seven items are answered: the total the form calculated, or the answers summed here, its severity as the interpretation (0-4 minimal, 5-9 mild, 10-14 moderate, 15-21 severe), and the seven items and the difficulty question as components under LOINC's own GAD-7 codes with LOINC's answer codes, each local weighted answer kept beside its LOINC one."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractGad7Anxiety(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The GAD-7: one Observation for the total, the items as components ──────
  // Only a complete GAD-7 is a GAD-7 score: all seven items answered.
  qr where (item.where(linkId = 'gad7').item.where(answer.value.ofType(Coding).exists()).count() = 7) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";
    qr -> obs.code as cc then {
      qr -> cc.coding as cg then {
        qr -> cg.system = 'http://loinc.org' "sys";
        qr -> cg.code = '70274-6' "cd";
        qr -> cg.display = 'Generalized anxiety disorder 7 item (GAD-7) total score [Reported.PHQ]' "dsp";
      } "coding";
      qr -> cc.text = 'GAD-7 anxiety total score' "text";
    } "code";
    qr -> obs.value = evaluate(qr, iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) "total";
    qr where ((iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) >= 0 and (iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 4) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'gad7-minimal-anxiety' "cd";
        qr -> cg.display = 'Minimal anxiety' "dsp";
      } "coding";
      qr -> itp.text = 'Minimal anxiety' "text";
    } "gad7_minimal_anxiety";
    qr where ((iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) >= 5 and (iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 9) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'gad7-mild-anxiety' "cd";
        qr -> cg.display = 'Mild anxiety' "dsp";
      } "coding";
      qr -> itp.text = 'Mild anxiety' "text";
    } "gad7_mild_anxiety";
    qr where ((iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) >= 10 and (iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 14) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'gad7-moderate-anxiety' "cd";
        qr -> cg.display = 'Moderate anxiety' "dsp";
      } "coding";
      qr -> itp.text = 'Moderate anxiety' "text";
    } "gad7_moderate_anxiety";
    qr where ((iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) >= 15 and (iif(item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).exists(), item.where(linkId = 'score').item.where(linkId = 'score/total').answer.value.ofType(integer).first(), item.where(linkId = 'gad7').item.answer.value.ofType(Coding).code.select($this.replaceMatches('^.*-', '').toInteger()).aggregate($this + $total, 0))) <= 21) -> obs.interpretation as itp then {
      qr -> itp.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        qr -> cg.code = 'gad7-severe-anxiety' "cd";
        qr -> cg.display = 'Severe anxiety' "dsp";
      } "coding";
      qr -> itp.text = 'Severe anxiety' "text";
    } "gad7_severe_anxiety";
    qr.item as g where (linkId = 'gad7') then {
      g.item as it where (linkId = 'gad7/nervous' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69725-0' "cd";
            it -> cg.display = 'Feeling nervous, anxious or on edge in last 2 weeks' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "nervous";
      g.item as it where (linkId = 'gad7/control-worrying' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '68509-9' "cd";
            it -> cg.display = 'Not able to stop or control worrying in the last 2 weeks' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "control_worrying";
      g.item as it where (linkId = 'gad7/worrying-too-much' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69733-4' "cd";
            it -> cg.display = 'Worrying too much about different things in last 2 weeks [Reported.PHQ]' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "worrying_too_much";
      g.item as it where (linkId = 'gad7/relaxing' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69734-2' "cd";
            it -> cg.display = 'Trouble relaxing in last 2 weeks [Reported.PHQ]' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "relaxing";
      g.item as it where (linkId = 'gad7/restless' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69735-9' "cd";
            it -> cg.display = 'Being so restless that it is hard to sit still in last 2 weeks [Reported.PHQ]' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "restless";
      g.item as it where (linkId = 'gad7/irritable' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69689-8' "cd";
            it -> cg.display = 'Becoming easily annoyed or irritable in last 4 weeks [Reported.PHQ]' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "irritable";
      g.item as it where (linkId = 'gad7/afraid' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '69736-7' "cd";
            it -> cg.display = 'Feeling afraid as if something awful might happen in last 2 weeks [Reported.PHQ]' "dsp";
          } "coding";
        } "code";
        it -> comp then Gad7Answer(it, comp) "value";
      } "afraid";
    } "items";
    qr.item as it where (linkId = 'difficulty' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
      it -> comp.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '69722-7' "cd";
          it -> cg.display = 'How difficult have these made it for you to do your work, take care of things at home, or get along with other people [Reported.PHQ]' "dsp";
        } "coding";
      } "code";
      it -> comp then CopyCoding(it, comp) "value";
    } "difficulty";
  } "gad7";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr -> obs.status = 'final' "status";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";
  // The hasValue() guard stops an unsaved response, posted straight to $extract,
  // from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source r : Observation, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// A GAD-7 answer as LOINC's answer code, by its weight.
group Gad7Answer(source it, target comp) {
  it.answer first as a then {
    a.value as cv where (code.endsWith('-0')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA6568-5' "cd";
        cv -> cg.display = 'Not at all' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Not at all' "text";
    } "answer_0";
    a.value as cv where (code.endsWith('-1')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA6569-3' "cd";
        cv -> cg.display = 'Several days' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Several days' "text";
    } "answer_1";
    a.value as cv where (code.endsWith('-2')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA6570-1' "cd";
        cv -> cg.display = 'More than half the days' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'More than half the days' "text";
    } "answer_2";
    a.value as cv where (code.endsWith('-3')) -> comp.value = create('CodeableConcept') as vc then {
      cv -> vc.coding as cg then {
        cv -> cg.system = 'http://loinc.org' "sys";
        cv -> cg.code = 'LA6571-9' "cd";
        cv -> cg.display = 'Nearly every day' "dsp";
      } "loincCoding";
      cv -> vc.coding = cv "localCoding";
      cv -> vc.text = 'Nearly every day' "text";
    } "answer_3";
  } "answer";
}

// A coded answer kept as the coding the client sent, its display as the text.
group CopyCoding(source it, target t) {
  it.answer first as a then {
    a.value as cv -> t.value = create('CodeableConcept') as vc then {
      cv -> vc.coding = cv "valueCoding";
      cv.display as d -> vc.text = d "valueText";
    } "codedValue";
  } "answer";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'gad-7-anxiety' "provenanceCode";
      qr -> t.display = 'GAD-7 anxiety' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}
