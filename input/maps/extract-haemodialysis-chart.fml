/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractHaemodialysisChart"
/// name = "ExtractHaemodialysisChart"
/// title = "Haemodialysis Chart Extraction"
/// status = "active"
/// description = "One Observation per answer of the haemodialysis chart's two forms, coded like the haemodialysis-chart row it is charted on. A reading comes out at its own time, with the core vital signs interpreted against the chart's alerts and critical alerts; a named event comes out as true at the time it happened; a complication and the action taken as one line of text. Every Observation carries the response's basedOn, the dialysis session order. Generated by fhir-templates build_dialysis_chart.py."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractHaemodialysisChart(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── A reading, charted at its own time ───────────────────────────────
  qr.item as row where (linkId = 'reading') then {
    row.item as sec where (linkId = 'reading/vitals') then {
      sec.item as it where (linkId = 'reading/sbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8480-6' "cd";
            it -> cg.display = 'Systolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'LL', iif(answer.value.ofType(Quantity).value >= 180, 'HH', iif(answer.value.ofType(Quantity).value < 100, 'L', iif(answer.value.ofType(Quantity).value >= 160, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 90, 'Critically low', iif(answer.value.ofType(Quantity).value >= 180, 'Critically high', iif(answer.value.ofType(Quantity).value < 100, 'Low', iif(answer.value.ofType(Quantity).value >= 160, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_sbp";
      sec.item as it where (linkId = 'reading/dbp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8462-4' "cd";
            it -> cg.display = 'Diastolic blood pressure' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 110, 'HH', iif(answer.value.ofType(Quantity).value >= 100, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 110, 'Critically high', iif(answer.value.ofType(Quantity).value >= 100, 'High', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_dbp";
      sec.item as it where (linkId = 'reading/pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 40, 'LL', iif(answer.value.ofType(Quantity).value >= 130, 'HH', iif(answer.value.ofType(Quantity).value < 50, 'L', iif(answer.value.ofType(Quantity).value >= 101, 'H', 'N'))))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 40, 'Critically low', iif(answer.value.ofType(Quantity).value >= 130, 'Critically high', iif(answer.value.ofType(Quantity).value < 50, 'Low', iif(answer.value.ofType(Quantity).value >= 101, 'High', 'Normal'))))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_pulse";
      sec.item as it where (linkId = 'reading/temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8310-5' "cd";
            it -> cg.display = 'Body temperature' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 39, 'HH', iif(answer.value.ofType(Quantity).value >= 38, 'H', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 39, 'Critically high', iif(answer.value.ofType(Quantity).value >= 38, 'High', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_temperature";
      sec.item as it where (linkId = 'reading/spo2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '59408-5' "cd";
            it -> cg.display = 'Oxygen saturation in Arterial blood by Pulse oximetry' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 88, 'LL', iif(answer.value.ofType(Quantity).value < 92, 'L', 'N'))) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 88, 'Critically low', iif(answer.value.ofType(Quantity).value < 92, 'Low', 'Normal'))) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_spo2";
    } "reading_vitals";
    row.item as sec where (linkId = 'reading/circuit') then {
      sec.item as it where (linkId = 'reading/qb' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '99711-4' "cd";
            it -> cg.display = 'Blood flow rate RRT circuit' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_qb";
      sec.item as it where (linkId = 'reading/ap' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '99717-1' "cd";
            it -> cg.display = 'Access pressure RRT circuit' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < -200, 'L', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < -200, 'Low', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_ap";
      sec.item as it where (linkId = 'reading/vp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '99721-3' "cd";
            it -> cg.display = 'Return pressure RRT circuit' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 201, 'H', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 201, 'High', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_vp";
      sec.item as it where (linkId = 'reading/tmp' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '99720-5' "cd";
            it -> cg.display = 'Transmembrane pressure RRT circuit' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        it -> obs.interpretation as interp then {
          it -> interp.coding as icg then {
            it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value >= 251, 'H', 'N')) "cd";
            it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value >= 251, 'High', 'Normal')) "dsp";
          } "coding";
        } "interpretation";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_tmp";
      sec.item as it where (linkId = 'reading/uf-rate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-uf-rate' "cd";
            it -> cg.display = 'UF rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_uf_rate";
      sec.item as it where (linkId = 'reading/uf-removed' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '99741-1' "cd";
            it -> cg.display = 'Ultrafiltrate volume removed' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_uf_removed";
    } "reading_circuit";
    row.item as sec where (linkId = 'reading/fluids') then {
      sec.item as it where (linkId = 'reading/heparin' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-heparin-given' "cd";
            it -> cg.display = 'Heparin given' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_heparin";
      sec.item as it where (linkId = 'reading/saline' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-saline-given' "cd";
            it -> cg.display = 'Saline given' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_saline";
    } "reading_fluids";
    row.item as sec where (linkId = 'reading/events') then {
      sec.item as it where (linkId = 'reading/event' and answer.value.code = 'event-uf-paused') -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-event-uf-paused' "cd";
            it -> cg.display = 'UF paused' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_event_uf_paused";
      sec.item as it where (linkId = 'reading/event' and answer.value.code = 'event-uf-resumed') -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-event-uf-resumed' "cd";
            it -> cg.display = 'UF resumed' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_event_uf_resumed";
      sec.item as it where (linkId = 'reading/event' and answer.value.code = 'event-circuit-changed') -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-event-circuit-changed' "cd";
            it -> cg.display = 'Circuit changed' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_event_circuit_changed";
      sec.item as it where (linkId = 'reading/complication' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        qr -> obs then SetObservationOrder(qr, obs) "order";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'dial-complication' "cd";
            it -> cg.display = 'Complication' "dsp";
          } "coding";
        } "code";
        it -> obs.value = evaluate(sec, item.where(linkId = 'reading/complication').answer.value.display.first().toString() + iif(item.where(linkId = 'reading/complication-action').answer.value.first().exists(), ': ' + item.where(linkId = 'reading/complication-action').answer.value.first().toString(), '')) "composed";
        row -> obs then SetReadingTime(row, obs) "time";
      } "reading_complication";
    } "reading_events";
  } "reading";

  // ── Safety and setup ──
  qr.item as g where (linkId = 'setup') then {
    g.item as it where (linkId = 'setup/treatment-number' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      qr -> obs then SetObservationOrder(qr, obs) "order";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'dial-treatment-number' "cd";
          it -> cg.display = 'Treatment number' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
    } "setup_treatment_number";
    g.item as it where (linkId = 'setup/mode' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      qr -> obs then SetObservationOrder(qr, obs) "order";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'dial-mode' "cd";
          it -> cg.display = 'Mode' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "setup_mode";
    g.item as it where (linkId = 'setup/machine' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      qr -> obs then SetObservationOrder(qr, obs) "order";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'dial-machine' "cd";
          it -> cg.display = 'Machine' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
    } "setup_machine";
    g.item as it where (linkId = 'setup/machine-check' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      qr -> obs then SetObservationOrder(qr, obs) "order";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'dial-machine-check' "cd";
          it -> cg.display = 'Machine self-test (T1) passed' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "setup_machine_check";
    g.item as it where (linkId = 'setup/conductivity' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
