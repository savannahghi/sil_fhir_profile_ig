/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractHduInputOutputChart"
/// name = "ExtractHduInputOutputChart"
/// title = "HDU Input and Output Chart Extraction"
/// status = "active"
/// description = "The 24-hour totals under LOINC 9108-2 fluid intake and 9192-6 urine output, plus the balance, and each hourly row as its own pair of panels. The totals are what every fluid decision on the unit turns on and what a later reader actually queries; the hourly rows are kept so the total can be audited against them, which matters because on paper the total is arithmetic done by hand at the end of a twelve-hour shift."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractHduInputOutputChart(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The 24-hour totals ──────────────────────────────────────────────────
  qr.item as g where (linkId = 'totals') then {
    g.item as it where (linkId = 'totals/intake' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '9108-2' "cd";
          it -> cg.display = 'Fluid intake total 24 hour' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = create('Quantity') as q then {
          v -> q.value = v "qValue";
          v -> q.unit = 'mL' "qUnit";
          v -> q.system = 'http://unitsofmeasure.org' "qSystem";
          v -> q.code = 'mL' "qCode";
        } "quantity";
      } "answer";
    } "measureq_9108_2";

    g.item as it where (linkId = 'totals/output' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'fluid-balance-fluid-output-total-24-hour' "cd";
          it -> cg.display = 'Fluid output total 24 hour' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = create('Quantity') as q then {
          v -> q.value = v "qValue";
          v -> q.unit = 'mL' "qUnit";
          v -> q.system = 'http://unitsofmeasure.org' "qSystem";
          v -> q.code = 'mL' "qCode";
        } "quantity";
      } "answer";
    } "measureq_fluid_balance";

    g.item as it where (linkId = 'totals/balance' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'fluid-balance-over-24-hours' "cd";
          it -> cg.display = 'Fluid balance over 24 hours' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = create('Quantity') as q then {
          v -> q.value = v "qValue";
          v -> q.unit = 'mL' "qUnit";
          v -> q.system = 'http://unitsofmeasure.org' "qSystem";
          v -> q.code = 'mL' "qCode";
        } "quantity";
      } "answer";
    } "measureq_fluid_balance2";

    g.item as it where (linkId = 'totals/remarks' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'fluid-balance-remarks-on-the-fluid-balance-chart' "cd";
          it -> cg.display = 'Remarks on the fluid balance chart' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as txt -> obs.note as n, n.text = txt "text";
      } "answer";
    } "narr_fluid_balance_remarks_on_the_fluid_balance_chart";

  } "totalsGroup";

  // ── The urine output total, separately ──────────────────────────────────
  // Under its own LOINC code and summed from the hourly rows, because urine
  // output is the number that says whether a kidney is still working and it is
  // asked for on its own, not as part of a balance.
  qr where (item.where(linkId = 'hour').item.where(linkId = 'hour/out').item.where(linkId = 'hour/out/urine').answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetVitalSignsCategory(qr, obs) "category";
    qr -> obs.code as cc then {
      qr -> cc.coding as cg then {
        qr -> cg.system = 'http://loinc.org' "sys";
        qr -> cg.code = '9192-6' "cd";
        qr -> cg.display = 'Urine output 24 hour' "dsp";
      } "coding";
    } "code";
    qr -> obs.value = create('Quantity') as q then {
      qr -> q.value = evaluate(qr, item.where(linkId = 'hour').item.where(linkId = 'hour/out').item.where(linkId = 'hour/out/urine').answer.value.ofType(Quantity).value.aggregate($this + $total, 0)) "qValue";
      qr -> q.unit = 'mL' "qUnit";
      qr -> q.system = 'http://unitsofmeasure.org' "qSystem";
      qr -> q.code = 'mL' "qCode";
    } "quantity";
    qr -> obs.note as n, n.text = 'Summed from the hourly rows on the input and output chart' "sumNote";
  } "urineOutputTotal";

  // ── One hourly row ──────────────────────────────────────────────────────
  qr.item as h where (linkId = 'hour') then {
    h.item as i where (linkId = 'hour/in' and item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      i -> obs.code as cc then {
        i -> cc.coding as cg then {
          i -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          i -> cg.code = 'fluid-balance-hourly-fluid-intake' "cd";
          i -> cg.display = 'Hourly fluid intake' "dsp";
        } "coding";
      } "code";
      i.item as it where (linkId = 'hour/in/parenteral-fluid' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-parenteral-fluid-given' "cd";
            it -> cg.display = 'Parenteral fluid given' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_parenteral_fluid_given";
      i.item as it where (linkId = 'hour/in/parenteral-amount' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-parenteral-fluid-volume' "cd";
            it -> cg.display = 'Parenteral fluid volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_parenteral_fluid_volume";
      i.item as it where (linkId = 'hour/in/parenteral-fluid-2' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-second-parenteral-fluid-given' "cd";
            it -> cg.display = 'Second parenteral fluid given' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_second_parenteral_fluid_given";
      i.item as it where (linkId = 'hour/in/parenteral-amount-2' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-second-parenteral-fluid-volume' "cd";
            it -> cg.display = 'Second parenteral fluid volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_second_parenteral_fluid_volume";
      i.item as it where (linkId = 'hour/in/blood' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-blood-volume-given' "cd";
            it -> cg.display = 'Blood volume given' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_blood_volume_given";
      i.item as it where (linkId = 'hour/in/oral-or-ng-type' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-oral-or-nasogastric-feed-given' "cd";
            it -> cg.display = 'Oral or nasogastric feed given' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_oral_or_nasogastric_feed_given";
      i.item as it where (linkId = 'hour/in/oral-or-ng-amount' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-oral-or-nasogastric-volume' "cd";
            it -> cg.display = 'Oral or nasogastric volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_oral_or_nasogastric_volume";
      h -> obs then SetHourTime(qr, h, obs) "hourTime";
    } "hourlyIntake";

    h.item as o where (linkId = 'hour/out' and item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      o -> obs.code as cc then {
        o -> cc.coding as cg then {
          o -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          o -> cg.code = 'fluid-balance-hourly-fluid-output' "cd";
          o -> cg.display = 'Hourly fluid output' "dsp";
        } "coding";
      } "code";
      o.item as it where (linkId = 'hour/out/ng-aspirate' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-nasogastric-aspirate-volume' "cd";
            it -> cg.display = 'Nasogastric aspirate volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_nasogastric_aspirate_volume";
      o.item as it where (linkId = 'hour/out/vomit' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-vomit-volume' "cd";
            it -> cg.display = 'Vomit volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_vomit_volume";
      o.item as it where (linkId = 'hour/out/drain' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-drain-volume' "cd";
            it -> cg.display = 'Drain volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_drain_volume";
      o.item as it where (linkId = 'hour/out/urine' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-urine-volume' "cd";
            it -> cg.display = 'Urine volume' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_urine_volume";
      o.item as it where (linkId = 'hour/out/stool' and answer.value.exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'fluid-balance-stool-passed' "cd";
            it -> cg.display = 'Stool passed' "dsp";
          } "coding";
        } "code";
        it -> comp then SetComponentValue(it, comp) "value";
      } "comp_fluid_balance_stool_passed";
      h -> obs then SetHourTime(qr, h, obs) "hourTime";
    } "hourlyOutput";
  } "hourlyRows";
}

// The row's clock time joined to a date, over the authored time
// ConformObservation writes. The chart is the 24 hours up to the time it is
// filed, so a row is the latest occurrence of its clock time at or before the
// authored moment, with an hour of slack for a row charted a little early. The
// offset is the unit's, East Africa Time, as the chart's times are wall-clock
// times. The day is worked out on instants, not on the authored string, so an
// authored time in UTC (the questionnaire tester sends one) gives the same day;
// only the shift comes out of the comparison, because comparing two dateTimes
// rewrites them into UTC in place.
group SetHourTime(source qr : QR, source h, target obs : Observation) {
  h.item as it where (linkId = 'hour/time' and answer.value.exists()) then {
    it.answer first as a then {
      a.value as t -> obs.note as n, n.text = 'Recorded against the clock hour on the input and output chart' "timeNote";
    } "answer";
  } "hourTimeRule";
  qr.authored as au where ($this.toString().length() >= 19) then {
    h.item as it where (linkId = 'hour/time' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as tm where ($this is time) -> evaluate(tm, %au.toString().substring(0, 10) + 'T' + $this.toString() + '+03:00') as cand, cast(cand, 'dateTime') as candDt, evaluate(candDt, iif($this + 1 day <= %au + 1 hour, 1, iif($this <= %au + 1 hour, 0, -1))) as shift, evaluate(tm, %au.toString().substring(0, 10)) as dayStr, cast(dayStr, 'date') as day0, evaluate(day0, iif(%shift = 1, $this + 1 day, iif(%shift = -1, $this - 1 day, $this)).toString() + 'T' + %tm.toString() + '+03:00') as stamp, obs.effective = cast(stamp, 'dateTime') "hourTimeOnAuthoredDay";
      } "answer";
    } "hourTimeRule";
  } "hourAuthored";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group SetComponentValue(source it, target comp) {
  it.answer first as a then {
    a.value as v -> comp.value = v "plainValue";
  } "componentAnswer";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'hdu-input-output-chart' "provenanceCode";
      qr -> t.display = 'HDU input and output chart' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}
