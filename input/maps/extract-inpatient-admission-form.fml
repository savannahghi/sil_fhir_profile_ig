/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractInpatientAdmissionForm"
/// name = "ExtractInpatientAdmissionForm"
/// title = "Inpatient Admission Form Extraction"
/// status = "active"
/// description = "The admission form out as the facts a stay is read from: the ward and bed as Observations against the response\'s own encounter (no Encounter is minted; the response carries the admission), the admitting diagnosis as a provisional Condition in the doctor\'s wording, a reported drug reaction and a reported allergy as unconfirmed AllergyIntolerances since they are what must reach whoever prescribes next, the rest of the nursing history and the obstetric and social history as Observations, and the admission vital signs at the time they were taken with the blood pressure paired. The admission side is written only once the ward nurse has confirmed it. The discharge becomes a discharge-note Composition dated to the discharge, written only once the doctor has signed it off."
//
// GATE: (item.where(linkId = 'nurseSignoff').item.where(linkId = 'nurseSignoff.signed').answer.value = true) or (item.where(linkId = 'discharge').item.where(linkId = 'discharge.doctorSigned').answer.value = true)
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/AllergyIntolerance" alias AllergyIntolerance as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target

group ExtractInpatientAdmissionForm(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The admission, once the ward nurse has confirmed the entries ─────────
  // Everything on the admission side is guarded on the nurse's confirmation: the
  // form is filled progressively on the ward, and a half-filled admission must
  // not read as a complete one. No Encounter is minted here; the response's own
  // encounter is the admission, and the ward, bed and arrival facts attach to it
  // as Observations the way the other admission forms do.
  qr where (item.where(linkId = 'nurseSignoff').item.where(linkId = 'nurseSignoff.signed').answer.value = true) then {
    qr.item as g where (linkId = 'admission') then {
      g.item as it where (linkId = 'admission.ward' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'discharge-ward-of-admission' "cd";
            it -> cg.display = 'Ward of admission' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_discharge_ward_of_admission_1";
      g.item as it where (linkId = 'admission.bed' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'admission-route-bed' "cd";
            it -> cg.display = 'Bed' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_admission_route_bed_2";
      // The admitting diagnosis is a Condition, provisional because an admitting
      // impression is exactly that; it carries the clinician's wording as text.
      g.item as it where (linkId = 'admission.diagnosis' and answer.value.exists()) -> bundle.entry as entryC, entryC.resource = create('Condition') as cond then {
        qr -> cond, entryC then BuildConditionBase(qr, cond, entryC) "conditionBase";
        qr -> cond.verificationStatus as vs then {
          qr -> vs.coding as vsc then {
            qr -> vsc.system = 'http://terminology.hl7.org/CodeSystem/condition-ver-status' "verSystem";
            qr -> vsc.code = 'provisional' "verCode";
            qr -> vsc.display = 'Provisional' "verDisplay";
          } "verCoding";
        } "verificationStatus";
        it.answer first as a then {
          a.value : string as v -> cond.code as code, code.text = v "codeText";
        } "answer";
        g.item as dt where (linkId = 'admission.dateTime' and answer.value.exists()) then {
          dt.answer first as da then {
            da.value : dateTime as t -> cond.recordedDate = t "recordedAtAdmission";
          } "dateAnswer";
        } "admissionTime";
        g.item as pf where (linkId = 'admission.admittingDoctor' and answer.value.exists()) then {
          pf.answer first as pa then {
            pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> cond.participant as part, part.actor = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "performer";
          } "performerAnswer";
        } "performer_3";
      } "admittingDiagnosis";
    } "admissionGroup";

    // ── The nursing history ───────────────────────────────────────────────
    qr.item as g where (linkId = 'history') then {
      // A reaction to a drug and an allergy each become an AllergyIntolerance,
      // because they are the two things on this sheet that must reach whoever
      // prescribes next. Unconfirmed: the patient reported them.
      g.item as it where (linkId = 'history.drugReaction' and answer.value = true) -> bundle.entry as entry, entry.resource = create('AllergyIntolerance') as allergy then {
        qr -> allergy, entry then BuildAllergyIntoleranceBase(qr, allergy, entry) "base";
        it -> allergy.clinicalStatus as cs then {
          it -> cs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/allergyintolerance-clinical' "sys";
            it -> cg.code = 'active' "cd";
            it -> cg.display = 'Active' "dsp";
          } "coding";
        } "clinicalStatus";
        it -> allergy.verificationStatus as vs then {
          it -> vs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/allergyintolerance-verification' "sys";
            it -> cg.code = 'unconfirmed' "cd";
            it -> cg.display = 'Unconfirmed' "dsp";
          } "coding";
        } "verificationStatus";
        qr.authored as t -> allergy.recordedDate = t "recordedDate";
        it -> allergy.category = 'medication' "category";
        it -> allergy.code as cc, cc.text = 'Reaction to a drug reported on admission' "codeText";
        g.item as nt where (linkId = 'history.drugReactionDetails' and answer.value.exists()) then {
          nt.answer first as na then {
            na.value : string as txt -> allergy.reaction as rx, rx.manifestation as man, man.concept as mc, mc.text = txt "manifestationText";
            na.value : string as txt -> allergy.reaction as rx2, rx2.description = txt "reactionDescription";
          } "noteAnswer";
        } "drugReactionDetails";
      } "drugReactionAllergy";
      g.item as it where (linkId = 'history.allergy' and answer.value = true) -> bundle.entry as entry, entry.resource = create('AllergyIntolerance') as allergy then {
        qr -> allergy, entry then BuildAllergyIntoleranceBase(qr, allergy, entry) "base";
        it -> allergy.clinicalStatus as cs then {
          it -> cs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/allergyintolerance-clinical' "sys";
            it -> cg.code = 'active' "cd";
            it -> cg.display = 'Active' "dsp";
          } "coding";
        } "clinicalStatus";
        it -> allergy.verificationStatus as vs then {
          it -> vs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/allergyintolerance-verification' "sys";
            it -> cg.code = 'unconfirmed' "cd";
            it -> cg.display = 'Unconfirmed' "dsp";
          } "coding";
        } "verificationStatus";
        qr.authored as t -> allergy.recordedDate = t "recordedDate";
        it -> allergy.code as cc, cc.text = 'Allergy reported on admission (e.g. food, pollen)' "codeText";
        g.item as nt where (linkId = 'history.allergyDetails' and answer.value.exists()) then {
          nt.answer first as na then {
            na.value : string as txt -> allergy.reaction as rx, rx.manifestation as man, man.concept as mc, mc.text = txt "manifestationText";
            na.value : string as txt -> allergy.reaction as rx2, rx2.description = txt "reactionDescription";
          } "noteAnswer";
        } "allergyDetails";
      } "allergy";
      g.item as it where (linkId = 'history.steroids' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'history-corticosteroid-treatment' "cd";
            it -> cg.display = 'Previous corticosteroid treatment' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : boolean as v -> obs.value = v "value";
        } "answer";
        g.item as nt where (linkId = 'history.steroidsDetails' and answer.value.exists()) then {
          nt.answer first as na then {
            na.value : string as txt -> obs.note as n, n.text = append('Details: ', txt) "noteText";
          } "noteAnswer";
        } "note_4";
      } "obs_history_corticosteroid_treatment_5";
      g.item as it where (linkId = 'history.chronicIllness' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'history-of-chronic-illness' "cd";
            it -> cg.display = 'History of chronic illness' "dsp";
          } "coding";
        } "code";
        it -> obs.value = create('CodeableConcept') as vc then {
          it.answer as a then {
            a.value : Coding as cv -> vc.coding = cv "valueCoding";
          } "answers";
        } "codedValues";
        g.item as nt where (linkId = 'history.chronicIllnessDetails' and answer.value.exists()) then {
          nt.answer first as na then {
            na.value : string as txt -> obs.note as n, n.text = append('Specified as: ', txt) "noteText";
          } "noteAnswer";
        } "note_6";
      } "obs_history_of_chronic_illness_7";
      g.item as it where (linkId = 'history.pastHistory' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '11349-8' "cd";
            it -> cg.display = 'History of Past illness Narrative' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as txt -> obs.note as n, n.text = txt "text";
        } "answer";
      } "obs_11349_8_8";
      g.item as it where (linkId = 'history.presentHistory' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '10164-2' "cd";
            it -> cg.display = 'History of Present illness Narrative' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as txt -> obs.note as n, n.text = txt "text";
        } "answer";
      } "obs_10164_2_9";
      g.item as og where (linkId = 'history.obstetric') then {
        og.item as it where (linkId = 'history.obstetric.parity' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '11977-6' "cd";
              it -> cg.display = 'Parity' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : integer as v -> obs.value = v "value";
          } "answer";
        } "obs_11977_6_10";
        og.item as it where (linkId = 'history.obstetric.lmp' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '8665-2' "cd";
              it -> cg.display = 'Last menstrual period start date' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
          } "answer";
        } "obs_8665_2_11";
      } "obstetricGroup";
      g.item as sg where (linkId = 'history.social') then {
        sg.item as it where (linkId = 'history.social.alcohol' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'nursing-assessment-takes-alcohol' "cd";
              it -> cg.display = 'Takes alcohol' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : boolean as v -> obs.value = v "value";
          } "answer";
        } "obs_nursing_assessment_takes_alcohol_12";
        sg.item as it where (linkId = 'history.social.smoker' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'nursing-assessment-smokes-cigarettes' "cd";
              it -> cg.display = 'Smokes cigarettes' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : boolean as v -> obs.value = v "value";
          } "answer";
        } "obs_nursing_assessment_smokes_cigarettes_13";
        sg.item as it where (linkId = 'history.social.notes' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '29762-2' "cd";
              it -> cg.display = 'Social history Narrative' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as txt -> obs.note as n, n.text = txt "text";
          } "answer";
        } "obs_29762_2_14";
      } "socialGroup";
    } "historyGroup";

    // ── Observations on admission ─────────────────────────────────────────
    // Each at the time they were taken, from the group's own time item.
    qr.item as row where (linkId = 'observation') then {
      row.item as it where (linkId = 'observation.temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8310-5' "cd";
            it -> cg.display = 'Body temperature' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
      } "obs_8310_5_15";
      row.item as bp where (linkId = 'observation.bloodPressure') then {
        bp where ((item.where(linkId = 'observation.bloodPressure.systolic').answer.value.ofType(Quantity).exists() or item.where(linkId = 'observation.bloodPressure.diastolic').answer.value.ofType(Quantity).exists())) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          bp -> obs.code as cc then {
            bp -> cc.coding as cg then {
              bp -> cg.system = 'http://loinc.org' "sys";
              bp -> cg.code = '85354-9' "cd";
              bp -> cg.display = 'Blood pressure panel with all children optional' "dsp";
            } "coding";
          } "code";
          bp.item as ci where (linkId = 'observation.bloodPressure.systolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
            ci -> comp.code as cc then {
              ci -> cc.coding as cg then {
                ci -> cg.system = 'http://loinc.org' "sys";
                ci -> cg.code = '8480-6' "cd";
                ci -> cg.display = 'Systolic blood pressure' "dsp";
              } "coding";
            } "code";
            ci.answer first as a then {
              a.value : Quantity as v -> comp.value = v "value";
            } "answer";
          } "comp_8480_6_16";
          bp.item as ci where (linkId = 'observation.bloodPressure.diastolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
            ci -> comp.code as cc then {
              ci -> cc.coding as cg then {
                ci -> cg.system = 'http://loinc.org' "sys";
                ci -> cg.code = '8462-4' "cd";
                ci -> cg.display = 'Diastolic blood pressure' "dsp";
              } "coding";
            } "code";
            ci.answer first as a then {
              a.value : Quantity as v -> comp.value = v "value";
            } "answer";
          } "comp_8462_4_17";
          row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
        } "panel_85354_9_18";
      } "bloodPressureGroup";
      row.item as it where (linkId = 'observation.pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
      } "obs_8867_4_19";
      row.item as it where (linkId = 'observation.spo2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '59408-5' "cd";
            it -> cg.display = 'Oxygen saturation in Arterial blood by Pulse oximetry' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
      } "obs_59408_5_20";
      row.item as it where (linkId = 'observation.respiratoryRate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '9279-1' "cd";
            it -> cg.display = 'Respiratory rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
      } "obs_9279_1_21";
      row.item as it where (linkId = 'observation.weight' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '29463-7' "cd";
            it -> cg.display = 'Body weight' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        row -> obs then SetAdmissionObservationTime(row, obs) "rowTime";
      } "obs_29463_7_22";
    } "observationGroup";
  } "admissionSide";

  // ── The discharge, once the doctor has signed it off ──────────────────────
  // A discharge note Composition with the discharge notes as its body, dated to
  // the discharge. Written only when the discharge is recorded and signed.
  qr where ((item.where(linkId = 'discharge').item.where(linkId = 'discharge.doctorSigned').answer.value = true) and item.where(linkId = 'discharge').item.where(linkId = 'discharge.record').answer.value = true) -> bundle.entry as entry, entry.resource = create('Composition') as comp then {
    qr -> comp, entry then BuildNoteBase(qr, comp, entry) "noteBase";
    qr -> comp.name = 'DischargeNote' "noteName";
    qr -> comp.title = 'Discharge note' "noteTitle";
    qr -> comp.type as ty then {
      qr -> ty.coding as sghi then {
        qr -> sghi.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/inpatient-document-type-codesystem' "sghiSystem";
        qr -> sghi.code = 'discharge-note' "sghiCode";
        qr -> sghi.display = 'Discharge note' "sghiDisplay";
      } "sghiCoding";
      qr -> ty.coding as loinc then {
        qr -> loinc.system = 'http://loinc.org' "loincSystem";
        qr -> loinc.code = '18842-5' "loincCode";
        qr -> loinc.display = 'Discharge summary' "loincDisplay";
      } "loincCoding";
      qr -> ty.text = 'Discharge note' "typeText";
    } "noteType";
    qr.item as dg where (linkId = 'discharge') then {
      dg.item as it where (linkId = 'discharge.dateTime' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : dateTime as t -> comp.date = t "dischargeDate";
        } "answer";
      } "dischargeTime";
      dg.item as it where (linkId = 'discharge.notes' and answer.value.exists()) -> comp.section as sec then {
        it -> sec.title = 'Discharge notes' "title";
        it -> sec then AddSectionText(it, sec) "text";
      } "section_discharge_notes_23";
      dg.item as it where (linkId = 'discharge.dischargedBy' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> comp.attester as att then {
            ref -> att.mode = 'professional' "attesterMode";
            ref -> att.party = create('Reference') as party then {
              ref.reference as v -> party.reference = v "reference";
              ref.type as v -> party.type = v "type";
              ref.identifier as v -> party.identifier = v "identifier";
              ref.display as v -> party.display = v "display";
            } "attesterParty";
            qr.authored as t -> att.time = t "attesterTime";
          } "attester";
        } "answer";
      } "dischargedBy";
    } "dischargeGroup";
  } "dischargeNote";
}

group SetAdmissionObservationTime(source row, target obs : Observation) {
  row.item as it where (linkId = 'observation.time' and answer.value.exists()) then {
    it.answer first as a then {
      a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "effective";
    } "answer";
  } "timeRule";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  // The response's subject is Reference(Any); the guard keeps Patients and the
  // copy, field by field, is what satisfies a type checker that cannot see the
  // guard. Same for the encounter.
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The length guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.toString().length() > 0) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value : Coding as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

// Everything a Condition extracted from one of these forms shares. The caller
// supplies verificationStatus and code, because those are the two things that
// differ between an admitting impression and an operative diagnosis.
group BuildConditionBase(source qr : QR, target cond : Condition, target entry) {
  qr -> cond then SetResponseProvenance(qr, cond) "responseProvenance";
  qr -> cond.id = uuid() then SetConditionFullUrl(cond, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Condition' "requestUrl";
  } "entryRequest";

  qr -> cond.clinicalStatus as cs then {
    qr -> cs.coding as csc then {
      qr -> csc.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "clinSystem";
      qr -> csc.code = 'active' "clinCode";
      qr -> csc.display = 'Active' "clinDisplay";
    } "clinCoding";
  } "clinicalStatus";

  qr -> cond.category as cat then {
    qr -> cat.coding as catc then {
      qr -> catc.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "catSystem";
      qr -> catc.code = 'encounter-diagnosis' "catCode";
      qr -> catc.display = 'Encounter Diagnosis' "catDisplay";
    } "catCoding";
  } "category";

  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> cond.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> cond.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> cond.recordedDate = t "recordedDate";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part then {
    a -> part.actor = create('Reference') as ref then {
      a.reference as v -> ref.reference = v "reference";
      a.type as v -> ref.type = v "type";
      a.identifier as v -> ref.identifier = v "identifier";
      a.display as v -> ref.display = v "display";
    } "participantActor";
  } "participantFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part2 then {
      src -> part2.actor = create('Reference') as ref then {
        src.reference as v -> ref.reference = v "reference";
        src.type as v -> ref.type = v "type";
        src.identifier as v -> ref.identifier = v "identifier";
        src.display as v -> ref.display = v "display";
      } "participantActorFromSource";
    } "participantFromSource";
  } "participantFallback";

  qr.id as qid where ($this.toString().length() > 0) -> cond.evidence as ev, ev.reference = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetConditionFullUrl(source cond : Condition, target entry) {
  cond.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Condition/',
    id
  ) "assignFullUrl";
}

group BuildAllergyIntoleranceBase(source qr : QR, target r : AllergyIntolerance, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetAllergyIntoleranceFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'AllergyIntolerance' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.patient = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr -> r then ConformAllergyIntolerance(qr, r) "profileConformance";
}

group SetAllergyIntoleranceFullUrl(source r : AllergyIntolerance, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/AllergyIntolerance/', id) "assignFullUrl";
}

group ConformAllergyIntolerance(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> r.recordedDate = t "recordedDate";
  qr.author as au where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> r.participant as p then AuthorParticipant(au, p) "participantFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> r.participant as p then AuthorParticipant(src, p) "participantFromSource";
  } "participantFallback";
}

group AuthorParticipant(source who, target p) {
  who as w -> p.actor = create('Reference') as ref then {
    w.reference as v -> ref.reference = v "reference";
    w.type as v -> ref.type = v "type";
    w.identifier as v -> ref.identifier = v "identifier";
    w.display as v -> ref.display = v "display";
  } "actor";
  who -> p.function as fn then {
    who -> fn.coding as cg then {
      who -> cg.system = 'http://terminology.hl7.org/CodeSystem/provenance-participant-type' "sys";
      who -> cg.code = 'author' "cd";
      who -> cg.display = 'Author' "dsp";
    } "coding";
  } "function";
}

group BuildNoteBase(source qr : QR, target comp : Composition, target entry) {
  qr -> comp then SetResponseProvenance(qr, comp) "responseProvenance";
  qr -> comp.id = uuid() then SetCompositionFullUrl(comp, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Composition' "requestUrl";
  } "entryRequest";

  qr -> comp.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> comp.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> comp.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // Composition.date is 1..1. `authored` is only 0..1 on the response, so when a
  // client sends none the extraction time stands in.
  qr.authored as t -> comp.date = t "date";
  qr where (authored.exists().not()) then {
    qr -> comp.date = evaluate(qr, now()) "dateFromExtractionTime";
  } "dateFallback";

  // Composition.author is 1..1 minimum. The author is whoever recorded the
  // response; `source` only stands in when the client did not send an author.
  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
    a.reference as v -> ref.reference = v "reference";
    a.type as v -> ref.type = v "type";
    a.identifier as v -> ref.identifier = v "identifier";
    a.display as v -> ref.display = v "display";
  } "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "authorFromSource";
  } "authorFallback";

  qr -> comp.relatesTo as rel then {
    qr -> rel.type = 'derived-from' "relatesToType";
    qr -> rel.resourceReference = create('Reference') as ref then {
      qr.id as qid -> ref.reference = qid "relatesToRef";
    } "relatesToTarget";
  } "linkQuestionnaireResponse";
}

group AddSectionText(source it, target sec) {
  it.answer first as a then {
    a.value : string as v -> sec.text as narrative then {
      v -> narrative.status = 'generated' "narrativeStatus";
      v -> narrative.div = create('xhtml') as xhtml then {
        v -> xhtml.value = evaluate(v, '<div xmlns="http://www.w3.org/1999/xhtml"><p>' + $this.escape('html') + '</p></div>') "narrativeDiv";
      } "narrativeXhtml";
    } "sectionText";
  } "sectionAnswer";
}

group SetCompositionFullUrl(source comp : Composition, target entry) {
  comp.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Composition/',
    id
  ) "assignFullUrl";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'inpatient-admission-form' "provenanceCode";
      qr -> t.display = 'Inpatient admission form' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
