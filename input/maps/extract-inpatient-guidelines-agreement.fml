/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractInpatientGuidelinesAgreement"
/// name = "ExtractInpatientGuidelinesAgreement"
/// title = "Inpatient Guidelines and Bill Payment Agreement Extraction"
/// status = "active"
/// description = "The two halves of the form out as two records. The acknowledgement of the inpatient guidelines becomes a Consent, written only once the patient or guardian has signed, with who signed as the grantor and the signing date as its date; it permits when the guidelines were acknowledged and denies when the form was signed without acknowledging them. The bill payment undertaking becomes a DocumentReference indexing the signed form: the estimate, the SHA and insurance figures and the balance stay on the response, because an undertaking is read whole and a balance separated from the estimate it was computed from is not evidence of anything; it is final once signed, with the signer as a personal attester at the agreement date, and preliminary until then."
//
// GATE: (item.where(linkId = 'guidelines').item.where(linkId = 'guidelines.signed').answer.value = true) or (item.where(linkId = 'billPayment').item.where(linkId = 'billPayment.totalEstimate').answer.value.exists())
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Consent" alias Consent as target
uses "http://hl7.org/fhir/StructureDefinition/DocumentReference" alias DocumentReference as target

group ExtractInpatientGuidelinesAgreement(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The guidelines acknowledgement, as a Consent ─────────────────────────
  // Guarded on the patient or guardian having signed. Everything below hangs off
  // that signature, and a Consent built from a half-read form asserts an
  // acknowledgement that was never given.
  qr where (item.where(linkId = 'guidelines').item.where(linkId = 'guidelines.signed').answer.value = true) -> bundle.entry as entry, entry.resource = create('Consent') as consent then {
    qr -> consent, entry then BuildConsentBase(qr, consent, entry) "base";
    qr -> consent.status = 'active' "status";
    // Signed but not acknowledged is a refusal on record, not a missing Consent.
    qr where (item.where(linkId = 'guidelines').item.where(linkId = 'guidelines.acknowledged' and answer.value = true).exists()) -> consent.decision = 'permit' "decisionPermit";
    qr where ((item.where(linkId = 'guidelines').item.where(linkId = 'guidelines.acknowledged' and answer.value = true).exists()).not()) -> consent.decision = 'deny' "decisionDeny";
    qr -> consent.category as cat then {
      qr -> cat.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/document-type-codesystem' "sys";
        qr -> cg.code = 'inpatient-guidelines-agreement' "cd";
        qr -> cg.display = 'Inpatient guidelines and bill payment agreement' "dsp";
      } "coding";
    } "category";
    qr -> consent.provision as prov, prov.code as pc, pc.text = 'The patient or guardian has read and understood the hospital\'s guidelines for inpatients: admission and bed charges, caretakers and visiting, food from outside, enquiring about the bill, SHA details, payment channels and valuables.' "guidelinesProvision";

    qr.item as gg where (linkId = 'guidelines') then {
      // The signing date from the form, not qr.authored: a form signed on
      // admission and transcribed later is dated to the signing.
      gg.item as it where (linkId = 'guidelines.date' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : date as d -> consent.date = d "signedDate";
        } "answer";
      } "dateRule";

      // Who signed becomes the grantor: the patient themselves, or the guardian
      // by name when someone signed on their behalf. Their role (parent, spouse
      // and so on) stays on the response: a provision code says what the consent
      // covers, not who gave it.
      gg.item as it where (linkId = 'guidelines.signer' and answer.value.ofType(Coding).code = 'consenter-patient') then {
        qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> consent.grantor = create('Reference') as gr then {
          s.reference as v -> gr.reference = v "reference";
          s.type as v -> gr.type = v "type";
          s.identifier as v -> gr.identifier = v "identifier";
          s.display as v -> gr.display = v "display";
        } "grantorPatient";
      } "patientSignerRule";
      gg.item as it where (linkId = 'guidelines.signerName' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.grantor = create('Reference') as ref, ref.display = txt "grantorDisplay";
        } "answer";
      } "signerNameRule";
    } "guidelinesGroup";
  } "createConsent";

  // ── The bill payment undertaking, as a DocumentReference ─────────────────
  // The figures (estimate, SHA package, insurance cover, balance) and the
  // undertaking stay on the form response the DocumentReference points at; a
  // payment undertaking is read whole. Final once signed, preliminary until then.
  qr where (item.where(linkId = 'billPayment').item.where(linkId = 'billPayment.totalEstimate').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('DocumentReference') as doc then {
    qr -> doc, entry then BuildDocRefBase(qr, doc, entry) "base";
    qr -> doc.type as cc then {
      qr -> cc.coding as cg then {
        qr -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/document-type-codesystem' "sys";
        qr -> cg.code = 'inpatient-guidelines-agreement' "cd";
        qr -> cg.display = 'Inpatient guidelines and bill payment agreement' "dsp";
      } "coding";
      qr -> cc.text = 'Bill payment agreement' "codeText";
    } "code";
    qr -> doc.description = 'The patient\'s or guardian\'s undertaking to pay the difference between the final hospital bill and what SHA and any insurer cover. The estimated bill, the SHA package, the insurance cover, the balance payable and the signature are on the referenced form response, which is the agreement itself.' "description";
    qr where (item.where(linkId = 'billPayment').item.where(linkId = 'billPayment.signed').answer.value = true) -> doc.docStatus = 'final' "docStatusFinal";
    qr where (item.where(linkId = 'billPayment').item.where(linkId = 'billPayment.signed' and answer.value = true).exists().not()) -> doc.docStatus = 'preliminary' "docStatusPreliminary";

    // Once signed, the signer attests personally at the agreement date: the
    // patient as the response's subject, or the guardian as named on the
    // guidelines half of the form, which is where the form asks for the name.
    qr where (item.where(linkId = 'billPayment').item.where(linkId = 'billPayment.signed' and answer.value = true).exists()) -> doc.attester as att then {
      qr -> att.mode as md then {
        qr -> md.coding as cg then {
          qr -> cg.system = 'http://hl7.org/fhir/composition-attestation-mode' "sys";
          qr -> cg.code = 'personal' "cd";
          qr -> cg.display = 'Personal' "dsp";
        } "coding";
      } "mode";
      qr.item as bg where (linkId = 'billPayment') then {
        bg.item as di where (linkId = 'billPayment.date' and answer.value.exists()) then {
          di.answer first as a then {
            a.value : date as v -> att.time = v "time";
          } "dateAnswer";
        } "date";
      } "billPaymentGroup";
      qr.item as gg where (linkId = 'guidelines') then {
        gg where (item.where(linkId = 'guidelines.signer').answer.value.ofType(Coding).where(code = 'consenter-patient').exists()) then {
          qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> att.party = create('Reference') as ref then {
            s.reference as v -> ref.reference = v "reference";
            s.type as v -> ref.type = v "type";
            s.identifier as v -> ref.identifier = v "identifier";
            s.display as v -> ref.display = v "display";
          } "patientParty";
        } "patientSigner";
        gg where (item.where(linkId = 'guidelines.signer').answer.value.ofType(Coding).where(code = 'consenter-patient').exists().not()) then {
          gg.item as sn where (linkId = 'guidelines.signerName' and answer.value.exists()) then {
            sn.answer first as sa then {
              sa.value : string as nm -> att.party = create('Reference') as ref, ref.display = nm "namedParty";
            } "signerNameAnswer";
          } "signerName";
        } "otherSigner";
      } "guidelinesGroup";
    } "attester";
  } "billPaymentDocument";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildConsentBase(source qr : QR, target r : Consent, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr.id as qid where ($this.toString().length() > 0) -> r.sourceReference = create('Reference') as srcRef, srcRef.reference = qid "linkQuestionnaireResponse";
  qr -> r.id = uuid() then SetConsentFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Consent' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr -> r then ConformConsent(qr, r) "profileConformance";
}

group SetConsentFullUrl(source r : Consent, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Consent/', id) "assignFullUrl";
}

group ConformConsent(source qr : QR, target r) {
  qr.authored as t -> evaluate(t, $this.toString().substring(0, 10)) as day, r.date = cast(day, 'date') "date";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.grantee = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "granteeFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.grantee = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "granteeFromSource";
  } "granteeFallback";
}

group BuildDocRefBase(source qr : QR, target r : DocumentReference, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetDocRefFullUrl(r, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'DocumentReference' "requestUrl";
  } "entryRequest";

  qr -> r.status = 'current' "status";
  // DocumentReference.date is an instant, so only a full timestamp can stand
  // in it; a response authored to the day leaves it unset.
  qr.authored as t where ($this.toString().length() >= 20) -> r.date = cast(t, 'instant') "date";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.context = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "context";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.author = create('Reference') as ref then {
    a.reference as v -> ref.reference = v "reference";
    a.type as v -> ref.type = v "type";
    a.identifier as v -> ref.identifier = v "identifier";
    a.display as v -> ref.display = v "display";
  } "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.author = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "authorFromSource";
  } "authorFallback";

  // The content IS the stored response: the attachment points at it rather
  // than copying it. A stored response's id already reads
  // "QuestionnaireResponse/<id>", so it is a relative URL as it stands; the
  // length guard stops an unsaved response from writing a null link.
  qr.id as qid where ($this.toString().length() > 0) -> r.content as content, content.attachment as att then {
    qid -> att.url = qid "attachmentUrl";
    qid -> att.contentType = 'application/fhir+json' "attachmentContentType";
    qr.authored as t -> att.creation = t "attachmentCreation";
  } "content";
}

group SetDocRefFullUrl(source r : DocumentReference, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/DocumentReference/', id) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'inpatient-guidelines-agreement' "provenanceCode";
      qr -> t.display = 'Inpatient guidelines and bill payment agreement' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
