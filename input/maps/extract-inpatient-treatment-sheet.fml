/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractInpatientTreatmentSheet"
/// name = "ExtractInpatientTreatmentSheet"
/// title = "Inpatient Treatment Sheet Extraction"
/// status = "active"
/// description = "The treatment sheet out as one MedicationRequest per order the doctor has signed, with the drug as written, the dose, route, frequency, duration and rate in one dosage instruction, the sheet section as a category and an antimicrobial order\'s indication as the reason; and one MedicationAdministration per nursing record row, completed when given and not-done with the coded reason when not, at the time recorded and by the nurse named. Unsigned orders are not prescriptions and produce nothing. The pharmacy dispensing entries stay on the form. Administrations name the drug rather than pointing at the request, because the orchestrator does not yet carry links between resources created in the same extraction."
//
// GATE: item.where(linkId = 'order').where(item.where(linkId = 'order.prescriberSigned').answer.value = true).exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/MedicationRequest" alias MedicationRequest as target
uses "http://hl7.org/fhir/StructureDefinition/MedicationAdministration" alias MedicationAdministration as target

group ExtractInpatientTreatmentSheet(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── One MedicationRequest per signed order ────────────────────────────────
  // Each order row becomes a MedicationRequest once the prescriber has signed it:
  // an unsigned order is not a prescription. The drug travels as written in
  // medication.concept.text -- the sheet is free text and a guessed drug code on a
  // treatment sheet is a patient-safety risk, not a data-quality nicety. Dose,
  // route, frequency, duration and rate go into one dosage instruction; the
  // section (stat, fluid, antimicrobial, narcotic, general, PRN) is a category,
  // and an antimicrobial order carries its indication as the reason.
  qr.item as g where (linkId = 'order' and item.where(linkId = 'order.prescriberSigned').answer.value = true and item.where(linkId = 'order.drug').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('MedicationRequest') as mr then {
    qr -> mr, entry then BuildMedicationRequestBase(qr, mr, entry) "base";
    g -> mr.status = 'active' "status";
    g.item as it where (linkId = 'order.drug') then {
      it.answer first as a then {
        a.value : string as txt -> mr.medication as med, med.concept as mc, mc.text = txt "medicationText";
      } "answer";
    } "drugRule";
    g.item as it where (linkId = 'order.section' and answer.value.exists()) then {
      it.answer first as a then {
        a.value : Coding as cv -> mr.category as cat then {
          cv -> cat.coding = cv "sectionCoding";
          cv.display as d -> cat.text = d "sectionText";
        } "sectionCategory";
      } "answer";
    } "sectionRule";
    g.item as it where (linkId = 'order.section' and answer.value.ofType(Coding).code = 'order-section-stat') -> mr.priority = 'stat' "statPriority";
    g.item as it where (linkId = 'order.section' and answer.value.ofType(Coding).code = 'order-section-prn') -> mr.dosageInstruction as dos, dos.asNeeded = true "prnAsNeeded";
    g -> mr.dosageInstruction as dos then {
      g.item as it where (linkId = 'order.dose' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> dos.text = txt "doseText";
        } "answer";
      } "doseRule";
      g.item as it where (linkId = 'order.route' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : Coding as cv -> dos.route as rt then {
            cv -> rt.coding = cv "routeCoding";
            cv.display as d -> rt.text = d "routeText";
          } "route";
        } "answer";
      } "routeRule";
      g.item as it where (linkId = 'order.frequency' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> dos.timing as tm, tm.code as tc, tc.text = txt "frequencyText";
        } "answer";
      } "frequencyRule";
      g.item as it where (linkId = 'order.duration' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> dos.additionalInstruction as ai, ai.text = append('Duration: ', txt) "durationText";
        } "answer";
      } "durationRule";
      g.item as it where (linkId = 'order.rateOfAdministration' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> dos.additionalInstruction as ai, ai.text = append('Rate of administration: ', txt) "rateText";
        } "answer";
      } "rateRule";
      g.item as it where (linkId = 'order.specialInstructions' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> dos.patientInstruction = txt "specialInstructions";
        } "answer";
      } "specialInstructionsRule";
    } "dosageInstruction";
    g.item as it where (linkId = 'order.antimicrobialIndication' and answer.value.exists()) then {
      it.answer first as a then {
        a.value : Coding as cv -> mr.reason as rs, rs.concept as rc then {
          cv -> rc.coding = cv "indicationCoding";
          cv.display as d -> rc.text = d "indicationText";
        } "reason";
      } "answer";
    } "indicationRule";
    g.item as it where (linkId = 'order.prescribedAt' and answer.value.exists()) then {
      it.answer first as a then {
        a.value : dateTime as t -> mr.authoredOn = t "authoredOn";
      } "answer";
    } "prescribedAtRule";
    g.item as pf where (linkId = 'order.prescriber' and answer.value.exists()) then {
      pf.answer first as pa then {
        pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> mr.requester = create('Reference') as actor then {
          ref.reference as v -> actor.reference = v "reference";
          ref.type as v -> actor.type = v "type";
          ref.identifier as v -> actor.identifier = v "identifier";
          ref.display as v -> actor.display = v "display";
        } "performer";
      } "performerAnswer";
    } "performer_1";

    // ── Each administration against the order ─────────────────────────────
    // A MedicationAdministration per nursing record row: completed when given,
    // not-done with the coded reason when not. It names the drug itself rather
    // than pointing at the request, because the orchestrator does not yet carry
    // links between resources created in the same extraction.
    g.item as ar where (linkId = 'order.administration' and item.where(linkId = 'order.administration.given').answer.value.exists()) -> bundle.entry as entryA, entryA.resource = create('MedicationAdministration') as ma then {
      qr -> ma, entryA then BuildMedicationAdministrationBase(qr, ma, entryA) "base";
      g.item as dn where (linkId = 'order.drug') then {
        dn.answer first as da then {
          da.value : string as txt -> ma.medication as med, med.concept as mc, mc.text = txt "medicationText";
        } "answer";
      } "drugNameRule";
      g.item as sc where (linkId = 'order.section' and answer.value.exists()) then {
        sc.answer first as sa then {
          sa.value : Coding as cv -> ma.category as cat then {
            cv -> cat.coding = cv "sectionCoding";
            cv.display as d -> cat.text = d "sectionText";
          } "sectionCategory";
        } "answer";
      } "sectionRule";
      g.item as rt where (linkId = 'order.route' and answer.value.exists()) then {
        rt.answer first as ra then {
          ra.value : Coding as cv -> ma.dosage as dos, dos.route as rtc then {
            cv -> rtc.coding = cv "routeCoding";
            cv.display as d -> rtc.text = d "routeText";
          } "route";
        } "answer";
      } "routeRule";
      ar.item as it where (linkId = 'order.administration.given' and answer.value = true) -> ma.status = 'completed' "givenStatus";
      ar.item as it where (linkId = 'order.administration.given' and answer.value = false) -> ma.status = 'not-done' "notGivenStatus";
      ar.item as it where (linkId = 'order.administration.dateTime' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : dateTime as t -> ma.occurence = t "occurrence";
        } "answer";
      } "timeRule";
      ar.item as it where (linkId = 'order.administration.doseGiven' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> ma.dosage as dos, dos.text = txt "doseGivenText";
        } "answer";
      } "doseGivenRule";
      ar.item as it where (linkId = 'order.administration.notGivenReason' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : Coding as cv -> ma.statusReason as sr then {
            cv -> sr.coding = cv "reasonCoding";
            cv.display as d -> sr.text = d "reasonText";
          } "statusReason";
        } "answer";
      } "notGivenReasonRule";
      ar.item as it where (linkId = 'order.administration.notGivenNote' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> ma.note as n, n.text = txt "notGivenNote";
        } "answer";
      } "notGivenNoteRule";
      ar.item as pf where (linkId = 'order.administration.givenBy' and answer.value.exists()) then {
        pf.answer first as pa then {
          pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ma.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as actor then {
            ref.reference as v -> actor.reference = v "reference";
            ref.type as v -> actor.type = v "type";
            ref.identifier as v -> actor.identifier = v "identifier";
            ref.display as v -> actor.display = v "display";
          } "performer";
        } "performerAnswer";
      } "performer_2";
    } "administration";
  } "medicationOrder";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

// A MedicationRequest from one order on the sheet. The sheet's own prescriber
// and time override the response's author and authored, which stand in only when
// the row did not name them; the request is never minted a Medication resource,
// the drug travels as written in medication.concept.text.
group BuildMedicationRequestBase(source qr : QR, target r : MedicationRequest, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetMedicationRequestFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'MedicationRequest' "requestUrl";
  } "entryRequest";
  qr -> r.intent = 'order' "intent";
  qr -> r.priority = 'routine' "priority";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> r.authoredOn = t "authoredOnFallback";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.requester = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "requesterFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> r.requester = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "requesterFromSource";
  } "requesterFallback";
  qr.id as qid where ($this.toString().length() > 0) -> r.supportingInformation = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetMedicationRequestFullUrl(source r : MedicationRequest, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/MedicationRequest/', id) "assignFullUrl";
}

group BuildMedicationAdministrationBase(source qr : QR, target r : MedicationAdministration, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetMedicationAdministrationFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'MedicationAdministration' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";

  // The response's own time, as a floor. A row that names the time it was given
  // overwrites this; a form whose time column was taken off on review would
  // otherwise produce an administration with no time at all, which is not a
  // record of an administration. Same fallback BuildObsBase already applies.
  qr.authored as t -> r.occurence = t "occurrenceFallback";
  qr -> r then ConformMedicationAdministration(qr, r) "profileConformance";
}

group SetMedicationAdministrationFullUrl(source r : MedicationAdministration, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/MedicationAdministration/', id) "assignFullUrl";
}

group ConformMedicationAdministration(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))) -> r.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))) -> r.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'inpatient-treatment-sheet' "provenanceCode";
      qr -> t.display = 'Inpatient treatment sheet' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
