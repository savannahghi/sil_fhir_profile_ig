/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractLabourAndDeliveryRecord"
/// name = "ExtractLabourAndDeliveryRecord"
/// title = "Labour and Delivery Record Extraction"
/// status = "active"
/// description = "The labour and delivery record out, once the midwife or doctor has signed it, as: the timed labour notes as a Composition; each stage event (labour began, membranes ruptured, fully dilated, baby born, placenta expelled) as an Observation at the time it happened; the blood loss; a MedicationAdministration per drug given; the perineum as an examination finding with its suture and who sutured; the delivery as an obstetric Procedure coded by its mode and performed by the doctor, midwife or pupil named; the stage durations and the total the form calculates; and the mother\'s and the baby\'s condition after delivery as Observations. The baby\'s facts go onto the mother\'s record with a note saying so -- no Patient is minted for the newborn; its own chart is the authoritative record."
//
// GATE: item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value = true
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/MedicationAdministration" alias MedicationAdministration as target
uses "http://hl7.org/fhir/StructureDefinition/Procedure" alias Procedure as target

group ExtractLabourAndDeliveryRecord(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // Everything is guarded on the sign-off: the record is written through a
  // labour and closed when the midwife or doctor confirms it, and a half-written
  // labour must not read as a delivery.
  qr where (item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value = true) then {
    // ── The labour notes, as a Composition ─────────────────────────────────
    qr where (item.where(linkId = 'note').item.where(linkId = 'note.notes').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Composition') as comp then {
      qr -> comp, entry then BuildNoteBase(qr, comp, entry) "noteBase";
      qr -> comp.name = 'LabourNotes' "noteName";
      qr -> comp.title = 'Labour notes' "noteTitle";
      qr -> comp.type as ty then {
        qr -> ty.coding as sghi then {
          qr -> sghi.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/document-type-codesystem' "sghiSystem";
          qr -> sghi.code = 'labour-and-delivery-record' "sghiCode";
          qr -> sghi.display = 'Labour and delivery record' "sghiDisplay";
        } "sghiCoding";
        qr -> ty.coding as loinc then {
          qr -> loinc.system = 'http://loinc.org' "loincSystem";
          qr -> loinc.code = '11506-3' "loincCode";
          qr -> loinc.display = 'Progress note' "loincDisplay";
        } "loincCoding";
        qr -> ty.text = 'Labour notes' "typeText";
      } "noteType";
      qr.item as eg where (linkId = 'note' and item.where(linkId = 'note.notes').answer.value.exists()) -> comp.section as sec then {
        eg.item as tt where (linkId = 'note.dateTime' and answer.value.exists()) then {
          tt.answer first as ta then {
            ta.value : dateTime as t -> sec.title = evaluate(ta, 'Labour note at ' + value.toString()) "titleWithTime";
          } "titleAnswer";
        } "entryTimeRule";
        eg where (item.where(linkId = 'note.dateTime').answer.value.exists().not()) -> sec.title = 'Labour note' "titlePlain";
        eg.item as it where (linkId = 'note.notes') then {
          it -> sec then AddSectionText(it, sec) "entryText";
        } "entryNotesRule";
      } "entryRule";
    } "labourNotes";

    // ── The stages, each at the time it happened ───────────────────────────
    // Each stage event is an Observation that says it happened, with the time
    // as its effective, the way the labour care guide map records the birth.
    qr.item as g where (linkId = 'stages') then {
      g.item as it where (linkId = 'stages.began' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'labour-began' "cd";
            it -> cg.display = 'Labour began' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        it.answer first as a then {
          a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
        } "answer";
      } "obs_labour_began_3";
      g.item as it where (linkId = 'stages.membranesRuptured' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '56829-5' "cd";
            it -> cg.display = 'Ruptured membranes' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
        } "answer";
      } "obs_56829_5_4";
      g.item as it where (linkId = 'stages.fullyDilated' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'labour-fully-dilated' "cd";
            it -> cg.display = 'Fully dilated' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        it.answer first as a then {
          a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
        } "answer";
      } "obs_labour_fully_dilated_5";
      g.item as it where (linkId = 'stages.babyBorn' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-birth' "cd";
            it -> cg.display = 'Birth' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        it.answer first as a then {
          a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
        } "answer";
      } "obs_lcg_birth_6";
      g.item as it where (linkId = 'stages.placentaExpelled' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'labour-placenta-expelled' "cd";
            it -> cg.display = 'Placenta expelled' "dsp";
          } "coding";
        } "code";
        it -> obs.value = true "happened";
        it.answer first as a then {
          a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
        } "answer";
      } "obs_labour_placenta_expelled_7";
      g.item as it where (linkId = 'stages.bloodLoss' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8717-1' "cd";
            it -> cg.display = 'Surgical operation note estimated blood loss [Volume]' "dsp";
          } "coding";
          it -> cc.text = 'Amount of blood loss' "codeText";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_8717_1_8";
    } "stagesGroup";

    // ── Drugs given during labour ──────────────────────────────────────────
    qr.item as dr where (linkId = 'drug') then {
      // One MedicationAdministration per drug row, the drug as written.
      dr where (item.where(linkId = 'drug.drug').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('MedicationAdministration') as ma then {
        qr -> ma, entry then BuildMedicationAdministrationBase(qr, ma, entry) "base";
        dr -> ma.status = 'completed' "status";
        dr.item as it where (linkId = 'drug.drug') then {
          it.answer first as a then {
            a.value : string as txt -> ma.medication as med, med.concept as mc, mc.text = txt "medicationText";
          } "answer";
        } "drugRule";
        dr.item as it where (linkId = 'drug.dose' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : string as txt -> ma.dosage as dos, dos.text = txt "dosageText";
          } "answer";
        } "doseRule";
        dr.item as it where (linkId = 'drug.dateTime' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : dateTime as t -> ma.occurence = t "occurrence";
          } "answer";
        } "timeRule";
        dr.item as it where (linkId = 'drug.remarks' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : string as txt -> ma.note as n, n.text = txt "remarks";
          } "answer";
        } "remarksRule";
        dr.item as pf where (linkId = 'drug.givenBy' and answer.value.exists()) then {
          pf.answer first as pa then {
            pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ma.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "performer";
          } "performerAnswer";
        } "performer_9";
      } "medadmin_10";
    } "drugGroup";

    // ── Perineum ───────────────────────────────────────────────────────────
    qr.item as g where (linkId = 'perineum') then {
      g.item as it where (linkId = 'perineum.condition' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'perineal-outcome' "cd";
            it -> cg.display = 'Perineal outcome' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        g.item as nt where (linkId = 'perineum.suture' and answer.value.exists()) then {
          nt.answer first as na then {
            na.value : string as txt -> obs.note as n, n.text = append('Suture: ', txt) "noteText";
          } "noteAnswer";
        } "note_11";
        g.item as pf where (linkId = 'perineum.suturedBy' and answer.value.exists()) then {
          pf.answer first as pa then {
            pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> obs.performer = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "performer";
          } "performerAnswer";
        } "performer_12";
      } "obs_perineal_outcome_13";
    } "perineumGroup";

    // ── The delivery ───────────────────────────────────────────────────────
    qr.item as g where (linkId = 'delivery') then {
      qr.item as st where (linkId = 'stages') then {
        // ── The delivery, as a Procedure ────────────────────────────────────────
        // An obstetric procedure coded by its mode, one rule per mode, mutually
        // exclusive on the answer; every code checked on tx.fhir.org. Breech has no
        // SNOMED concept that does not also say which breech or how it was delivered,
        // so it gets the parent 236973005 Delivery procedure with the mode as text.
        g where (item.where(linkId = 'delivery.type').answer.value.exists() or item.where(linkId = 'stages.babyBorn').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Procedure') as proc then {
          qr -> proc, entry then BuildProcedureBase(qr, proc, entry) "base";
          g -> proc.status = 'completed' "status";
          g -> proc.category as pcat then {
            g -> pcat.coding as cg then {
              g -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/identifier-codesystem' "sys";
              g -> cg.code = '386637004' "cd";
              g -> cg.display = 'Obstetric procedure' "dsp";
            } "coding";
          } "category";
          st.item as dt where (linkId = 'stages.babyBorn' and answer.value.exists()) then {
            dt.answer first as a then {
              a.value : dateTime as t -> proc.occurrence = t "occurrence";
            } "answer";
          } "deliveryTimeRule";
          g.item as md where (linkId = 'delivery.type' and answer.value.ofType(Coding).code = 'delivery-caesarean') -> proc.code as cc then {
            md -> cc.coding as cg then {
              md -> cg.system = 'http://snomed.info/sct' "sys";
              md -> cg.code = '11466000' "cd";
              md -> cg.display = 'Cesarean section' "dsp";
            } "coding";
            md -> cc.text = 'Caesarean section' "modeText";
          } "caesareanCode";
          g.item as md where (linkId = 'delivery.type' and answer.value.ofType(Coding).code != 'delivery-caesarean') -> proc.code as cc then {
            md where (answer.value.ofType(Coding).code = 'delivery-svd') -> cc.coding as cg then {
              md -> cg.system = 'http://snomed.info/sct' "sys";
              md -> cg.code = '177184002' "cd";
              md -> cg.display = 'Normal delivery procedure' "dsp";
            } "svdCoding";
            md where (answer.value.ofType(Coding).code = 'delivery-assisted-vacuum') -> cc.coding as cg then {
              md -> cg.system = 'http://snomed.info/sct' "sys";
              md -> cg.code = '61586001' "cd";
              md -> cg.display = 'Delivery by vacuum extraction' "dsp";
            } "vacuumCoding";
            md where (answer.value.ofType(Coding).code = 'delivery-assisted-forceps') -> cc.coding as cg then {
              md -> cg.system = 'http://snomed.info/sct' "sys";
              md -> cg.code = '302383004' "cd";
              md -> cg.display = 'Forceps delivery' "dsp";
            } "forcepsCoding";
            md where (answer.value.ofType(Coding).where(code = 'delivery-svd' or code = 'delivery-assisted-vacuum' or code = 'delivery-assisted-forceps').empty()) -> cc.coding as cg then {
              md -> cg.system = 'http://snomed.info/sct' "sys";
              md -> cg.code = '236973005' "cd";
              md -> cg.display = 'Delivery procedure' "dsp";
            } "otherModeCoding";
            md.answer first as a then {
              a.value : Coding as cv then {
                cv.display as d -> cc.text = d "modeText";
              } "display";
            } "modeDisplay";
          } "vaginalCode";
          g where (item.where(linkId = 'delivery.type').answer.value.exists().not()) -> proc.code as cc then {
            g -> cc.coding as cg then {
              g -> cg.system = 'http://snomed.info/sct' "sys";
              g -> cg.code = '236973005' "cd";
              g -> cg.display = 'Delivery procedure' "dsp";
            } "coding";
          } "unspecifiedModeCode";


          g.item as by where (linkId = 'delivery.by') then {
            by.item as pf where (linkId = 'delivery.by.doctor' and answer.value.exists()) then {
              pf.answer first as pa then {
                pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> proc.performer as p then {
                  ref -> p.actor = create('Reference') as actor then {
                    ref.reference as v -> actor.reference = v "reference";
                    ref.type as v -> actor.type = v "type";
                    ref.identifier as v -> actor.identifier = v "identifier";
                    ref.display as v -> actor.display = v "display";
                  } "actor";
                  ref -> p.function as fn, fn.text = 'Doctor' "function";
                } "performer";
              } "performerAnswer";
            } "performer_1";
            by.item as pf where (linkId = 'delivery.by.midwife' and answer.value.exists()) then {
              pf.answer first as pa then {
                pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> proc.performer as p then {
                  ref -> p.actor = create('Reference') as actor then {
                    ref.reference as v -> actor.reference = v "reference";
                    ref.type as v -> actor.type = v "type";
                    ref.identifier as v -> actor.identifier = v "identifier";
                    ref.display as v -> actor.display = v "display";
                  } "actor";
                  ref -> p.function as fn, fn.text = 'Midwife' "function";
                } "performer";
              } "performerAnswer";
            } "performer_2";
            by.item as it where (linkId = 'delivery.by.pupil' and answer.value.exists()) then {
              it.answer first as a then {
                a.value : string as name -> proc.performer as p then {
                  name -> p.actor = create('Reference') as r, r.display = name "actor";
                  name -> p.function as fn, fn.text = 'Pupil' "function";
                } "performer";
              } "answer";
            } "pupilRule";
          } "deliveredByGroup";
        } "deliveryProcedure";
      } "stagesForDelivery";
      g.item as du where (linkId = 'delivery.duration') then {
        du.item as it where (linkId = 'delivery.duration.first' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'obs-duration-of-the-first-stage-of-labour' "cd";
              it -> cg.display = 'Duration of the first stage of labour' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_obs_duration_of_the_first_stage_of_labour_14";
        du.item as it where (linkId = 'delivery.duration.second' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'obs-duration-of-the-second-stage-of-labour' "cd";
              it -> cg.display = 'Duration of the second stage of labour' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_obs_duration_of_the_second_stage_of_labour_15";
        du.item as it where (linkId = 'delivery.duration.third' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'obs-duration-of-the-third-stage-of-labour' "cd";
              it -> cg.display = 'Duration of the third stage of labour' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_obs_duration_of_the_third_stage_of_labour_16";
        // The total the form calculates from the three stages, in minutes.
        du.item as it where (linkId = 'delivery.duration.total' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'obs-duration-of-labour' "cd";
              it -> cg.display = 'Duration of labour' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : decimal as v -> obs.value = create('Quantity') as qty then {
              v -> qty.value = v "qtyValue";
              v -> qty.unit = 'min' "qtyUnit";
              v -> qty.system = 'http://unitsofmeasure.org' "qtySystem";
              v -> qty.code = 'min' "qtyCode";
            } "quantity";
          } "answer";
        } "obs_obs_duration_of_labour_17";
      } "durationGroup";
    } "deliveryGroup";

    // ── After delivery: the mother ─────────────────────────────────────────
    qr.item as ag where (linkId = 'after') then {
      ag.item as g where (linkId = 'after.mother') then {
        g.item as it where (linkId = 'after.mother.condition' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetExamCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'postnatal-condition-of-mother' "cd";
              it -> cg.display = 'Condition of the mother after delivery' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as txt -> obs.note as n, n.text = txt "text";
          } "answer";
        } "obs_postnatal_condition_of_mother_18";
        g.item as it where (linkId = 'after.mother.temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '8310-5' "cd";
              it -> cg.display = 'Body temperature' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_8310_5_19";
        g.item as it where (linkId = 'after.mother.pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '8867-4' "cd";
              it -> cg.display = 'Heart rate' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_8867_4_20";
        g.item as it where (linkId = 'after.mother.respiratoryRate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '9279-1' "cd";
              it -> cg.display = 'Respiratory rate' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_9279_1_21";
        g.item as bp where (linkId = 'after.mother.bloodPressure') then {
          bp where ((item.where(linkId = 'after.mother.bloodPressure.systolic').answer.value.ofType(Quantity).exists() or item.where(linkId = 'after.mother.bloodPressure.diastolic').answer.value.ofType(Quantity).exists())) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
            qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
            qr -> obs then SetVitalSignsCategory(qr, obs) "category";
            bp -> obs.code as cc then {
              bp -> cc.coding as cg then {
                bp -> cg.system = 'http://loinc.org' "sys";
                bp -> cg.code = '85354-9' "cd";
                bp -> cg.display = 'Blood pressure panel with all children optional' "dsp";
              } "coding";
            } "code";
            bp.item as ci where (linkId = 'after.mother.bloodPressure.systolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
              ci -> comp.code as cc then {
                ci -> cc.coding as cg then {
                  ci -> cg.system = 'http://loinc.org' "sys";
                  ci -> cg.code = '8480-6' "cd";
                  ci -> cg.display = 'Systolic blood pressure' "dsp";
                } "coding";
              } "code";
              ci.answer first as a then {
                a.value : Quantity as v -> comp.value = v "value";
              } "answer";
            } "comp_8480_6_22";
            bp.item as ci where (linkId = 'after.mother.bloodPressure.diastolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
              ci -> comp.code as cc then {
                ci -> cc.coding as cg then {
                  ci -> cg.system = 'http://loinc.org' "sys";
                  ci -> cg.code = '8462-4' "cd";
                  ci -> cg.display = 'Diastolic blood pressure' "dsp";
                } "coding";
              } "code";
              ci.answer first as a then {
                a.value : Quantity as v -> comp.value = v "value";
              } "answer";
            } "comp_8462_4_23";
          } "panel_85354_9_24";
        } "bloodPressureGroup";
        g.item as it where (linkId = 'after.mother.fundus' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetExamCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'postnatal-fundus' "cd";
              it -> cg.display = 'Fundus after delivery' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as v -> obs.value = v "value";
          } "answer";
        } "obs_postnatal_fundus_25";
        g.item as it where (linkId = 'after.mother.pvLoss' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetExamCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'postnatal-pv-loss' "cd";
              it -> cg.display = 'Per vaginam loss after delivery' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as v -> obs.value = v "value";
          } "answer";
        } "obs_postnatal_pv_loss_26";
        g.item as it where (linkId = 'after.mother.weight' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '29463-7' "cd";
              it -> cg.display = 'Body weight' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
        } "obs_29463_7_27";
      } "motherGroup";

      // ── After delivery: the baby ─────────────────────────────────────────
      // These belong to the baby, not the mother, but the sheet records them
      // here and the response's subject is the mother, so they go onto the
      // mother's record with a note saying so; the newborn's own chart is the
      // authoritative record. No Patient is minted for the baby.
      ag.item as g where (linkId = 'after.baby') then {
        g.item as it where (linkId = 'after.baby.condition' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetExamCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'postnatal-condition-of-baby' "cd";
              it -> cg.display = 'Condition of the baby after delivery' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as txt -> obs.note as n, n.text = txt "text";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_postnatal_condition_of_baby_28";
        g.item as it where (linkId = 'after.baby.sex' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '76689-9' "cd";
              it -> cg.display = 'Sex assigned at birth' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
              cv -> vc.coding = cv "valueCoding";
              cv.display as d -> vc.text = d "valueText";
            } "codedValue";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_76689_9_29";
        g.item as it where (linkId = 'after.baby.weight' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '8339-4' "cd";
              it -> cg.display = 'Birth weight Measured' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : Quantity as v -> obs.value = v "value";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_8339_4_30";
        g.item as it where (linkId = 'after.baby.abnormalities' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetExamCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'newborn-care-obvious-malformation' "cd";
              it -> cg.display = 'Obvious malformation' "dsp";
            } "coding";
            it -> cc.text = 'Abnormalities' "codeText";
          } "code";
          it.answer first as a then {
            a.value : string as txt -> obs.note as n, n.text = txt "text";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_newborn_care_obvious_malformation_31";
        g.item as it where (linkId = 'after.baby.remarks' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetSurveyCategory(qr, obs) "category";
          it -> obs.code as cc then {
            it -> cc.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
              it -> cg.code = 'postnatal-remarks-on-baby' "cd";
              it -> cg.display = 'Remarks on the baby after delivery' "dsp";
            } "coding";
          } "code";
          it.answer first as a then {
            a.value : string as txt -> obs.note as n, n.text = txt "text";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_postnatal_remarks_on_baby_32";
      } "babyGroup";
    } "afterGroup";
  } "signedRecord";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildNoteBase(source qr : QR, target comp : Composition, target entry) {
  qr -> comp then SetResponseProvenance(qr, comp) "responseProvenance";
  qr -> comp.id = uuid() then SetCompositionFullUrl(comp, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Composition' "requestUrl";
  } "entryRequest";

  qr -> comp.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> comp.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> comp.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // Composition.date is 1..1. `authored` is only 0..1 on the response, so when a
  // client sends none the extraction time stands in.
  qr.authored as t -> comp.date = t "date";
  qr where (authored.exists().not()) then {
    qr -> comp.date = evaluate(qr, now()) "dateFromExtractionTime";
  } "dateFallback";

  // Composition.author is 1..1 minimum. The author is whoever recorded the
  // response; `source` only stands in when the client did not send an author.
  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
    a.reference as v -> ref.reference = v "reference";
    a.type as v -> ref.type = v "type";
    a.identifier as v -> ref.identifier = v "identifier";
    a.display as v -> ref.display = v "display";
  } "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "authorFromSource";
  } "authorFallback";

  qr -> comp.relatesTo as rel then {
    qr -> rel.type = 'derived-from' "relatesToType";
    qr -> rel.resourceReference = create('Reference') as ref then {
      qr.id as qid -> ref.reference = qid "relatesToRef";
    } "relatesToTarget";
  } "linkQuestionnaireResponse";
}

group AddSectionText(source it, target sec) {
  it.answer first as a then {
    a.value : string as v -> sec.text as narrative then {
      v -> narrative.status = 'generated' "narrativeStatus";
      v -> narrative.div = create('xhtml') as xhtml then {
        v -> xhtml.value = evaluate(v, '<div xmlns="http://www.w3.org/1999/xhtml"><p>' + $this.escape('html') + '</p></div>') "narrativeDiv";
      } "narrativeXhtml";
    } "sectionText";
  } "sectionAnswer";
}

group SetCompositionFullUrl(source comp : Composition, target entry) {
  comp.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Composition/',
    id
  ) "assignFullUrl";
}

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  // The response's subject is Reference(Any); the guard keeps Patients and the
  // copy, field by field, is what satisfies a type checker that cannot see the
  // guard. Same for the encounter.
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The length guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.toString().length() > 0) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value : Coding as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

group BuildMedicationAdministrationBase(source qr : QR, target r : MedicationAdministration, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetMedicationAdministrationFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'MedicationAdministration' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";

  // The response's own time, as a floor. A row that names the time it was given
  // overwrites this; a form whose time column was taken off on review would
  // otherwise produce an administration with no time at all, which is not a
  // record of an administration. Same fallback BuildObsBase already applies.
  qr.authored as t -> r.occurence = t "occurrenceFallback";
  qr -> r then ConformMedicationAdministration(qr, r) "profileConformance";
}

group SetMedicationAdministrationFullUrl(source r : MedicationAdministration, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/MedicationAdministration/', id) "assignFullUrl";
}

group ConformMedicationAdministration(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))) -> r.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Patient/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Device/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Device'))))) -> r.performer as p, p.actor = create('CodeableReference') as cr, cr.reference = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

group BuildProcedureBase(source qr : QR, target r : Procedure, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetProcedureFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Procedure' "requestUrl";
  } "entryRequest";

  // The response's own time, as a floor, the way BuildObsBase does it. A rule
  // that reads a time off the form overwrites this; without it a procedure whose
  // date column was taken off on review has no time at all, and a procedure with
  // no time cannot be ordered against the rest of the admission.
  qr.authored as t -> r.occurrence = t "occurrenceFallback";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr -> r then ConformProcedure(qr, r) "profileConformance";
}

group SetProcedureFullUrl(source r : Procedure, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Procedure/', id) "assignFullUrl";
}

group ConformProcedure(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> r.recorded = t "recorded";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.recorder = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "recorderFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.recorder = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "recorderFromSource";
  } "recorderFallback";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetExamCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'exam' "categoryCode";
      qr -> coding.display = 'Exam' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'labour-and-delivery-record' "provenanceCode";
      qr -> t.display = 'Labour and delivery record' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
