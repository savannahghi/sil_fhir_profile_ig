/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractLabourCareGuide"
/// name = "ExtractLabourCareGuide"
/// title = "Labour Care Guide Extraction"
/// status = "active"
/// description = "One Observation per answer, coded like the labour-care-guide flowsheet row it is charted on. Labour details come out once, the diagnosis of active labour and the birth at the time they happened (the first is what opens the chart); every assessment comes out at its own time. The fetal heart rate carries the guide's alert as its interpretation, and the woman's vital signs are categorised as vital signs."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractLabourCareGuide(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Labour details, once ──────────────────────────────────────────────
  qr.item as g where (linkId = 'labour-details') then {
    g.item as it where (linkId = 'labour-details/parity' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11977-6' "cd";
          it -> cg.display = 'Parity' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
    } "labour_details_parity";

    g.item as it where (linkId = 'labour-details/labour-onset' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-labour-onset' "cd";
          it -> cg.display = 'Labour onset' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "labour_details_labour_onset";

    g.item as it where (linkId = 'labour-details/active-labour' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-active-labour' "cd";
          it -> cg.display = 'Active labour diagnosis' "dsp";
        } "coding";
      } "code";
      it -> obs.value = true "happened";
      it.answer first as a then {
        a.value as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
      } "answer";
    } "labour_details_active_labour";

    g.item as it where (linkId = 'labour-details/membranes-ruptured' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '56829-5' "cd";
          it -> cg.display = 'Ruptured membranes' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = cast(v, 'dateTime') "value";
      } "answer";
    } "labour_details_membranes_ruptured";

    g.item as it where (linkId = 'labour-details/risk-factors' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-risk-factors' "cd";
          it -> cg.display = 'Risk factors' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
    } "labour_details_risk_factors";

    g.item as it where (linkId = 'labour-details/birth' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-birth' "cd";
          it -> cg.display = 'Birth' "dsp";
        } "coding";
      } "code";
      it -> obs.value = true "happened";
      it.answer first as a then {
        a.value as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
      } "answer";
    } "labour_details_birth";

  } "labourDetails";

  // ── Each assessment, charted at its own time ───────────────────────────
  qr.item as row where (linkId = 'assessment') then {
    // Supportive care
    row.item as it where (linkId = 'assessment/companion' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-companion' "cd";
          it -> cg.display = 'Companion' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_companion";

    row.item as it where (linkId = 'assessment/pain-relief' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-pain-relief' "cd";
          it -> cg.display = 'Pain relief' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_pain_relief";

    row.item as it where (linkId = 'assessment/oral-fluid' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-oral-fluid' "cd";
          it -> cg.display = 'Oral fluid' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_oral_fluid";

    row.item as it where (linkId = 'assessment/posture' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-posture' "cd";
          it -> cg.display = 'Posture' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_posture";

    // Baby
    row.item as it where (linkId = 'assessment/fhr' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '55283-6' "cd";
          it -> cg.display = 'Fetal Heart rate' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      it -> obs.referenceRange as rr then {
        it -> rr.low = create('Quantity') as lo then {
          it -> lo.value = '110' "loValue";
          it -> lo.unit = 'beats/min' "loUnit";
          it -> lo.system = 'http://unitsofmeasure.org' "loSystem";
          it -> lo.code = '/min' "loCode";
        } "low";
        it -> rr.high = create('Quantity') as hi then {
          it -> hi.value = '159' "hiValue";
          it -> hi.unit = 'beats/min' "hiUnit";
          it -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
          it -> hi.code = '/min' "hiCode";
        } "high";
        it -> rr.text = 'WHO Labour Care Guide: alert below 110 or at 160 and above' "rrText";
      } "referenceRange";
      it -> obs.interpretation as interp then {
        it -> interp.coding as icg then {
          it -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
          it -> icg.code = evaluate(it, iif(answer.value.ofType(Quantity).value < 110, 'L', iif(answer.value.ofType(Quantity).value >= 160, 'H', 'N'))) "cd";
          it -> icg.display = evaluate(it, iif(answer.value.ofType(Quantity).value < 110, 'Low', iif(answer.value.ofType(Quantity).value >= 160, 'High', 'Normal'))) "dsp";
        } "coding";
      } "interpretation";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_fhr";

    row.item as it where (linkId = 'assessment/fhr-deceleration' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-fhr-deceleration' "cd";
          it -> cg.display = 'FHR deceleration' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_fhr_deceleration";

    row.item as it where (linkId = 'assessment/amniotic-fluid' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-amniotic-fluid' "cd";
          it -> cg.display = 'Amniotic fluid' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_amniotic_fluid";

    row.item as it where (linkId = 'assessment/fetal-position' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11874-5' "cd";
          it -> cg.display = 'Fetal position' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_fetal_position";

    row.item as it where (linkId = 'assessment/caput' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-caput' "cd";
          it -> cg.display = 'Caput' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_caput";

    row.item as it where (linkId = 'assessment/moulding' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-moulding' "cd";
          it -> cg.display = 'Moulding' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_moulding";

    // Woman
    row.item as it where (linkId = 'assessment/pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8867-4' "cd";
          it -> cg.display = 'Heart rate' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_pulse";

    row.item as it where (linkId = 'assessment/systolic' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8480-6' "cd";
          it -> cg.display = 'Systolic blood pressure' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_systolic";

    row.item as it where (linkId = 'assessment/diastolic' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8462-4' "cd";
          it -> cg.display = 'Diastolic blood pressure' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_diastolic";

    row.item as it where (linkId = 'assessment/temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8310-5' "cd";
          it -> cg.display = 'Body temperature' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_temperature";

    row.item as it where (linkId = 'assessment/urine-protein' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '20454-5' "cd";
          it -> cg.display = 'Protein in urine' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_urine_protein";

    row.item as it where (linkId = 'assessment/urine-acetone' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '2514-8' "cd";
          it -> cg.display = 'Ketones in urine' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_urine_acetone";

    // Labour progress
    row.item as it where (linkId = 'assessment/contractions' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-contractions-per-10-min' "cd";
          it -> cg.display = 'Contractions per 10 min' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_contractions";

    row.item as it where (linkId = 'assessment/contraction-duration' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-contraction-duration' "cd";
          it -> cg.display = 'Duration of contractions' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_contraction_duration";

    row.item as it where (linkId = 'assessment/cervix' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11784-6' "cd";
          it -> cg.display = 'Cervical dilation' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_cervix";

    row.item as it where (linkId = 'assessment/descent' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-descent-fifths' "cd";
          it -> cg.display = 'Descent' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_descent";

    row.item as it where (linkId = 'assessment/pushing' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-pushing' "cd";
          it -> cg.display = 'Pushing' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as cv -> obs.value = create('CodeableConcept') as cc then {
          cv -> cc.coding = cv "valueCoding";
          cv.display as d -> cc.text = d "valueText";
        } "codedValue";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_pushing";

    // Shared decision-making
    row.item as it where (linkId = 'assessment/assessment' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-assessment' "cd";
          it -> cg.display = 'Assessment' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_assessment";

    row.item as it where (linkId = 'assessment/plan' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-plan' "cd";
          it -> cg.display = 'Plan' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetAssessmentTime(row, obs) "assessmentTime";
    } "assessment_plan";

  } "assessments";
}

// The assessment's own time on everything extracted from it. A time without a
// clock is left to the response's authored time, which the base already set.
group SetAssessmentTime(source row, target obs : Observation) {
  row.item as it where (linkId = 'assessment/at' and answer.value.exists()) then {
    it.answer first as a then {
      a.value as v where ($this.toString().length() >= 20) -> obs.effective = v "effective";
    } "answer";
  } "assessmentTimeRule";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group SetComponentValue(source it, target comp) {
  it.answer first as a then {
    a.value as v -> comp.value = v "plainValue";
  } "componentAnswer";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetExamCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'exam' "categoryCode";
      qr -> coding.display = 'Exam' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'labour-care-guide' "provenanceCode";
      qr -> t.display = 'Labour care guide' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}
