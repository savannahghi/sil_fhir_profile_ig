/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractMaternityUnitPatientRecord"
/// name = "ExtractMaternityUnitPatientRecord"
/// title = "Maternity Unit Patient Record Extraction"
/// status = "active"
/// description = "The maternity unit record out as: the admitting diagnosis as a provisional Condition; the pregnancy dates (LMP, the EDD the form calculates, gestation) and the parity as their own Observations, because a booking is read from them; the medical, transfusion and family history as narrative Observations; each previous pregnancy on the obstetric history as one panel; the blood group, rhesus, RPR and HIV results as laboratory Observations; the admission examination as Observations with the blood pressure paired; the operation and anaesthetic consent as a Consent written only once the woman or her representative has signed, with the witnessing midwife or doctor as verifier; and the discharge as a discharge-note Composition. No Encounter is minted; the response\'s own encounter is the admission."
//
// GATE: (item.where(linkId = 'admission' or linkId = 'pregnancy' or linkId = 'history' or linkId = 'obstetricHistory' or linkId = 'bloodAndSerology' or linkId = 'examination').descendants().where(linkId != 'admission.dateTime').answer.value.exists()) or (item.where(linkId = 'consent').item.where(linkId = 'consent.signature.signed').answer.value = true) or (item.where(linkId = 'discharge').item.where(linkId = 'discharge.record').answer.value = true)
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/Consent" alias Consent as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target

group ExtractMaternityUnitPatientRecord(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Admission ───────────────────────────────────────────────────────────
  // No Encounter is minted; the response's own encounter is the admission. The
  // diagnosis is a provisional Condition; PMTCT status and clinic attended are
  // Observations the antenatal history is read from.
  qr.item as g where (linkId = 'admission') then {
    g.item as it where (linkId = 'admission.diagnosis' and answer.value.exists()) -> bundle.entry as entryC, entryC.resource = create('Condition') as cond then {
      qr -> cond, entryC then BuildConditionBase(qr, cond, entryC) "conditionBase";
      qr -> cond.verificationStatus as vs then {
        qr -> vs.coding as vsc then {
          qr -> vsc.system = 'http://terminology.hl7.org/CodeSystem/condition-ver-status' "verSystem";
          qr -> vsc.code = 'provisional' "verCode";
          qr -> vsc.display = 'Provisional' "verDisplay";
        } "verCoding";
      } "verificationStatus";
      it.answer first as a then {
        a.value : string as v -> cond.code as code, code.text = v "codeText";
      } "answer";
      g.item as pf where (linkId = 'admission.admittingDoctor' and answer.value.exists()) then {
        pf.answer first as pa then {
          pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> cond.participant as part, part.actor = create('Reference') as actor then {
            ref.reference as v -> actor.reference = v "reference";
            ref.type as v -> actor.type = v "type";
            ref.identifier as v -> actor.identifier = v "identifier";
            ref.display as v -> actor.display = v "display";
          } "performer";
        } "performerAnswer";
      } "performer_1";
    } "admittingDiagnosis";
    g.item as it where (linkId = 'admission.pmtctStatus' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'maternal-pmtct-status' "cd";
          it -> cg.display = 'Maternal PMTCT status' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as v -> obs.value = v "value";
      } "answer";
    } "obs_maternal_pmtct_status_2";
    g.item as it where (linkId = 'admission.clinicAttended' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'antenatal-clinic-attended' "cd";
          it -> cg.display = 'Antenatal clinic attended' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as v -> obs.value = v "value";
      } "answer";
    } "obs_antenatal_clinic_attended_3";
  } "admissionGroup";

  // ── The present pregnancy ───────────────────────────────────────────────
  qr.item as g where (linkId = 'pregnancy') then {
    g.item as it where (linkId = 'pregnancy.para' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11977-6' "cd";
          it -> cg.display = 'Parity' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
    } "obs_11977_6_4";
    g.item as it where (linkId = 'pregnancy.gravida' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11996-6' "cd";
          it -> cg.display = 'Pregnancies' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
    } "obs_11996_6_5";
    g.item as it where (linkId = 'pregnancy.lmp' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8665-2' "cd";
          it -> cg.display = 'Last menstrual period start date' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
      } "answer";
    } "obs_8665_2_6";
    // The EDD the form calculates from the LMP (LMP + 280 days).
    g.item as it where (linkId = 'pregnancy.edd' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11778-8' "cd";
          it -> cg.display = 'Delivery date Estimated' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
      } "answer";
    } "obs_11778_8_7";
    g.item as it where (linkId = 'pregnancy.gestation' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '18185-9' "cd";
          it -> cg.display = 'Gestational age' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
    } "obs_18185_9_8";
  } "pregnancyGroup";

  // ── History ─────────────────────────────────────────────────────────────
  qr.item as g where (linkId = 'history') then {
    g.item as it where (linkId = 'history.medicalSurgical' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11349-8' "cd";
          it -> cg.display = 'History of Past illness Narrative' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as txt -> obs.note as n, n.text = txt "text";
      } "answer";
    } "obs_11349_8_9";
    g.item as it where (linkId = 'history.transfused' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'history-previous-blood-transfusion' "cd";
          it -> cg.display = 'Previous blood transfusion' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : boolean as v -> obs.value = v "value";
      } "answer";
      g.item as nt where (linkId = 'history.transfusion' and answer.value.exists()) then {
        nt.answer first as na then {
          na.value : string as txt -> obs.note as n, n.text = append('Details: ', txt) "noteText";
        } "noteAnswer";
      } "note_10";
    } "obs_history_previous_blood_transfusion_11";
    g.item as it where (linkId = 'history.family' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '10157-6' "cd";
          it -> cg.display = 'History of family member diseases Narrative' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as txt -> obs.note as n, n.text = txt "text";
      } "answer";
    } "obs_10157_6_12";
  } "historyGroup";

  // ── Obstetric history: one panel per previous pregnancy ─────────────────
  qr.item as g where (linkId = 'obstetricHistory' and item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetSurveyCategory(qr, obs) "category";
    g -> obs.code as cc then {
      g -> cc.coding as cg then {
        g -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
        g -> cg.code = 'obstetric-history-previous-pregnancy' "cd";
        g -> cg.display = 'Previous pregnancy' "dsp";
      } "coding";
    } "code";
    g.item as ci where (linkId = 'obstetricHistory.yearAndPlace' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obs-year' "cd";
          ci -> cg.display = 'Year' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : string as v -> comp.value = v "value";
      } "answer";
    } "comp_obs_year_13";
    g.item as ci where (linkId = 'obstetricHistory.durationOfLabour' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obs-duration-of-labour' "cd";
          ci -> cg.display = 'Duration of labour' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : Quantity as v -> comp.value = v "value";
      } "answer";
    } "comp_obs_duration_of_labour_14";
    g.item as ci where (linkId = 'obstetricHistory.delivery' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obstetric-mode-of-delivery' "cd";
          ci -> cg.display = 'Mode of delivery' "dsp";
        } "coding";
      } "code";
      ci -> comp then SetComponentCodedValue(ci, comp) "value";
    } "comp_obstetric_mode_of_delivery_15";
    g.item as ci where (linkId = 'obstetricHistory.weight' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'http://loinc.org' "sys";
          ci -> cg.code = '8339-4' "cd";
          ci -> cg.display = 'Birth weight Measured' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : Quantity as v -> comp.value = v "value";
      } "answer";
    } "comp_8339_4_16";
    g.item as ci where (linkId = 'obstetricHistory.sex' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'http://loinc.org' "sys";
          ci -> cg.code = '76689-9' "cd";
          ci -> cg.display = 'Sex assigned at birth' "dsp";
        } "coding";
      } "code";
      ci -> comp then SetComponentCodedValue(ci, comp) "value";
    } "comp_76689_9_17";
    g.item as ci where (linkId = 'obstetricHistory.outcome' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obs-outcome' "cd";
          ci -> cg.display = 'Outcome' "dsp";
        } "coding";
      } "code";
      ci -> comp then SetComponentCodedValue(ci, comp) "value";
    } "comp_obs_outcome_18";
    g.item as ci where (linkId = 'obstetricHistory.feeding' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obs-infant-feeding' "cd";
          ci -> cg.display = 'Infant feeding' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : string as v -> comp.value = v "value";
      } "answer";
    } "comp_obs_infant_feeding_19";
    g.item as ci where (linkId = 'obstetricHistory.puerperium' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obs-puerperium' "cd";
          ci -> cg.display = 'Puerperium' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : string as v -> comp.value = v "value";
      } "answer";
    } "comp_obs_puerperium_20";
    g.item as ci where (linkId = 'obstetricHistory.pelvicAssessment' and answer.value.exists()) -> obs.component as comp then {
      ci -> comp.code as cc then {
        ci -> cc.coding as cg then {
          ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ci -> cg.code = 'obstetric-pelvic-assessment' "cd";
          ci -> cg.display = 'Pelvic assessment' "dsp";
        } "coding";
      } "code";
      ci.answer first as a then {
        a.value : string as v -> comp.value = v "value";
      } "answer";
    } "comp_obstetric_pelvic_assessment_21";
  } "obstetricHistoryPanel";

  // ── Blood group and serology ────────────────────────────────────────────
  qr.item as g where (linkId = 'bloodAndSerology') then {
    g.item as it where (linkId = 'bloodAndSerology.bloodGroup' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '883-9' "cd";
          it -> cg.display = 'ABO group [Type] in Blood' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "obs_883_9_22";
    g.item as it where (linkId = 'bloodAndSerology.rhesus' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '10331-7' "cd";
          it -> cg.display = 'Rh [Type] in Blood' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "obs_10331_7_23";
    g.item as it where (linkId = 'bloodAndSerology.khanRpr' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'maternal-vdrl-result' "cd";
          it -> cg.display = 'Maternal VDRL result' "dsp";
        } "coding";
        it -> cc.text = 'Khan / RPR' "codeText";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "obs_maternal_vdrl_result_24";
    g.item as it where (linkId = 'bloodAndSerology.hiv' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'maternal-hiv-status' "cd";
          it -> cg.display = 'Maternal HIV status' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "obs_maternal_hiv_status_25";
  } "serologyGroup";

  // ── Examination on admission ────────────────────────────────────────────
  qr.item as g where (linkId = 'examination') then {
    g.item as it where (linkId = 'examination.fundalHeight' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11881-0' "cd";
          it -> cg.display = 'Uterus Fundal height Tape measure' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
    } "obs_11881_0_26";
    g.item as it where (linkId = 'examination.presentation' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'obstetric-fetal-presentation' "cd";
          it -> cg.display = 'Fetal presentation' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
    } "obs_obstetric_fetal_presentation_27";
    g.item as it where (linkId = 'examination.engagement' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'obstetric-engagement' "cd";
          it -> cg.display = 'Engagement of the presenting part' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as v -> obs.value = v "value";
      } "answer";
    } "obs_obstetric_engagement_28";
    g.item as it where (linkId = 'examination.position' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'obstetric-position' "cd";
