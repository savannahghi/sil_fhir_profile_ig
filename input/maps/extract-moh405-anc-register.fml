  // components. The panel is created off the systolic cell and the diastolic is
  // read from its sibling, so a visit that recorded only one of the two still
  // produces a reading rather than nothing -- but the pair stays in one resource,
  // which is what a reader of a blood pressure needs.
  qr.item as g where (linkId = 'ANC-anthropometrics' and item.where(linkId = 'ANC-AV-Q4-bp-systolic').answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then VitalSignsCategory(qr, obs) "category";
    g -> obs.code as ccBp then {
      g -> ccBp.coding as cgBp then {
        g -> cgBp.system = 'http://loinc.org' "sys";
        g -> cgBp.code = '85354-9' "cd";
        g -> cgBp.display = 'Blood pressure panel with all children optional' "dsp";
      } "coding";
      g -> ccBp.text = 'Blood pressure' "codeText";
    } "code";

    g.item as itS where (linkId = 'ANC-AV-Q4-bp-systolic' and answer.value.exists()) -> obs.component as compS then {
      itS -> compS.code as ccS then {
        itS -> ccS.coding as cgS then {
          itS -> cgS.system = 'http://loinc.org' "sys";
          itS -> cgS.code = '8480-6' "cd";
          itS -> cgS.display = 'Systolic blood pressure' "dsp";
        } "coding";
      } "code";
      itS.answer first as aS then {
        aS.value as n -> compS.value = create('Quantity') as qS then {
          n -> qS.value = n "qtyValue";
          n -> qS.unit = 'mmHg' "qtyUnit";
          n -> qS.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qS.code = 'mm[Hg]' "qtyCode";
        } "quantity";
      } "answer";
    } "systolic";

    g.item as itD where (linkId = 'ANC-AV-Q5-bp-diastolic' and answer.value.exists()) -> obs.component as compD then {
      itD -> compD.code as ccD then {
        itD -> ccD.coding as cgD then {
          itD -> cgD.system = 'http://loinc.org' "sys";
          itD -> cgD.code = '8462-4' "cd";
          itD -> cgD.display = 'Diastolic blood pressure' "dsp";
        } "coding";
      } "code";
      itD.answer first as aD then {
        aD.value as n -> compD.value = create('Quantity') as qD then {
          n -> qD.value = n "qtyValue";
          n -> qD.unit = 'mmHg' "qtyUnit";
          n -> qD.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qD.code = 'mm[Hg]' "qtyCode";
        } "quantity";
      } "answer";
    } "diastolic";

    qr -> obs then SetVisitEffective(qr, obs) "visitDate";
  } "obs_blood_pressure";

  // The three HIV rapid tests. Each is its own Observation under 89365-1 carrying
  // the result, with the kit name, lot number and expiry as components: a reactive
  // result that cannot be traced to a kit and lot is not auditable, and the three
  // belong to the result rather than standing alone.
  qr.item as gHiv where (linkId = 'ANC-hiv-art') then {

    gHiv.item as gT1 where (linkId = 'ANC-HV-Q3-test1' and item.where(linkId = 'ANC-HV-Q3d-result').answer.value.exists()) -> bundle.entry as eT1, eT1.resource = create('Observation') as obsT1 then {
      qr -> obsT1, eT1 then BuildObsBase(qr, obsT1, eT1) "base";
      qr -> obsT1 then LaboratoryCategory(qr, obsT1) "category";
      gT1 -> obsT1.code as ccT1 then {
        gT1 -> ccT1.coding as cgT1 then {
          gT1 -> cgT1.system = 'http://loinc.org' "sys";
          gT1 -> cgT1.code = '89365-1' "cd";
          gT1 -> cgT1.display = 'HIV 1 and 2 Ab [Presence] in Serum, Plasma or Blood by Rapid immunoassay' "dsp";
        } "coding";
        gT1 -> ccT1.text = 'HIV rapid test 1' "codeText";
      } "code";
      gT1.item as itR1 where (linkId = 'ANC-HV-Q3d-result') then {
        itR1.answer first as aR1 then {
          aR1.value as cv where ($this is Coding) -> obsT1.value = create('CodeableConcept') as vccT1 then {
            cv -> vccT1.coding = cv "valueCoding";
            cv.display as d -> vccT1.text = d "valueText";
          } "codedValue";
        } "answer";
      } "result";
      gT1 -> obsT1 then HivKitDetail(gT1, obsT1) "kitDetail";
      qr -> obsT1 then SetVisitEffective(qr, obsT1) "visitDate";
    } "obs_hiv_test_1";

    gHiv.item as gT2 where (linkId = 'ANC-HV-Q4-test2' and item.where(linkId = 'ANC-HV-Q4d-result').answer.value.exists()) -> bundle.entry as eT2, eT2.resource = create('Observation') as obsT2 then {
      qr -> obsT2, eT2 then BuildObsBase(qr, obsT2, eT2) "base";
      qr -> obsT2 then LaboratoryCategory(qr, obsT2) "category";
      gT2 -> obsT2.code as ccT2 then {
        gT2 -> ccT2.coding as cgT2 then {
          gT2 -> cgT2.system = 'http://loinc.org' "sys";
          gT2 -> cgT2.code = '89365-1' "cd";
          gT2 -> cgT2.display = 'HIV 1 and 2 Ab [Presence] in Serum, Plasma or Blood by Rapid immunoassay' "dsp";
        } "coding";
        gT2 -> ccT2.text = 'HIV rapid test 2' "codeText";
      } "code";
      gT2.item as itR2 where (linkId = 'ANC-HV-Q4d-result') then {
        itR2.answer first as aR2 then {
          aR2.value as cv where ($this is Coding) -> obsT2.value = create('CodeableConcept') as vccT2 then {
            cv -> vccT2.coding = cv "valueCoding";
            cv.display as d -> vccT2.text = d "valueText";
          } "codedValue";
        } "answer";
      } "result";
      gT2 -> obsT2 then HivKitDetail(gT2, obsT2) "kitDetail";
      qr -> obsT2 then SetVisitEffective(qr, obsT2) "visitDate";
    } "obs_hiv_test_2";

    gHiv.item as gT3 where (linkId = 'ANC-HV-Q5-test3' and item.where(linkId = 'ANC-HV-Q5d-result').answer.value.exists()) -> bundle.entry as eT3, eT3.resource = create('Observation') as obsT3 then {
      qr -> obsT3, eT3 then BuildObsBase(qr, obsT3, eT3) "base";
      qr -> obsT3 then LaboratoryCategory(qr, obsT3) "category";
      gT3 -> obsT3.code as ccT3 then {
        gT3 -> ccT3.coding as cgT3 then {
          gT3 -> cgT3.system = 'http://loinc.org' "sys";
          gT3 -> cgT3.code = '89365-1' "cd";
          gT3 -> cgT3.display = 'HIV 1 and 2 Ab [Presence] in Serum, Plasma or Blood by Rapid immunoassay' "dsp";
        } "coding";
        gT3 -> ccT3.text = 'HIV rapid test 3' "codeText";
      } "code";
      gT3.item as itR3 where (linkId = 'ANC-HV-Q5d-result') then {
        itR3.answer first as aR3 then {
          aR3.value as cv where ($this is Coding) -> obsT3.value = create('CodeableConcept') as vccT3 then {
            cv -> vccT3.coding = cv "valueCoding";
            cv.display as d -> vccT3.text = d "valueText";
          } "codedValue";
        } "answer";
      } "result";
      gT3 -> obsT3 then HivKitDetail(gT3, obsT3) "kitDetail";
      qr -> obsT3 then SetVisitEffective(qr, obsT3) "visitDate";
    } "obs_hiv_test_3";

  } "group_hiv_tests";

  // Other conditions observed. One Condition per answer, because the cell repeats
  // and a reader filtering a problem list wants them apart. "Other (Specify)" is
  // the one answer whose meaning lives in the free-text sibling, so that text
  // becomes the Condition's own text rather than being dropped.
  qr.item as gCm where (linkId = 'ANC-comorbidities') then {
    gCm.item as itCm where (linkId = 'ANC-CM-Q1-conditions') then {
      itCm.answer as aCm where (value.exists()) then {
        aCm -> bundle.entry as eCm, eCm.resource = create('Condition') as cond then {
          qr -> cond, eCm then BuildConditionBase(qr, cond, eCm) "base";
          aCm.value as cv where ($this is Coding) -> cond.code as ccCm then {
            cv -> ccCm.coding = cv "conditionCoding";
            cv.display as d -> ccCm.text = d "conditionText";
          } "codedCondition";
          gCm -> cond then OtherConditionText(gCm, aCm, cond) "otherText";
        } "cond_anc_comorbidity";
      } "answers";
    } "item_conditions";
  } "group_comorbidities";

  // Tetanus toxoid. The answer names the dose, not the vaccine, so the vaccine is
  // stated here (CVX 112, tetanus toxoid unspecified formulation) and the answer
  // becomes protocolApplied.doseNumber. "None / Not Applicable" is a statement
  // that nothing was given, so it creates no Immunization.
  qr.item as gTx where (linkId = 'ANC-treatment') then {
    gTx.item as itTt where (linkId = 'ANC-TX-Q3-tt') then {
      itTt.answer first as aTt where (value.ofType(Coding).where(code != 'tt-none').exists()) then {
        aTt -> bundle.entry as eTt, eTt.resource = create('Immunization') as imm then {
          qr -> imm, eTt then BuildImmunizationBase(qr, imm, eTt) "base";
          aTt -> imm.vaccineCode as ccTt then {
            aTt -> ccTt.coding as cgTt then {
              aTt -> cgTt.system = 'http://hl7.org/fhir/sid/cvx' "sys";
              aTt -> cgTt.code = '112' "cd";
              aTt -> cgTt.display = 'tetanus toxoid, unspecified formulation' "dsp";
            } "coding";
            aTt -> ccTt.text = 'Tetanus toxoid' "codeText";
          } "vaccineCode";
          aTt.value as cv where ($this is Coding and code = 'tt-dose-1') -> imm.protocolApplied as paTt1 then {
            cv -> paTt1.doseNumber = '1' "doseNumber";
          } "dose1";
          aTt.value as cv where ($this is Coding and code = 'tt-dose-2') -> imm.protocolApplied as paTt2 then {
            cv -> paTt2.doseNumber = '2' "doseNumber";
          } "dose2";
          aTt.value as cv where ($this is Coding and code = 'tt-dose-3') -> imm.protocolApplied as paTt3 then {
            cv -> paTt3.doseNumber = '3' "doseNumber";
          } "dose3";
          aTt.value as cv where ($this is Coding and code = 'tt-dose-4') -> imm.protocolApplied as paTt4 then {
            cv -> paTt4.doseNumber = '4' "doseNumber";
          } "dose4";
          aTt.value as cv where ($this is Coding and code = 'tt-dose-5') -> imm.protocolApplied as paTt5 then {
            cv -> paTt5.doseNumber = '5' "doseNumber";
          } "dose5";
        } "imm_tetanus_toxoid";
      } "answer";
    } "item_tt";
  } "group_treatment_immunisation";

  // Preventive and prophylactic medicines. The three HIV cells and deworming are
  // yes/no, so the medicine is named here and the answer only decides whether the
  // administration happened at all; IPTp and supplementation carry the product in
  // the answer itself, so that coding is copied through onto medication.concept.
  qr.item as gMa0 where (linkId = 'ANC-treatment') then {
    gMa0.item as itMa0 where (linkId = 'ANC-TX-Q1-deworming') then {
      itMa0.answer first as aMa0 where (value.ofType(Coding).where(code = 'Y').exists()) then {
        aMa0 -> bundle.entry as eMa0, eMa0.resource = create('MedicationAdministration') as maMa0 then {
          qr -> maMa0, eMa0 then BuildMedAdminBase(qr, maMa0, eMa0) "base";
          qr -> maMa0.medication as mcrMa0 then {
            qr -> mcrMa0.concept as mccMa0 then {
              qr -> mccMa0.coding as mcoMa0 then {
                qr -> mcoMa0.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
                qr -> mcoMa0.code = 'anc-deworming' "cd";
                qr -> mcoMa0.display = 'Deworming in pregnancy' "dsp";
              } "coding";
              qr -> mccMa0.text = 'Deworming in pregnancy' "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_TX_Q1_deworming";
      } "answer";
    } "item_ANC_TX_Q1_deworming";
  } "group_ANC_TX_Q1_deworming";

  qr.item as gMa1 where (linkId = 'ANC-treatment') then {
    gMa1.item as itMa1 where (linkId = 'ANC-TX-Q2-ipt') then {
      itMa1.answer first as aMa1 where (value.ofType(Coding).exists()) then {
        aMa1 -> bundle.entry as eMa1, eMa1.resource = create('MedicationAdministration') as maMa1 then {
          qr -> maMa1, eMa1 then BuildMedAdminBase(qr, maMa1, eMa1) "base";
          aMa1.value as cv where ($this is Coding) -> maMa1.medication as mcrMa1 then {
            cv -> mcrMa1.concept as mccMa1 then {
              cv -> mccMa1.coding = cv "coding";
              cv.display as d -> mccMa1.text = d "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_TX_Q2_ipt";
      } "answer";
    } "item_ANC_TX_Q2_ipt";
  } "group_ANC_TX_Q2_ipt";

  qr.item as gMa2 where (linkId = 'ANC-supplementation') then {
    gMa2.item as itMa2 where (linkId = 'ANC-SP-Q1-supplements') then {
      itMa2.answer first as aMa2 where (value.ofType(Coding).exists()) then {
        aMa2 -> bundle.entry as eMa2, eMa2.resource = create('MedicationAdministration') as maMa2 then {
          qr -> maMa2, eMa2 then BuildMedAdminBase(qr, maMa2, eMa2) "base";
          aMa2.value as cv where ($this is Coding) -> maMa2.medication as mcrMa2 then {
            cv -> mcrMa2.concept as mccMa2 then {
              cv -> mccMa2.coding = cv "coding";
              cv.display as d -> mccMa2.text = d "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_SP_Q1_supplements";
      } "answer";
    } "item_ANC_SP_Q1_supplements";
  } "group_ANC_SP_Q1_supplements";

  qr.item as gMa3 where (linkId = 'ANC-hiv-art') then {
    gMa3.item as itMa3 where (linkId = 'ANC-HV-Q11-ctx') then {
      itMa3.answer first as aMa3 where (value.ofType(Coding).where(code = 'Y').exists()) then {
        aMa3 -> bundle.entry as eMa3, eMa3.resource = create('MedicationAdministration') as maMa3 then {
          qr -> maMa3, eMa3 then BuildMedAdminBase(qr, maMa3, eMa3) "base";
          qr -> maMa3.medication as mcrMa3 then {
            qr -> mcrMa3.concept as mccMa3 then {
              qr -> mccMa3.coding as mcoMa3 then {
                qr -> mcoMa3.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
                qr -> mcoMa3.code = 'anc-ctx' "cd";
                qr -> mcoMa3.display = 'Cotrimoxazole prophylaxis' "dsp";
              } "coding";
              qr -> mccMa3.text = 'Cotrimoxazole prophylaxis' "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_HV_Q11_ctx";
      } "answer";
    } "item_ANC_HV_Q11_ctx";
  } "group_ANC_HV_Q11_ctx";

  qr.item as gMa4 where (linkId = 'ANC-hiv-art') then {
    gMa4.item as itMa4 where (linkId = 'ANC-HV-Q12-azt') then {
      itMa4.answer first as aMa4 where (value.ofType(Coding).where(code = 'Y').exists()) then {
        aMa4 -> bundle.entry as eMa4, eMa4.resource = create('MedicationAdministration') as maMa4 then {
          qr -> maMa4, eMa4 then BuildMedAdminBase(qr, maMa4, eMa4) "base";
          qr -> maMa4.medication as mcrMa4 then {
            qr -> mcrMa4.concept as mccMa4 then {
              qr -> mccMa4.coding as mcoMa4 then {
                qr -> mcoMa4.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
                qr -> mcoMa4.code = 'anc-infant-azt' "cd";
                qr -> mcoMa4.display = 'Infant zidovudine prophylaxis' "dsp";
              } "coding";
              qr -> mccMa4.text = 'Infant zidovudine prophylaxis' "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_HV_Q12_azt";
      } "answer";
    } "item_ANC_HV_Q12_azt";
  } "group_ANC_HV_Q12_azt";

  qr.item as gMa5 where (linkId = 'ANC-hiv-art') then {
    gMa5.item as itMa5 where (linkId = 'ANC-HV-Q13-nvp') then {
      itMa5.answer first as aMa5 where (value.ofType(Coding).where(code = 'Y').exists()) then {
        aMa5 -> bundle.entry as eMa5, eMa5.resource = create('MedicationAdministration') as maMa5 then {
          qr -> maMa5, eMa5 then BuildMedAdminBase(qr, maMa5, eMa5) "base";
          qr -> maMa5.medication as mcrMa5 then {
            qr -> mcrMa5.concept as mccMa5 then {
              qr -> mccMa5.coding as mcoMa5 then {
                qr -> mcoMa5.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
                qr -> mcoMa5.code = 'anc-infant-nvp' "cd";
                qr -> mcoMa5.display = 'Infant nevirapine prophylaxis' "dsp";
              } "coding";
              qr -> mccMa5.text = 'Infant nevirapine prophylaxis' "text";
            } "concept";
          } "medication";
        } "medadmin_ANC_HV_Q13_nvp";
      } "answer";
    } "item_ANC_HV_Q13_nvp";
  } "group_ANC_HV_Q13_nvp";

  // An onward referral. ServiceRequest is what carries an intent to refer; the
  // destination becomes the code and the free-text reason its reasonCode, so a
  // reader sees why without opening the response.
  qr.item as gRf where (linkId = 'ANC-referrals') then {
    gRf.item as itRf where (linkId = 'ANC-RF-Q2-referred-to') then {
      itRf.answer first as aRf where (value.ofType(Coding).exists()) then {
        aRf -> bundle.entry as eRf, eRf.resource = create('ServiceRequest') as sr then {
          qr -> sr, eRf then BuildServiceRequestBase(qr, sr, eRf) "base";
          aRf.value as cv where ($this is Coding) -> sr.code as ccRf then {
            cv -> ccRf.concept as cptRf then {
              cv -> cptRf.coding = cv "referralCoding";
              cv.display as d -> cptRf.text = d "referralText";
            } "concept";
          } "code";
          gRf -> sr then ReferralReason(gRf, sr) "reason";
        } "servicerequest_anc_referral";
      } "answer";
    } "item_referred_to";
  } "group_referral_out";

}

// ── Bases ────────────────────────────────────────────────────────────────────
//
// What every resource of a kind needs before anything form-specific is written:
// an id and a fullUrl so later entries can point at it, a POST request line, the
// status, and the subject and encounter the response arrived with.

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is a
  // relative reference as it stands. The hasValue() guard is what stops a response
  // posted straight to $extract, rather than saved first, from writing
  // "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group BuildConditionBase(source qr : QR, target cond : Condition, target entry) {
  qr -> cond then SetResponseProvenance(qr, cond) "responseProvenance";
  qr -> cond.id = uuid() then SetConditionFullUrl(cond, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Condition' "requestUrl";
  } "entryRequest";

  qr -> cond.clinicalStatus as cs then {
    qr -> cs.coding as csc then {
      qr -> csc.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "clinSystem";
      qr -> csc.code = 'active' "clinCode";
      qr -> csc.display = 'Active' "clinDisplay";
    } "clinCoding";
  } "clinicalStatus";

  qr -> cond.category as cat then {
    qr -> cat.coding as catc then {
      qr -> catc.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "catSystem";
      qr -> catc.code = 'encounter-diagnosis' "catCode";
      qr -> catc.display = 'Encounter Diagnosis' "catDisplay";
    } "catCoding";
  } "category";

  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> cond.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> cond.encounter = e "encounter";
  qr.authored as t -> cond.recordedDate = t "recordedDate";
  qr.id as qid where ($this.hasValue()) -> cond.evidence as ev, ev.reference = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group BuildImmunizationBase(source qr : QR, target imm : Immunization, target entry) {
  qr -> imm then SetResponseProvenance(qr, imm) "responseProvenance";
  qr -> imm.id = uuid() then SetImmunizationFullUrl(imm, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Immunization' "requestUrl";
  } "entryRequest";

  qr -> imm.status = 'completed' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> imm.patient = s "patient";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> imm.encounter = e "encounter";
  qr -> imm then SetVisitOccurrence(qr, imm) "occurrence";
}

group BuildMedAdminBase(source qr : QR, target ma : MedicationAdministration, target entry) {
  qr -> ma then SetResponseProvenance(qr, ma) "responseProvenance";
  qr -> ma.id = uuid() then SetMedAdminFullUrl(ma, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'MedicationAdministration' "requestUrl";
  } "entryRequest";

  qr -> ma.status = 'completed' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> ma.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> ma.encounter = e "encounter";
  qr -> ma then SetVisitOccurence(qr, ma) "occurence";
}

group BuildServiceRequestBase(source qr : QR, target sr : ServiceRequest, target entry) {
  qr -> sr then SetResponseProvenance(qr, sr) "responseProvenance";
  qr -> sr.id = uuid() then SetServiceRequestFullUrl(sr, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'ServiceRequest' "requestUrl";
  } "entryRequest";

  qr -> sr.status = 'active' "status";
  qr -> sr.intent = 'order' "intent";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> sr.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> sr.encounter = e "encounter";
  qr.authored as t -> sr.authoredOn = t "authoredOn";
  qr -> sr then ConformServiceRequest(qr, sr) "profileConformance";
}

// ── fullUrls ─────────────────────────────────────────────────────────────────
//
// urn:uuid, so a later entry in the same transaction can reference this one and
// the server resolves it on commit.

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as oid -> entry.fullUrl = append('urn:uuid:', oid) "fullUrl";
}
group SetConditionFullUrl(source cond : Condition, target entry) {
  cond.id as cid -> entry.fullUrl = append('urn:uuid:', cid) "fullUrl";
}
group SetImmunizationFullUrl(source imm : Immunization, target entry) {
  imm.id as iid -> entry.fullUrl = append('urn:uuid:', iid) "fullUrl";
}
group SetMedAdminFullUrl(source ma : MedicationAdministration, target entry) {
  ma.id as mid -> entry.fullUrl = append('urn:uuid:', mid) "fullUrl";
}
group SetServiceRequestFullUrl(source sr : ServiceRequest, target entry) {
  sr.id as sid -> entry.fullUrl = append('urn:uuid:', sid) "fullUrl";
}

// ── The visit date ───────────────────────────────────────────────────────────
//
// Every resource this map writes is dated by the visit the register row belongs
// to, not by the moment the form was submitted -- a register filled in the
// afternoon for a morning clinic would otherwise date everything to the
// afternoon. ConformObservation has already set effective from `authored`, so
// these groups overwrite it when the visit-date cell was filled and leave the
// `authored` fallback standing when it was not.
//
// R5 spells MedicationAdministration.occurence[x] with one 'r' and
// Immunization.occurrence[x] with two. That is a typo in the specification, not
// here, and the two groups below are separate because of it.

group SetVisitEffective(source qr : QR, target obs : Observation) {
  qr.item as g where (linkId = 'ANC-visit-admin') then {
    g.item as it where (linkId = 'ANC-VA-Q1-visit-date') then {
      it.answer first as a then {
        a.value as d -> obs.effective = cast(d, 'dateTime') "visitEffective";
      } "answer";
    } "dateItem";
  } "adminGroup";
}

group SetVisitOccurrence(source qr : QR, target imm : Immunization) {
  qr.authored as t -> imm.occurrence = cast(t, 'dateTime') "authoredOccurrence";
  qr.item as g where (linkId = 'ANC-visit-admin') then {
    g.item as it where (linkId = 'ANC-VA-Q1-visit-date') then {
      it.answer first as a then {
        a.value as d -> imm.occurrence = cast(d, 'dateTime') "visitOccurrence";
      } "answer";
    } "dateItem";
  } "adminGroup";
}

group SetVisitOccurence(source qr : QR, target ma : MedicationAdministration) {
  qr.authored as t -> ma.occurence = cast(t, 'dateTime') "authoredOccurence";
  qr.item as g where (linkId = 'ANC-visit-admin') then {
    g.item as it where (linkId = 'ANC-VA-Q1-visit-date') then {
      it.answer first as a then {
        a.value as d -> ma.occurence = cast(d, 'dateTime') "visitOccurence";
      } "answer";
    } "dateItem";
  } "adminGroup";
}

// ── Detail groups ────────────────────────────────────────────────────────────

// Kit name, lot number and expiry as components of the result they belong to.
// Matched on the linkId suffix so one group serves all three tests.
group HivKitDetail(source g, target obs : Observation) {
  g.item as itK where (linkId.endsWith('-kit-name') and answer.value.exists()) -> obs.component as compK then {
    itK -> compK.code as ccK then {
      itK -> ccK.coding as cgK then {
        itK -> cgK.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
        itK -> cgK.code = 'anc-hiv-test-kit-name' "cd";
        itK -> cgK.display = 'HIV test kit name' "dsp";
      } "coding";
    } "code";
    itK.answer first as aK then {
      aK.value as v -> compK.value = v "value";
    } "answer";
  } "kitName";

  g.item as itL where (linkId.endsWith('-lot-no') and answer.value.exists()) -> obs.component as compL then {
    itL -> compL.code as ccL then {
      itL -> ccL.coding as cgL then {
        itL -> cgL.system = 'http://loinc.org' "sys";
        itL -> cgL.code = '43156-9' "cd";
        itL -> cgL.display = 'Reagent Lot number' "dsp";
      } "coding";
    } "code";
    itL.answer first as aL then {
      aL.value as v -> compL.value = v "value";
    } "answer";
  } "lotNumber";

  g.item as itE where (linkId.endsWith('-expiry') and answer.value.exists()) -> obs.component as compE then {
    itE -> compE.code as ccE then {
      itE -> ccE.coding as cgE then {
        itE -> cgE.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
        itE -> cgE.code = 'anc-hiv-test-kit-expiry' "cd";
        itE -> cgE.display = 'HIV test kit expiry date' "dsp";
      } "coding";
    } "code";
    itE.answer first as aE then {
      aE.value as v -> compE.value = cast(v, 'dateTime') "value";
    } "answer";
  } "expiry";
}

// "Other (Specify)" carries its meaning in the sibling free-text cell.
group OtherConditionText(source g, source a, target cond : Condition) {
  a.value as cv where ($this is Coding and code = 'anc-other') then {
    g.item as itOther where (linkId = 'ANC-CM-Q2-other-specify' and answer.value.exists()) then {
      itOther.answer first as aOther then {
        aOther.value as txt -> cond.code as ccOther, ccOther.text = txt "otherText";
      } "answer";
    } "specifyItem";
  } "isOther";
}

group ReferralReason(source g, target sr : ServiceRequest) {
  g.item as itR where (linkId = 'ANC-RF-Q3-reason' and answer.value.exists()) then {
    itR.answer first as aR then {
      aR.value as txt -> sr.reason as rsn, rsn.concept as rc, rc.text = txt "reasonText";
    } "answer";
  } "reasonItem";
}

// ── Categories ───────────────────────────────────────────────────────────────

group SurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group VitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group ExamCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'exam' "categoryCode";
      qr -> coding.display = 'Exam' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group LaboratoryCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'laboratory' "categoryCode";
      qr -> coding.display = 'Laboratory' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-visit recalls its own earlier entries
// and not another form's. The second copies the tenant tags off the response,
// because nothing else on the path puts them there. The response's identifier is
// copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id here
// would tie the tag to whichever environment stamped it.

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'moh-405-anc-register' "provenanceCode";
      qr -> t.display = 'MOH 405 antenatal care register' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Nothing here mints one, so a
  // response without an identifier extracts resources without one.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}

group ConformServiceRequest(source qr : QR, target r) {
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.requester = au "requesterFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.requester = src "requesterFromSource";
  } "requesterFallback";
}
