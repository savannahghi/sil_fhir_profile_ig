/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractMOH405ANCRegister"
/// name = "ExtractMOH405ANCRegister"
/// title = "MOH 405 Antenatal Care Register Extraction"
/// status = "active"
/// description = "Extracts a transaction Bundle from a QuestionnaireResponse to the Kenya MOH 405 Antenatal Care Register (2019). Visit administration, obstetric history, anthropometrics, laboratory results, HIV testing and the partner result all round out as Observations under the codes the register itself names; blood pressure as one panel with a systolic and a diastolic component; comorbidities as Conditions; tetanus toxoid as an Immunization carrying its dose number; deworming, IPTp, supplementation and the three HIV prophylaxis cells as MedicationAdministrations; and an onward referral as a ServiceRequest. It creates no Patient, Encounter or EpisodeOfCare: the register is filled inside a visit the EMR has already opened, so all three arrive as context on the response and are referenced rather than minted. The client demographics group is populated from the Patient on launch and is not extracted -- writing it back would mint a second copy of the record it was read from."
/// experimental = "true"

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/Immunization" alias Immunization as target
uses "http://hl7.org/fhir/StructureDefinition/MedicationAdministration" alias MedicationAdministration as target
uses "http://hl7.org/fhir/StructureDefinition/ServiceRequest" alias ServiceRequest as target

group ExtractMOH405ANCRegister(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // Visit administration. The visit date is not an Observation of its own: it
  // is the effective time every resource below carries, set by SetVisitEffective.
  qr.item as g where (linkId = 'ANC-visit-admin') then {

    g.item as it where (linkId = 'ANC-VA-Q2-anc-number-new' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_VA_Q2_ then {
        it -> ccANC_VA_Q2_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '76435-7' "cd";
          it -> cg.display = 'Medical record number' "dsp";
        } "coding";
        it -> ccANC_VA_Q2_.text = 'Medical record number' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_VA_Q2_anc_number_new";

    g.item as it where (linkId = 'ANC-VA-Q3-anc-number-revisit' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_VA_Q3_ then {
        it -> ccANC_VA_Q3_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '76435-7' "cd";
          it -> cg.display = 'Medical record number' "dsp";
        } "coding";
        it -> ccANC_VA_Q3_.text = 'Medical record number' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_VA_Q3_anc_number_revisit";

    g.item as it where (linkId = 'ANC-VA-Q4-visit-count' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_VA_Q4_ then {
        it -> ccANC_VA_Q4_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '68493-6' "cd";
          it -> cg.display = 'Prenatal visits for this pregnancy #' "dsp";
        } "coding";
        it -> ccANC_VA_Q4_.text = 'Prenatal visits for this pregnancy #' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_VA_Q4_visit_count";

  } "group_ANC_visit_admin";

  // Obstetric history. Parity, gravidity and the two dates are re-stated at every
  // visit, so each visit's Observation is that visit's answer, not a correction
  // of the last one.
  qr.item as g where (linkId = 'ANC-obstetric-history') then {

    g.item as it where (linkId = 'ANC-OH-Q1-parity' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q1_ then {
        it -> ccANC_OH_Q1_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11977-6' "cd";
          it -> cg.display = 'Parity' "dsp";
        } "coding";
        it -> ccANC_OH_Q1_.text = 'Parity' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q1_parity";

    g.item as it where (linkId = 'ANC-OH-Q2-miscarriages' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q2_ then {
        it -> ccANC_OH_Q2_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11612-9' "cd";
          it -> cg.display = '[#] Abortions' "dsp";
        } "coding";
        it -> ccANC_OH_Q2_.text = '[#] Abortions' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q2_miscarriages";

    g.item as it where (linkId = 'ANC-OH-Q3-gravidae' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q3_ then {
        it -> ccANC_OH_Q3_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11996-6' "cd";
          it -> cg.display = 'Gravida' "dsp";
        } "coding";
        it -> ccANC_OH_Q3_.text = 'Gravida' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "value";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q3_gravidae";

    g.item as it where (linkId = 'ANC-OH-Q4-lmp' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q4_ then {
        it -> ccANC_OH_Q4_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8665-2' "cd";
          it -> cg.display = 'Last menstrual period start date' "dsp";
        } "coding";
        it -> ccANC_OH_Q4_.text = 'Last menstrual period start date' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = cast(v, 'dateTime') "dateValue";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q4_lmp";

    g.item as it where (linkId = 'ANC-OH-Q5-edd' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q5_ then {
        it -> ccANC_OH_Q5_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11778-8' "cd";
          it -> cg.display = 'Delivery date estimated' "dsp";
        } "coding";
        it -> ccANC_OH_Q5_.text = 'Delivery date estimated' "codeText";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = cast(v, 'dateTime') "dateValue";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q5_edd";

    g.item as it where (linkId = 'ANC-OH-Q6-gestation' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SurveyCategory(qr, obs) "category";
      it -> obs.code as ccANC_OH_Q6_ then {
        it -> ccANC_OH_Q6_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '49051-6' "cd";
          it -> cg.display = 'Gestational age in weeks' "dsp";
        } "coding";
        it -> ccANC_OH_Q6_.text = 'Gestational age in weeks' "codeText";
      } "code";
      it.answer first as a then {
        a.value as n -> obs.value = create('Quantity') as qANC_OH_Q then {
          n -> qANC_OH_Q.value = n "qtyValue";
          n -> qANC_OH_Q.unit = 'wk' "qtyUnit";
          n -> qANC_OH_Q.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qANC_OH_Q.code = 'wk' "qtyCode";
        } "quantity";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_OH_Q6_gestation";

  } "group_ANC_obstetric_history";

  // Anthropometrics. Height and weight carry UCUM units; blood pressure is built
  // separately below as a panel, because a systolic without its diastolic is not
  // a reading.
  qr.item as g where (linkId = 'ANC-anthropometrics') then {

    g.item as it where (linkId = 'ANC-AV-Q1-muac') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then ExamCategory(qr, obs) "category";
          it -> obs.code as ccANC_AV_Q1_ then {
            it -> ccANC_AV_Q1_.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '56072-2' "cd";
              it -> cg.display = 'Mid upper arm circumference' "dsp";
            } "coding";
            it -> ccANC_AV_Q1_.text = 'Mid upper arm circumference' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_AV_Q1_muac";
      } "answers";
    } "item_ANC_AV_Q1_muac";

    g.item as it where (linkId = 'ANC-AV-Q2-height' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then VitalSignsCategory(qr, obs) "category";
      it -> obs.code as ccANC_AV_Q2_ then {
        it -> ccANC_AV_Q2_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8302-2' "cd";
          it -> cg.display = 'Body height' "dsp";
        } "coding";
        it -> ccANC_AV_Q2_.text = 'Body height' "codeText";
      } "code";
      it.answer first as a then {
        a.value as n -> obs.value = create('Quantity') as qANC_AV_Q then {
          n -> qANC_AV_Q.value = n "qtyValue";
          n -> qANC_AV_Q.unit = 'cm' "qtyUnit";
          n -> qANC_AV_Q.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qANC_AV_Q.code = 'cm' "qtyCode";
        } "quantity";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_AV_Q2_height";

    g.item as it where (linkId = 'ANC-AV-Q3-weight' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then VitalSignsCategory(qr, obs) "category";
      it -> obs.code as ccANC_AV_Q3_ then {
        it -> ccANC_AV_Q3_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '29463-7' "cd";
          it -> cg.display = 'Body weight' "dsp";
        } "coding";
        it -> ccANC_AV_Q3_.text = 'Body weight' "codeText";
      } "code";
      it.answer first as a then {
        a.value as n -> obs.value = create('Quantity') as qANC_AV_Q then {
          n -> qANC_AV_Q.value = n "qtyValue";
          n -> qANC_AV_Q.unit = 'kg' "qtyUnit";
          n -> qANC_AV_Q.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qANC_AV_Q.code = 'kg' "qtyCode";
        } "quantity";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_AV_Q3_weight";

    g.item as it where (linkId = 'ANC-AV-Q6-breast-exam') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then ExamCategory(qr, obs) "category";
          it -> obs.code as ccANC_AV_Q6_ then {
            it -> ccANC_AV_Q6_.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '32451-7' "cd";
              it -> cg.display = 'Physical findings of Breast' "dsp";
            } "coding";
            it -> ccANC_AV_Q6_.text = 'Physical findings of Breast' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_AV_Q6_breast_exam";
      } "answers";
    } "item_ANC_AV_Q6_breast_exam";

    g.item as it where (linkId = 'ANC-AV-Q7-fgm') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then ExamCategory(qr, obs) "category";
          it -> obs.code as ccANC_AV_Q7_ then {
            it -> ccANC_AV_Q7_.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
              it -> cg.code = 'anc-fgm-complication' "cd";
              it -> cg.display = 'FGM-associated complication' "dsp";
            } "coding";
            it -> ccANC_AV_Q7_.text = 'FGM-associated complication' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_AV_Q7_fgm";
      } "answers";
    } "item_ANC_AV_Q7_fgm";

  } "group_ANC_anthropometrics";

  // Laboratory investigations. The 'test done' cells are kept as coded
  // Observations in their own right: on a paper register the absence of a result
  // and a test that was never ordered are different facts, and only this column
  // tells them apart.
  qr.item as g where (linkId = 'ANC-laboratory') then {

    g.item as it where (linkId = 'ANC-LB-Q1-hb-status') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as ccANC_LB_Q1_ then {
            it -> ccANC_LB_Q1_.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
              it -> cg.code = 'anc-hb-test-done' "cd";
              it -> cg.display = 'Haemoglobin test performed' "dsp";
            } "coding";
            it -> ccANC_LB_Q1_.text = 'Haemoglobin test performed' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_LB_Q1_hb_status";
      } "answers";
    } "item_ANC_LB_Q1_hb_status";

    g.item as it where (linkId = 'ANC-LB-Q2-hb-value' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then LaboratoryCategory(qr, obs) "category";
      it -> obs.code as ccANC_LB_Q2_ then {
        it -> ccANC_LB_Q2_.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '718-7' "cd";
          it -> cg.display = 'Hemoglobin [Mass/volume] in Blood' "dsp";
        } "coding";
        it -> ccANC_LB_Q2_.text = 'Hemoglobin [Mass/volume] in Blood' "codeText";
      } "code";
      it.answer first as a then {
        a.value as n -> obs.value = create('Quantity') as qANC_LB_Q then {
          n -> qANC_LB_Q.value = n "qtyValue";
          n -> qANC_LB_Q.unit = 'g/dL' "qtyUnit";
          n -> qANC_LB_Q.system = 'http://unitsofmeasure.org' "qtySystem";
          n -> qANC_LB_Q.code = 'g/dL' "qtyCode";
        } "quantity";
      } "answer";
      qr -> obs then SetVisitEffective(qr, obs) "visitDate";
    } "obs_ANC_LB_Q2_hb_value";

    g.item as it where (linkId = 'ANC-LB-Q3-blood-sugar') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as ccANC_LB_Q3_ then {
            it -> ccANC_LB_Q3_.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '15074-8' "cd";
              it -> cg.display = 'Glucose [Moles/volume] in Blood' "dsp";
            } "coding";
            it -> ccANC_LB_Q3_.text = 'Glucose [Moles/volume] in Blood' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_LB_Q3_blood_sugar";
      } "answers";
    } "item_ANC_LB_Q3_blood_sugar";

    g.item as it where (linkId = 'ANC-LB-Q4-blood-group') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as ccANC_LB_Q4_ then {
            it -> ccANC_LB_Q4_.coding as cg then {
              it -> cg.system = 'http://loinc.org' "sys";
              it -> cg.code = '883-9' "cd";
              it -> cg.display = 'ABO group [Type] in Blood' "dsp";
            } "coding";
            it -> ccANC_LB_Q4_.text = 'ABO group [Type] in Blood' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ANC_LB_Q4_blood_group";
      } "answers";
    } "item_ANC_LB_Q4_blood_group";

    g.item as it where (linkId = 'ojy8vwq') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as ccojy8vwq then {
            it -> ccojy8vwq.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
              it -> cg.code = 'anc-malaria-test-done' "cd";
              it -> cg.display = 'Malaria test performed' "dsp";
            } "coding";
            it -> ccojy8vwq.text = 'Malaria test performed' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_ojy8vwq";
      } "answers";
    } "item_ojy8vwq";

    g.item as it where (linkId = 'iq9q66c') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as cciq9q66c then {
            it -> cciq9q66c.coding as cg then {
              it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/special-clinic-code-system' "sys";
              it -> cg.code = 'anc-malaria-test-result' "cd";
              it -> cg.display = 'Malaria test result' "dsp";
            } "coding";
            it -> cciq9q66c.text = 'Malaria test result' "codeText";
          } "code";
          a.value as cv where ($this is Coding) -> obs.value = create('CodeableConcept') as vcc then {
            cv -> vcc.coding = cv "valueCoding";
            cv.display as d -> vcc.text = d "valueText";
          } "codedValue";
          qr -> obs then SetVisitEffective(qr, obs) "visitDate";
        } "obs_iq9q66c";
      } "answers";
    } "item_iq9q66c";

    g.item as it where (linkId = 'ANC-LB-Q5-urinalysis') then {
      it.answer as a where (value.exists()) then {
        a -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then LaboratoryCategory(qr, obs) "category";
          it -> obs.code as ccANC_LB_Q5_ then {
