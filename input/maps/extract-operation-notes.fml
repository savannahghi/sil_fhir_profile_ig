/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractOperationNotes"
/// name = "ExtractOperationNotes"
/// title = "Operation Notes Extraction"
/// status = "active"
/// description = "The operation note out as a Procedure (the team as performers, the pre-operative diagnosis as the reason, the operative diagnosis as the outcome, the procedure-and-findings narrative as its note), a confirmed Condition for the operative diagnosis in the surgeon\'s wording, and a Composition of the note itself with the surgeon as attester, all written only once the surgeon has signed. The swab count is its own Observation, flagged abnormal when incorrect and written only once the scrub nurse has signed it, because a wrong count is a never event and must be findable on its own. The sheet has no field for the operation\'s name, so the Procedure\'s code is plain text: a guessed procedure code on an operation note is a claim about what was done to the patient."
//
// GATE: (item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value = true) or (item.where(linkId = 'count').item.where(linkId = 'count.scrubNurseSigned').answer.value = true)
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Procedure" alias Procedure as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractOperationNotes(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The operation, as a Procedure ───────────────────────────────────────
  // Written once the surgeon has signed the note. The sheet has no field for the
  // operation's name -- the procedure and findings are one narrative -- so the
  // Procedure carries the narrative as its note and a plain text code; a guessed
  // procedure code on an operation note is a claim about what was done to the
  // patient. The pre-operative diagnosis is the reason; the team are performers.
  qr where (item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value = true) then {
    qr.item as g where (linkId = 'case') -> bundle.entry as entry, entry.resource = create('Procedure') as proc then {
      qr -> proc, entry then BuildProcedureBase(qr, proc, entry) "base";
      g -> proc.status = 'completed' "status";
      g -> proc.category as cat then {
        g -> cat.coding as cg then {
          g -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/identifier-codesystem' "sys";
          g -> cg.code = '387713003' "cd";
          g -> cg.display = 'Surgical procedure (procedure)' "dsp";
        } "coding";
      } "category";
      g -> proc.code as cc, cc.text = 'Operation as recorded on the operation note' "codeText";
      g.item as it where (linkId = 'case.dateTime' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : dateTime as t -> proc.occurrence = t "occurrence";
        } "answer";
      } "dateTimeRule";
      g.item as it where (linkId = 'case.preoperativeDiagnosis' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as v -> proc.reason as rs, rs.concept as c, c.text = v "preopDiagnosis";
        } "answer";
      } "preopDiagnosisRule";
      g.item as it where (linkId = 'case.operativeDiagnosis' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as v -> proc.outcome as oc, oc.text = v "operativeDiagnosisOutcome";
        } "answer";
      } "operativeDiagnosisRule";
      g.item as pf where (linkId = 'case.surgeon' and answer.value.exists()) then {
        pf.answer first as pa then {
          pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> proc.performer as p then {
            ref -> p.actor = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "actor";
            ref -> p.function as fn, fn.text = 'Operating surgeon' "function";
          } "performer";
        } "performerAnswer";
      } "performer_1";
      g.item as pf where (linkId = 'case.anaesthetist' and answer.value.exists()) then {
        pf.answer first as pa then {
          pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> proc.performer as p then {
            ref -> p.actor = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "actor";
            ref -> p.function as fn, fn.text = 'Anaesthetist' "function";
          } "performer";
        } "performerAnswer";
      } "performer_2";
      g.item as it where (linkId = 'case.assistant' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as name -> proc.performer as p then {
            name -> p.actor = create('Reference') as r, r.display = name "actor";
            name -> p.function as fn, fn.text = 'Assistant' "function";
          } "performer";
        } "answer";
      } "assistantRule";
      g.item as it where (linkId = 'case.scrubNurse' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as name -> proc.performer as p then {
            name -> p.actor = create('Reference') as r, r.display = name "actor";
            name -> p.function as fn, fn.text = 'Scrub nurse' "function";
          } "performer";
        } "answer";
      } "scrubNurseRule";
      g.item as it where (linkId = 'case.anaestheticAgent' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> proc.note as n, n.text = append('Anaesthetic agent: ', txt) "anaestheticNote";
        } "answer";
      } "anaestheticAgentRule";
      g.item as it where (linkId = 'case.incision' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> proc.note as n, n.text = append('Incision: ', txt) "incisionNote";
        } "answer";
      } "incisionRule";
      qr.item as pf where (linkId = 'procedureFindings' and answer.value.exists()) then {
        pf.answer first as a then {
          a.value : string as txt -> proc.note as n, n.text = txt "findingsNote";
        } "answer";
      } "findingsRule";
    } "operationProcedure";

    // The operative diagnosis also lands on the problem list as a Condition, in
    // the surgeon's wording, so the rest of the stay can hang off it.
    qr.item as g where (linkId = 'case') then {
      g.item as it where (linkId = 'case.operativeDiagnosis' and answer.value.exists()) -> bundle.entry as entryC, entryC.resource = create('Condition') as cond then {
        qr -> cond, entryC then BuildConditionBase(qr, cond, entryC) "conditionBase";
        qr -> cond.verificationStatus as vs then {
          qr -> vs.coding as vsc then {
            qr -> vsc.system = 'http://terminology.hl7.org/CodeSystem/condition-ver-status' "verSystem";
            qr -> vsc.code = 'confirmed' "verCode";
            qr -> vsc.display = 'Confirmed' "verDisplay";
          } "verCoding";
        } "verificationStatus";
        it.answer first as a then {
          a.value : string as v -> cond.code as code, code.text = v "codeText";
        } "answer";
        g.item as pf where (linkId = 'case.surgeon' and answer.value.exists()) then {
          pf.answer first as pa then {
            pa.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> cond.participant as part, part.actor = create('Reference') as actor then {
              ref.reference as v -> actor.reference = v "reference";
              ref.type as v -> actor.type = v "type";
              ref.identifier as v -> actor.identifier = v "identifier";
              ref.display as v -> actor.display = v "display";
            } "performer";
          } "performerAnswer";
        } "performer_3";
      } "operativeDiagnosisCondition";
    } "diagnosisGroup";

    // The note itself, as a Composition: pre-operative and operative diagnosis,
    // procedure and findings, with the surgeon as attester.
    qr -> bundle.entry as entry, entry.resource = create('Composition') as comp then {
      qr -> comp, entry then BuildNoteBase(qr, comp, entry) "noteBase";
      qr -> comp.name = 'OperationNote' "noteName";
      qr -> comp.title = 'Operation note' "noteTitle";
      qr -> comp.type as ty then {
        qr -> ty.coding as sghi then {
          qr -> sghi.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/document-type-codesystem' "sghiSystem";
          qr -> sghi.code = 'theatre-note' "sghiCode";
          qr -> sghi.display = 'Theatre note' "sghiDisplay";
        } "sghiCoding";
        qr -> ty.coding as loinc then {
          qr -> loinc.system = 'http://loinc.org' "loincSystem";
          qr -> loinc.code = '11504-8' "loincCode";
          qr -> loinc.display = 'Surgical operation note' "loincDisplay";
        } "loincCoding";
        qr -> ty.text = 'Operation note' "typeText";
      } "noteType";
      qr.item as g where (linkId = 'case') then {
        g.item as it where (linkId = 'case.dateTime' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : dateTime as t -> comp.date = t "noteDate";
          } "answer";
        } "dateRule";
        g.item as it where (linkId = 'case.preoperativeDiagnosis' and answer.value.exists()) -> comp.section as sec then {
          it -> sec.title = 'Pre-operative diagnosis' "title";
          it -> sec then AddSectionText(it, sec) "text";
        } "section_case_preoperativeDiagnosis_4";
        g.item as it where (linkId = 'case.operativeDiagnosis' and answer.value.exists()) -> comp.section as sec then {
          it -> sec.title = 'Operative diagnosis' "title";
          it -> sec then AddSectionText(it, sec) "text";
        } "section_case_operativeDiagnosis_5";
        g.item as it where (linkId = 'case.surgeon' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : Reference as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> comp.attester as att then {
              ref -> att.mode = 'professional' "attesterMode";
              ref -> att.party = create('Reference') as party then {
                ref.reference as v -> party.reference = v "reference";
                ref.type as v -> party.type = v "type";
                ref.identifier as v -> party.identifier = v "identifier";
                ref.display as v -> party.display = v "display";
              } "attesterParty";
              qr.authored as t -> att.time = t "attesterTime";
            } "attester";
          } "answer";
        } "surgeonAttester";
      } "caseGroup";
      qr.item as it where (linkId = 'procedureFindings' and answer.value.exists()) -> comp.section as sec then {
        it -> sec.title = 'Procedure and findings' "title";
        it -> sec then AddSectionText(it, sec) "text";
      } "section_procedureFindings_6";
    } "composition";
  } "signedNote";

  // ── The swab count ──────────────────────────────────────────────────────
  // Its own Observation, written only once the scrub nurse has signed the count,
  // because a wrong count is a never event and must be findable on its own.
  qr.item as g where (linkId = 'count' and item.where(linkId = 'count.scrubNurseSigned').answer.value = true) then {
    g.item as it where (linkId = 'count.result' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'theatre-sponge-count' "cd";
          it -> cg.display = 'Sponge and gauze count' "dsp";
        } "coding";
        it -> cc.text = 'Swab count' "codeText";
      } "code";
      it.answer first as a then {
        a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
          cv -> vc.coding = cv "valueCoding";
          cv.display as d -> vc.text = d "valueText";
        } "codedValue";
      } "answer";
      g.item as nt where (linkId = 'count.note' and answer.value.exists()) then {
        nt.answer first as na then {
          na.value : string as txt -> obs.note as n, n.text = append('Action taken: ', txt) "noteText";
        } "noteAnswer";
      } "note_7";
      it.answer first as a then {
        a.value : Coding as v where (code = 'count-incorrect') -> obs.interpretation as interp then {
          v -> interp.coding as icg then {
            v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
            v -> icg.code = 'A' "cd";
            v -> icg.display = 'Abnormal' "dsp";
          } "coding";
        } "interp_8";
      } "interpAnswer_9";
    } "obs_theatre_sponge_count_10";
  } "countGroup";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildProcedureBase(source qr : QR, target r : Procedure, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetProcedureFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Procedure' "requestUrl";
  } "entryRequest";

  // The response's own time, as a floor, the way BuildObsBase does it. A rule
  // that reads a time off the form overwrites this; without it a procedure whose
  // date column was taken off on review has no time at all, and a procedure with
  // no time cannot be ordered against the rest of the admission.
  qr.authored as t -> r.occurrence = t "occurrenceFallback";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr -> r then ConformProcedure(qr, r) "profileConformance";
}

group SetProcedureFullUrl(source r : Procedure, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Procedure/', id) "assignFullUrl";
}

group ConformProcedure(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> r.recorded = t "recorded";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.recorder = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "recorderFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.recorder = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "recorderFromSource";
  } "recorderFallback";
}

// Everything a Condition extracted from one of these forms shares. The caller
// supplies verificationStatus and code, because those are the two things that
// differ between an admitting impression and an operative diagnosis.
group BuildConditionBase(source qr : QR, target cond : Condition, target entry) {
  qr -> cond then SetResponseProvenance(qr, cond) "responseProvenance";
  qr -> cond.id = uuid() then SetConditionFullUrl(cond, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Condition' "requestUrl";
  } "entryRequest";

  qr -> cond.clinicalStatus as cs then {
    qr -> cs.coding as csc then {
      qr -> csc.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "clinSystem";
      qr -> csc.code = 'active' "clinCode";
      qr -> csc.display = 'Active' "clinDisplay";
    } "clinCoding";
  } "clinicalStatus";

  qr -> cond.category as cat then {
    qr -> cat.coding as catc then {
      qr -> catc.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "catSystem";
      qr -> catc.code = 'encounter-diagnosis' "catCode";
      qr -> catc.display = 'Encounter Diagnosis' "catDisplay";
    } "catCoding";
  } "category";

  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> cond.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> cond.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";
  qr.authored as t -> cond.recordedDate = t "recordedDate";

  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part then {
    a -> part.actor = create('Reference') as ref then {
      a.reference as v -> ref.reference = v "reference";
      a.type as v -> ref.type = v "type";
      a.identifier as v -> ref.identifier = v "identifier";
      a.display as v -> ref.display = v "display";
    } "participantActor";
  } "participantFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> cond.participant as part2 then {
      src -> part2.actor = create('Reference') as ref then {
        src.reference as v -> ref.reference = v "reference";
        src.type as v -> ref.type = v "type";
        src.identifier as v -> ref.identifier = v "identifier";
        src.display as v -> ref.display = v "display";
      } "participantActorFromSource";
    } "participantFromSource";
  } "participantFallback";

  qr.id as qid where ($this.toString().length() > 0) -> cond.evidence as ev, ev.reference = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
}

group SetConditionFullUrl(source cond : Condition, target entry) {
  cond.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Condition/',
    id
  ) "assignFullUrl";
}

group BuildNoteBase(source qr : QR, target comp : Composition, target entry) {
  qr -> comp then SetResponseProvenance(qr, comp) "responseProvenance";
  qr -> comp.id = uuid() then SetCompositionFullUrl(comp, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Composition' "requestUrl";
  } "entryRequest";

  qr -> comp.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> comp.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> comp.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // Composition.date is 1..1. `authored` is only 0..1 on the response, so when a
  // client sends none the extraction time stands in.
  qr.authored as t -> comp.date = t "date";
  qr where (authored.exists().not()) then {
    qr -> comp.date = evaluate(qr, now()) "dateFromExtractionTime";
  } "dateFallback";

  // Composition.author is 1..1 minimum. The author is whoever recorded the
  // response; `source` only stands in when the client did not send an author.
  qr.author as a where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
    a.reference as v -> ref.reference = v "reference";
    a.type as v -> ref.type = v "type";
    a.identifier as v -> ref.identifier = v "identifier";
    a.display as v -> ref.display = v "display";
  } "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Organization'))))) -> comp.author = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "authorFromSource";
  } "authorFallback";

  qr -> comp.relatesTo as rel then {
    qr -> rel.type = 'derived-from' "relatesToType";
    qr -> rel.resourceReference = create('Reference') as ref then {
      qr.id as qid -> ref.reference = qid "relatesToRef";
    } "relatesToTarget";
  } "linkQuestionnaireResponse";
}

group AddSectionText(source it, target sec) {
  it.answer first as a then {
    a.value : string as v -> sec.text as narrative then {
      v -> narrative.status = 'generated' "narrativeStatus";
      v -> narrative.div = create('xhtml') as xhtml then {
        v -> xhtml.value = evaluate(v, '<div xmlns="http://www.w3.org/1999/xhtml"><p>' + $this.escape('html') + '</p></div>') "narrativeDiv";
      } "narrativeXhtml";
    } "sectionText";
  } "sectionAnswer";
}

group SetCompositionFullUrl(source comp : Composition, target entry) {
  comp.id as id -> entry.fullUrl = append(
    'https://fhir.slade360.co.ke/fhir/Composition/',
    id
  ) "assignFullUrl";
}

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  // The response's subject is Reference(Any); the guard keeps Patients and the
  // copy, field by field, is what satisfies a type checker that cannot see the
  // guard. Same for the encounter.
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The length guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.toString().length() > 0) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value : Coding as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'operation-notes' "provenanceCode";
      qr -> t.display = 'Operation notes' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
