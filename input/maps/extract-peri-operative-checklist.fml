/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractPeriOperativeChecklist"
/// name = "ExtractPeriOperativeChecklist"
/// title = "Peri-operative Checklist Extraction"
/// status = "active"
/// description = "The peri-operative checklist out as: each investigation reviewed before theatre as its own laboratory Observation under its LOINC code; the pre-theatre examination as vital signs with the blood pressure paired; the preparation steps as one Observation with a component per step; the surgeon\'s and the anaesthetist\'s fitness-for-theatre judgements as single Observations at the time of each check, written only when that clinician has signed; and each nursing check -- on the ward and again in theatre -- as one Observation with a component per item and the vital signs taken with it as their own Observations at the check\'s time, written only when the nurse has signed. An unsigned check produces nothing, so a check that never happened is a missing resource rather than a resource full of blanks."
//
// GATE: (item.where(linkId = 'surgeonCheck').item.where(linkId = 'surgeonCheck.signed').answer.value = true) or (item.where(linkId = 'anaesthetistCheck').item.where(linkId = 'anaesthetistCheck.signed').answer.value = true) or (item.where(linkId = 'nurseCheck').where(item.where(linkId = 'nurseCheck.signed').answer.value = true).exists())
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractPeriOperativeChecklist(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Investigations reviewed before theatre ────────────────────────────────
  // Written once any of the three checks has been signed: a results panel on an
  // unsigned checklist is a draft. Each result is its own laboratory Observation
  // under its LOINC code; the ones the sheet takes as free text (electrolytes,
  // urea and creatinine, ECG and echo) are narrative Observations.
  qr where ((item.where(linkId = 'surgeonCheck').item.where(linkId = 'surgeonCheck.signed').answer.value = true) or (item.where(linkId = 'anaesthetistCheck').item.where(linkId = 'anaesthetistCheck.signed').answer.value = true) or (item.where(linkId = 'nurseCheck').where(item.where(linkId = 'nurseCheck.signed').answer.value = true).exists())) then {
    qr.item as g where (linkId = 'results') then {
      g.item as it where (linkId = 'results.haemoglobin' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '718-7' "cd";
            it -> cg.display = 'Hemoglobin [Mass/volume] in Blood' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_718_7_1";
      g.item as it where (linkId = 'results.haematocrit' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '4544-3' "cd";
            it -> cg.display = 'Hematocrit [Volume Fraction] of Blood by Automated count' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_4544_3_2";
      g.item as it where (linkId = 'results.platelets' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '777-3' "cd";
            it -> cg.display = 'Platelets [#/volume] in Blood by Automated count' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_777_3_3";
      g.item as it where (linkId = 'results.inr' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '6301-6' "cd";
            it -> cg.display = 'INR in Platelet poor plasma by Coagulation assay' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : decimal as v -> obs.value = create('Quantity') as qty then {
            v -> qty.value = v "qtyValue";
            v -> qty.unit = '{{INR}}' "qtyUnit";
            v -> qty.system = 'http://unitsofmeasure.org' "qtySystem";
            v -> qty.code = '{{INR}}' "qtyCode";
          } "quantity";
        } "answer";
      } "obs_6301_6_4";
      g.item as it where (linkId = 'results.wbc' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '6690-2' "cd";
            it -> cg.display = 'Leukocytes [#/volume] in Blood by Automated count' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_6690_2_5";
      g.item as it where (linkId = 'results.rbs' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '15074-8' "cd";
            it -> cg.display = 'Glucose [Moles/volume] in Blood' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_15074_8_6";
      g.item as it where (linkId = 'results.electrolytes' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'preop-electrolytes' "cd";
            it -> cg.display = 'Electrolytes reviewed before theatre' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_preop_electrolytes_7";
      g.item as it where (linkId = 'results.ureaCreatinine' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetLaboratoryCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'preop-urea-and-creatinine' "cd";
            it -> cg.display = 'Urea and creatinine reviewed before theatre' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_preop_urea_and_creatinine_8";
      g.item as it where (linkId = 'results.ecgEcho' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'preop-ecg-and-echo' "cd";
            it -> cg.display = 'ECG and echocardiogram reviewed before theatre' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_preop_ecg_and_echo_9";
      g.item as it where (linkId = 'results.imagingAvailable' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'preop-imaging-available' "cd";
            it -> cg.display = 'Imaging available before theatre' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
      } "obs_preop_imaging_available_10";
    } "resultsGroup";

    // ── The examination ───────────────────────────────────────────────────
    qr.item as g where (linkId = 'examination') then {
      g.item as bp where (linkId = 'examination.bloodPressure') then {
        bp where ((item.where(linkId = 'examination.bloodPressure.systolic').answer.value.ofType(Quantity).exists() or item.where(linkId = 'examination.bloodPressure.diastolic').answer.value.ofType(Quantity).exists())) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
          qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
          qr -> obs then SetVitalSignsCategory(qr, obs) "category";
          bp -> obs.code as cc then {
            bp -> cc.coding as cg then {
              bp -> cg.system = 'http://loinc.org' "sys";
              bp -> cg.code = '85354-9' "cd";
              bp -> cg.display = 'Blood pressure panel with all children optional' "dsp";
            } "coding";
          } "code";
          bp.item as ci where (linkId = 'examination.bloodPressure.systolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
            ci -> comp.code as cc then {
              ci -> cc.coding as cg then {
                ci -> cg.system = 'http://loinc.org' "sys";
                ci -> cg.code = '8480-6' "cd";
                ci -> cg.display = 'Systolic blood pressure' "dsp";
              } "coding";
            } "code";
            ci.answer first as a then {
              a.value : Quantity as v -> comp.value = v "value";
            } "answer";
          } "comp_8480_6_11";
          bp.item as ci where (linkId = 'examination.bloodPressure.diastolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
            ci -> comp.code as cc then {
              ci -> cc.coding as cg then {
                ci -> cg.system = 'http://loinc.org' "sys";
                ci -> cg.code = '8462-4' "cd";
                ci -> cg.display = 'Diastolic blood pressure' "dsp";
              } "coding";
            } "code";
            ci.answer first as a then {
              a.value : Quantity as v -> comp.value = v "value";
            } "answer";
          } "comp_8462_4_12";
        } "panel_85354_9_13";
      } "bloodPressureGroup";
      g.item as it where (linkId = 'examination.pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_8867_4_14";
      g.item as it where (linkId = 'examination.respiratoryRate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '9279-1' "cd";
            it -> cg.display = 'Respiratory rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_9279_1_15";
      g.item as it where (linkId = 'examination.temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8310-5' "cd";
            it -> cg.display = 'Body temperature' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
      } "obs_8310_5_16";
      g.item as it where (linkId = 'examination.breathSounds' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'preop-breath-sounds' "cd";
            it -> cg.display = 'Breath sounds before theatre' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_preop_breath_sounds_17";
      g.item as it where (linkId = 'examination.lmp' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8665-2' "cd";
            it -> cg.display = 'Last menstrual period start date' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
        } "answer";
      } "obs_8665_2_18";
      g.item as it where (linkId = 'examination.denturesLooseTeeth' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'anaes-dentition' "cd";
            it -> cg.display = 'Dentition' "dsp";
          } "coding";
          it -> cc.text = 'Dentures or loose teeth' "codeText";
        } "code";
        it.answer first as a then {
          a.value : string as v -> obs.value = v "value";
        } "answer";
      } "obs_anaes_dentition_19";
    } "examinationGroup";

    // ── Preparation ───────────────────────────────────────────────────────
    // One Observation with a component per preparation step, under the code the
    // surgical safety checklist already uses for the ward's preparation.
    qr.item as pg where (linkId = 'preparation' and item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      pg -> obs.code as cc then {
        pg -> cc.coding as cg then {
          pg -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          pg -> cg.code = 'preoperative-preparation' "cd";
          pg -> cg.display = 'Pre-operative preparation completed' "dsp";
        } "coding";
      } "code";
      pg.item as ci where (linkId = 'preparation.siteMarked' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'who-check-site-marked' "cd";
            ci -> cg.display = 'Site marked' "dsp";
          } "coding";
        } "code";
        ci -> comp then SetComponentCodedValue(ci, comp) "value";
      } "comp_who_check_site_marked_20";
      pg.item as ci where (linkId = 'preparation.implantsAvailable' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'preop-implants-available' "cd";
            ci -> cg.display = 'Implants available before theatre' "dsp";
          } "coding";
        } "code";
        ci -> comp then SetComponentCodedValue(ci, comp) "value";
      } "comp_preop_implants_available_21";
      pg.item as ci where (linkId = 'preparation.bloodAvailable' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'preop-blood-requested-and-available-before-theatre' "cd";
            ci -> cg.display = 'Blood requested and available before theatre' "dsp";
          } "coding";
        } "code";
        ci -> comp then SetComponentCodedValue(ci, comp) "value";
      } "comp_preop_blood_requested_and_available_before_theatre_22";
      pg.item as ci where (linkId = 'preparation.preoperativeTeaching' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'preop-teaching-done' "cd";
            ci -> cg.display = 'Pre-operative teaching done' "dsp";
          } "coding";
        } "code";
        ci -> comp then SetComponentCodedValue(ci, comp) "value";
      } "comp_preop_teaching_done_23";
      pg.item as ci where (linkId = 'preparation.informedConsent' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'preop-informed-consent-given' "cd";
            ci -> cg.display = 'Informed consent given before theatre' "dsp";
          } "coding";
        } "code";
        ci -> comp then SetComponentCodedValue(ci, comp) "value";
      } "comp_preop_informed_consent_given_24";
    } "preparationPanel";
  } "sharedSections";

  // ── The surgeon's and anaesthetist's checks ───────────────────────────────
  // Each a single Observation of fitness for theatre, at the time of the check,
  // written only when that clinician has signed it.
  qr.item as g where (linkId = 'surgeonCheck' and item.where(linkId = 'surgeonCheck.signed').answer.value = true) then {
    g.item as it where (linkId = 'surgeonCheck.fitForTheatre' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'preop-fit-for-theatre-surgeon' "cd";
          it -> cg.display = 'Fit for theatre (surgeon or medical practitioner)' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : boolean as v -> obs.value = v "value";
      } "answer";
      g -> obs then SetSurgeonCheckTime(g, obs) "rowTime";
    } "obs_preop_fit_for_theatre_surgeon_25";
  } "surgeonCheckGroup";
  qr.item as g where (linkId = 'anaesthetistCheck' and item.where(linkId = 'anaesthetistCheck.signed').answer.value = true) then {
    g.item as it where (linkId = 'anaesthetistCheck.fitForTheatre' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'preop-fit-for-theatre-anaesthetist' "cd";
          it -> cg.display = 'Fit for theatre (anaesthetist)' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : boolean as v -> obs.value = v "value";
      } "answer";
      g -> obs then SetAnaesthetistCheckTime(g, obs) "rowTime";
    } "obs_preop_fit_for_theatre_anaesthetist_26";
  } "anaesthetistCheckGroup";

  // ── The nurse's checks, on the ward and in theatre ────────────────────────
  // One Observation per signed check with a component per item, the stage (ward
  // or theatre) as its first component, plus the vital signs taken with it as
  // their own Observations at the check's time.
  qr.item as row where (linkId = 'nurseCheck' and item.where(linkId = 'nurseCheck.signed').answer.value = true) then {
    row -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      row -> obs.code as cc then {
        row -> cc.coding as cg then {
          row -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          row -> cg.code = 'preop-nurse-check' "cd";
          row -> cg.display = 'Peri-operative nursing check' "dsp";
        } "coding";
      } "code";
      row.item as ci where (linkId = 'nurseCheck.stage' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'preop-check-stage' "cd";
            ci -> cg.display = 'Peri-operative check stage' "dsp";
