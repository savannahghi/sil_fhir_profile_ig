/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractPlanOfCareNote"
/// name = "ExtractPlanOfCareNote"
/// title = "Plan of Care Note Extraction"
/// status = "active"
/// description = "One signed diary entry out as a plan-of-care Composition with a section per heading, attested by the signing author, so the page reads back as the doctor wrote it, plus a CarePlan whose description is the overall plan and whose period ends on the expected discharge date. Nothing is written until the sign-off is ticked: an unsigned entry is a draft. No Condition or Goal is minted -- the diary is prose, and the problem list is maintained elsewhere."
// GATE: item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value.ofType(boolean).first() = true and item.item.where((linkId = 'entry.admitted' or linkId = 'communication.record' or linkId = 'signoff.signed').not()).answer.value.exists()

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Composition" alias Composition as target
uses "http://hl7.org/fhir/StructureDefinition/CarePlan" alias CarePlan as target

group ExtractPlanOfCareNote(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Nothing until it is signed ──────────────────────────────────────────
  // The sign-off is the doctor's attestation. An entry saved without it is a
  // draft and writes nothing; ticking it and saving again writes everything.
  qr where (item.where(linkId = 'signoff').item.where(linkId = 'signoff.signed').answer.value.ofType(boolean).first() = true) then {

    // ── The diary page ──────────────────────────────────────────────────────
    // Written whenever anything of substance was answered: the yes/no questions
    // that open a section, and the sign-off itself, are navigation and attestation,
    // not content, and on their own make no entry. Its title is the entry type the doctor picked, so the list of a
    // stay's entries reads "Admission plan, Plan update, Discharge plan"; a
    // patient who is not admitted gets "Outpatient plan".
    qr where (item.item.where((linkId = 'entry.admitted' or linkId = 'communication.record' or linkId = 'signoff.signed').not()).answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Composition') as comp then {
      qr -> comp, entry then BuildCompositionBase(qr, comp, entry) "base";
      qr -> comp.status = 'final' "status";
      qr -> comp.type as ty then {
        qr -> ty.coding as sghi then {
          qr -> sghi.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/document-type-codesystem' "sghiSystem";
          qr -> sghi.code = 'plan-of-care-note' "sghiCode";
          qr -> sghi.display = 'Plan of care note' "sghiDisplay";
        } "sghiCoding";
        qr -> ty.coding as loinc then {
          qr -> loinc.system = 'http://loinc.org' "loincSystem";
          qr -> loinc.code = '18776-5' "loincCode";
          qr -> loinc.display = 'Plan of care note' "loincDisplay";
        } "loincCoding";
        qr -> ty.text = 'Plan of care note' "typeText";
      } "noteType";
      // The sign-off, as a professional attestation at the time the entry was
      // written. The party is the author where the profile allows one there.
      qr -> comp.attester as att then {
        qr -> att.mode as md then {
          qr -> md.coding as cg then {
            qr -> cg.system = 'http://hl7.org/fhir/composition-attestation-mode' "sys";
            qr -> cg.code = 'professional' "cd";
            qr -> cg.display = 'Professional' "dsp";
          } "coding";
        } "mode";
        qr.authored as t -> att.time = t "time";
        qr.author as au where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> att.party = au "party";
      } "attester";

      qr.item as g where (linkId = 'entry') then {
        g.item as it where (linkId = 'entry.type' and answer.value.ofType(Coding).display.exists()) then {
          it.answer first as a then {
            a.value as cv then {
              cv.display as d -> comp.title = d "titleFromEntryType";
            } "coding";
          } "answer";
        } "typeRule";
        g.item as it where (linkId = 'entry.summary' and answer.value.exists()) -> comp.section as sec then {
          it -> sec.title = 'Overall plan' "summaryTitle";
          it -> sec then AddSectionText(it, sec) "summaryText";
        } "summaryRule";
      } "entryGroup";
      qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.type').answer.value.ofType(Coding).display.exists().not() and item.where(linkId = 'entry').item.where(linkId = 'entry.admitted').answer.value.ofType(boolean).first() = false) -> comp.title = 'Outpatient plan' "titleOutpatient";
      qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.type').answer.value.ofType(Coding).display.exists().not() and (item.where(linkId = 'entry').item.where(linkId = 'entry.admitted').answer.value.ofType(boolean).first() = false).not()) -> comp.title = 'Plan of care note' "titleFallback";

      qr.item as g where (linkId = 'discharge' and item.where(linkId = 'discharge.expectedDate' or linkId = 'discharge.criteria' or linkId = 'discharge.followUp').answer.value.exists()) -> comp.section as sec then {
        g -> sec.title = 'Discharge planning' "dischargeTitle";
        g -> sec.text as narrative then {
          g -> narrative.status = 'generated' "narrativeStatus";
          g -> narrative.div = create('xhtml') as xhtml then {
            g -> xhtml.value = evaluate(g, '<div xmlns="http://www.w3.org/1999/xhtml">' + iif(item.where(linkId = 'discharge.expectedDate').answer.value.exists(), '<p><b>Expected discharge:</b> ' + item.where(linkId = 'discharge.expectedDate').answer.value.first().toString() + '</p>', '') + iif(item.where(linkId = 'discharge.criteria').answer.value.exists(), '<p><b>Ready for discharge when:</b> ' + item.where(linkId = 'discharge.criteria').answer.value.first().toString().escape('html') + '</p>', '') + iif(item.where(linkId = 'discharge.followUp').answer.value.exists(), '<p><b>Follow-up:</b> ' + item.where(linkId = 'discharge.followUp').answer.value.first().toString().escape('html') + '</p>', '') + '</div>') "narrativeDiv";
          } "narrativeXhtml";
        } "dischargeNarrative";
      } "dischargeSection";

      qr.item as g where (linkId = 'communication' and item.where(linkId = 'communication.patientInformed' or linkId = 'communication.familyInformed' or linkId = 'communication.familyName' or linkId = 'communication.preferences').answer.value.exists()) -> comp.section as sec then {
        g -> sec.title = 'Communication' "communicationTitle";
        g -> sec.text as narrative then {
          g -> narrative.status = 'generated' "narrativeStatus";
          g -> narrative.div = create('xhtml') as xhtml then {
            g -> xhtml.value = evaluate(g, '<div xmlns="http://www.w3.org/1999/xhtml">' + iif(item.where(linkId = 'communication.patientInformed').answer.value.exists(), '<p><b>Discussed with the patient:</b> ' + iif(item.where(linkId = 'communication.patientInformed').answer.value.first(), 'Yes', 'No') + '</p>', '') + iif(item.where(linkId = 'communication.familyInformed').answer.value.exists(), '<p><b>Discussed with family or caregiver:</b> ' + iif(item.where(linkId = 'communication.familyInformed').answer.value.first(), 'Yes', 'No') + iif(item.where(linkId = 'communication.familyName').answer.value.exists(), ' (' + item.where(linkId = 'communication.familyName').answer.value.first().toString().escape('html') + ')', '') + '</p>', '') + iif(item.where(linkId = 'communication.preferences').answer.value.exists(), '<p><b>Patient\'s wishes and concerns:</b> ' + item.where(linkId = 'communication.preferences').answer.value.first().toString().escape('html') + '</p>', '') + '</div>') "narrativeDiv";
          } "narrativeXhtml";
        } "communicationNarrative";
      } "communicationSection";
    } "note";

    // ── The structured plan ─────────────────────────────────────────────────
    // One CarePlan per entry that has an overall plan or discharge details. Its
    // title is the entry type and its description the overall plan the doctor
    // wrote; the expected discharge date closes its period.
    qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.summary').answer.value.exists() or item.where(linkId = 'discharge').item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('CarePlan') as plan then {
      qr -> plan, entry then BuildCarePlanBase(qr, plan, entry) "base";
      qr -> plan.status = 'active' "status";
      qr -> plan.intent = 'plan' "intent";
      qr -> plan.category as cat then {
        qr -> cat.coding as cg then {
          qr -> cg.system = 'http://loinc.org' "sys";
          qr -> cg.code = '18776-5' "cd";
          qr -> cg.display = 'Plan of care note' "dsp";
        } "coding";
      } "category";

      qr.item as g where (linkId = 'entry') then {
        g.item as it where (linkId = 'entry.type' and answer.value.ofType(Coding).display.exists()) then {
          it.answer first as a then {
            a.value as cv then {
              cv.display as d -> plan.title = d "titleFromEntryType";
            } "coding";
          } "answer";
        } "typeRule";
        g.item as it where (linkId = 'entry.summary' and answer.value.exists()) then {
          it.answer first as a then {
            a.value as txt -> plan.description = txt "descriptionFromSummary";
          } "answer";
        } "summaryRule";
      } "entryGroup";
      // The profile wants both a title and a description; these stand in when the
      // doctor left the entry type or the overall plan blank.
      qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.type').answer.value.ofType(Coding).display.exists().not() and item.where(linkId = 'entry').item.where(linkId = 'entry.admitted').answer.value.ofType(boolean).first() = false) -> plan.title = 'Outpatient plan' "titleOutpatient";
      qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.type').answer.value.ofType(Coding).display.exists().not() and (item.where(linkId = 'entry').item.where(linkId = 'entry.admitted').answer.value.ofType(boolean).first() = false).not()) -> plan.title = 'Plan of care' "titleFallback";
      qr where (item.where(linkId = 'entry').item.where(linkId = 'entry.summary').answer.value.exists().not()) -> plan.description = 'Recorded on the plan of care note.' "descriptionFallback";

      qr.item as g where (linkId = 'discharge') then {
        // The expected discharge date closes the plan's period. A date on the
        // form, a dateTime on the plan: midnight at the start of that day, in
        // the facility's own offset.
        g.item as it where (linkId = 'discharge.expectedDate' and answer.value.exists()) then {
          it.answer first as a then {
            a.value as v where ($this.toString().length() = 10) -> evaluate(v, $this.toString() + 'T00:00:00+03:00') as midnight, plan.period as per, per.end = cast(midnight, 'dateTime') "periodEnd";
          } "answer";
        } "expectedDateRule";
        g.item as it where (linkId = 'discharge.criteria' and answer.value.exists()) then {
          it.answer first as a then {
            a.value as txt -> plan.note as n, n.text = evaluate(txt, 'Ready for discharge when: ' + $this) "criteriaNote";
          } "answer";
        } "criteriaRule";
        g.item as it where (linkId = 'discharge.followUp' and answer.value.exists()) then {
          it.answer first as a then {
            a.value as txt -> plan.note as n, n.text = evaluate(txt, 'Follow-up: ' + $this) "followUpNote";
          } "answer";
        } "followUpRule";
      } "dischargeGroup";
    } "carePlan";

  } "signedOnly";
}

// One answered text item -> the section's narrative, as the prose was written.
group AddSectionText(source it, target sec) {
  it.answer first as a then {
    a.value as v -> sec.text as narrative then {
      v -> narrative.status = 'generated' "narrativeStatus";
      v -> narrative.div = create('xhtml') as xhtml then {
        v -> xhtml.value = evaluate(a, '<div xmlns="http://www.w3.org/1999/xhtml"><p>' + value.toString().escape('html') + '</p></div>') "narrativeDiv";
      } "narrativeXhtml";
    } "sectionText";
  } "answer";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildCompositionBase(source qr : QR, target r : Composition, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetCompositionFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Composition' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> r.subject = s "subject";
  qr -> r.relatesTo as rel then {
    qr -> rel.type = 'derived-from' "relatesToType";
    qr -> rel.resourceReference = create('Reference') as ref then {
      qr.id as qid where ($this.hasValue()) -> ref.reference = qid "relatesToRef";
    } "relatesToTarget";
  } "linkQuestionnaireResponse";
  qr -> r then ConformComposition(qr, r) "profileConformance";
}

group SetCompositionFullUrl(source r : Composition, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Composition/', id) "assignFullUrl";
}

group BuildCarePlanBase(source qr : QR, target r : CarePlan, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetCarePlanFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'CarePlan' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = s "subject";
  qr -> r then ConformCarePlan(qr, r) "profileConformance";
}

group SetCarePlanFullUrl(source r : CarePlan, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/CarePlan/', id) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'plan-of-care-note' "provenanceCode";
      qr -> t.display = 'Plan of care note' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformComposition(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = e "encounter";
  qr -> r.name = 'plan-of-care-note' "name";
  // Composition.date is 1..1. `authored` is only 0..1 on the response, so when a
  // client sends none the extraction time stands in.
  qr.authored as t -> r.date = t "date";
  qr where (authored.exists().not()) then {
    qr -> r.date = evaluate(qr, now()) "dateFromExtractionTime";
  } "dateFallback";
  qr.author as au where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> r.author = au "authorFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization'))))) -> r.author = src "authorFromSource";
  } "authorFallback";
}

group ConformCarePlan(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = e "encounter";
  qr.authored as t -> r.created = t "created";
  qr.questionnaire as qc -> r.instantiatesCanonical = qc "instantiatesCanonical";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = au "custodianFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = src "custodianFromSource";
  } "custodianFallback";
}

