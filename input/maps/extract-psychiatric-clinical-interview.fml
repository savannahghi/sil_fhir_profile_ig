/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractPsychiatricClinicalInterview"
/// name = "ExtractPsychiatricClinicalInterview"
/// title = "Psychiatric Clinical Interview Extraction"
/// status = "active"
/// description = "The psychiatric clinical interview out as: the reason for referral (LOINC 42349-1) with its source as a component; one Observation per history section under LOINC; the mental status examination as one Observation with a component per domain, and thoughts of suicide or self-harm and of harm to others as their own Observations, so risk is findable without unpacking the examination; the physical examination, case summary, psychological formulation and intervention as Observations; each provisional and each differential diagnosis as a Condition under the ICD-11 code chosen on the form; and the plan as a CarePlan."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Condition" alias Condition as target
uses "http://hl7.org/fhir/StructureDefinition/CarePlan" alias CarePlan as target

group ExtractPsychiatricClinicalInterview(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Referral: the reason, with the source as a component ───────────────────
  qr.item as g where (linkId = 'referral') then {
    g where (item.where(linkId = 'referral/reason').answer.value.ofType(string).exists() or item.where(linkId = 'referral/source').answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      g -> obs.code as cc then {
        g -> cc.coding as cg then {
          g -> cg.system = 'http://loinc.org' "sys";
          g -> cg.code = '42349-1' "cd";
          g -> cg.display = 'Reason for referral (narrative)' "dsp";
        } "coding";
        g -> cc.text = 'Reason for referral' "text";
      } "code";
      g.item as it where (linkId = 'referral/reason' and answer.value.ofType(string).exists()) then {
        it -> obs then SetText(it, obs) "value";
      } "reason";
      g.item as it where (linkId = 'referral/source' and answer.value.ofType(Coding).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'psychology-referral-source' "cd";
            it -> cg.display = 'Referral source' "dsp";
          } "coding";
          it -> cc.text = 'Referral source' "text";
        } "code";
        it -> comp then CopyCoding(it, comp) "value";
      } "source";
      g.item as ot where (linkId = 'referral/source-other' and answer.value.ofType(string).exists()) then {
        ot.answer first as oa then {
          oa.value as t -> obs.note as n, n.text = append('Other referral source: ', t) "otherSource";
        } "answer";
      } "otherSourceNote";
    } "referral";
  } "referralGroup";

  // ── History: one Observation per section, under LOINC ──────────────────────
  qr.item as g where (linkId = 'history') then {
    g.item as it where (linkId = 'history/presenting' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '10164-2' "cd";
          it -> cg.display = 'History of Present illness Narrative' "dsp";
        } "coding";
        it -> cc.text = 'History of presenting illness' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "presenting";
    g.item as it where (linkId = 'history/past-psychiatric' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11358-9' "cd";
          it -> cg.display = 'History of Psychiatric disorders Narrative' "dsp";
        } "coding";
        it -> cc.text = 'Past psychiatric and psychological history' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "past_psychiatric";
    g.item as it where (linkId = 'history/past-medical' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11348-0' "cd";
          it -> cg.display = 'History of Past illness note' "dsp";
        } "coding";
        it -> cc.text = 'Past medical history' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "past_medical";
    g.item as it where (linkId = 'history/family' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '10157-6' "cd";
          it -> cg.display = 'History of family member diseases note' "dsp";
        } "coding";
        it -> cc.text = 'Family history' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "family";
    g.item as it where (linkId = 'history/social' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSocialHistoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '29762-2' "cd";
          it -> cg.display = 'Social history note' "dsp";
        } "coding";
        it -> cc.text = 'Social history' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "social";
    g.item as it where (linkId = 'history/personal' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSocialHistoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '106921-0' "cd";
          it -> cg.display = 'Social or personal history' "dsp";
        } "coding";
        it -> cc.text = 'Personal history' "text";
      } "code";
      it -> obs then SetText(it, obs) "value";
    } "personal";
  } "history";

  // ── Mental status examination: one Observation, a component per domain ─────
  qr.item as g where (linkId = 'mse') then {
    g where (item.where(linkId = 'mse/appearance' or linkId = 'mse/behaviour' or linkId = 'mse/speech' or linkId = 'mse/mood' or linkId = 'mse/affect' or linkId = 'mse/perception' or linkId = 'mse/thought-form' or linkId = 'mse/thought-content' or linkId = 'mse/judgement' or linkId = 'mse/cognition' or linkId = 'mse/insight').answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      g -> obs.code as cc then {
        g -> cc.coding as cg then {
          g -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
          g -> cg.code = 'mental-state-examination' "cd";
          g -> cg.display = 'Mental state examination' "dsp";
        } "coding";
        g -> cc.text = 'Mental status examination' "text";
      } "code";
      g.item as it where (linkId = 'mse/appearance' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.appearance' "cd";
            it -> cg.display = 'Appearance' "dsp";
          } "coding";
          it -> cc.text = 'Appearance' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "appearance";
      g.item as it where (linkId = 'mse/behaviour' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.behaviour' "cd";
            it -> cg.display = 'Behaviour' "dsp";
          } "coding";
          it -> cc.text = 'Behaviour' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "behaviour";
      g.item as it where (linkId = 'mse/speech' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.speech' "cd";
            it -> cg.display = 'Voice, speech and language' "dsp";
          } "coding";
          it -> cc.text = 'Speech' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "speech";
      g.item as it where (linkId = 'mse/mood' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.mood' "cd";
            it -> cg.display = 'Mood' "dsp";
          } "coding";
          it -> cc.text = 'Mood' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "mood";
      g.item as it where (linkId = 'mse/affect' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.affect' "cd";
            it -> cg.display = 'Affect' "dsp";
          } "coding";
          it -> cc.text = 'Affect' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "affect";
      g.item as it where (linkId = 'mse/perception' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.perception' "cd";
            it -> cg.display = 'Perception' "dsp";
          } "coding";
          it -> cc.text = 'Perception' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "perception";
      g.item as it where (linkId = 'mse/thought-form' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.thoughtForm' "cd";
            it -> cg.display = 'Thought form (process)' "dsp";
          } "coding";
          it -> cc.text = 'Thought form (process)' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "thought_form";
      g.item as it where (linkId = 'mse/thought-content' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.thoughtContent' "cd";
            it -> cg.display = 'Thought content' "dsp";
          } "coding";
          it -> cc.text = 'Thought content' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "thought_content";
      g.item as it where (linkId = 'mse/judgement' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.judgement' "cd";
            it -> cg.display = 'Judgement' "dsp";
          } "coding";
          it -> cc.text = 'Judgement' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "judgement";
      g.item as it where (linkId = 'mse/cognition' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.cognition' "cd";
            it -> cg.display = 'Cognitive processes' "dsp";
          } "coding";
          it -> cc.text = 'Cognition' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "cognition";
      g.item as it where (linkId = 'mse/insight' and answer.value.ofType(string).exists()) -> obs.component as comp then {
        it -> comp.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
            it -> cg.code = 'mse.insight' "cd";
            it -> cg.display = 'Insight' "dsp";
          } "coding";
          it -> cc.text = 'Insight' "text";
        } "code";
        it -> comp then SetText(it, comp) "value";
      } "insight";
    } "mse";
    g.item as it where (linkId = 'mse/suicidal-thoughts' and answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
          it -> cg.code = 'suicidal-thoughts-observed' "cd";
          it -> cg.display = 'Suicidal thoughts observed at interview' "dsp";
        } "coding";
        it -> cc.text = 'Suicidal thoughts observed at interview' "text";
      } "code";
      it -> obs then CopyCoding(it, obs) "value";
      g.item as ra where (linkId = 'mse/risk-assessment' and answer.value.ofType(string).exists()) then {
        ra.answer first as a then {
          a.value as t -> obs.note as n, n.text = t "riskAssessment";
        } "answer";
      } "riskAssessmentNote";
    } "suicidal_thoughts";
    g.item as it where (linkId = 'mse/harm-to-others' and answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetExamCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
          it -> cg.code = 'harm-to-others-thoughts-observed' "cd";
          it -> cg.display = 'Thoughts of harming others observed at interview' "dsp";
        } "coding";
        it -> cc.text = 'Thoughts of harming others observed at interview' "text";
      } "code";
      it -> obs then CopyCoding(it, obs) "value";
      g.item as ra where (linkId = 'mse/risk-assessment' and answer.value.ofType(string).exists()) then {
        ra.answer first as a then {
          a.value as t -> obs.note as n, n.text = t "riskAssessment";
        } "answer";
      } "riskAssessmentNote";
    } "harm_to_others";
  } "mse";

  // ── Examination, summary, formulation and intervention ─────────────────────
  qr.item as it where (linkId = 'examination' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetExamCategory(qr, obs) "category";
    it -> obs.code as cc then {
      it -> cc.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '29545-1' "cd";
        it -> cg.display = 'Physical findings note' "dsp";
      } "coding";
      it -> cc.text = 'Physical examination' "text";
    } "code";
    it -> obs then SetText(it, obs) "value";
  } "examination";
  qr.item as it where (linkId = 'summary' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetExamCategory(qr, obs) "category";
    it -> obs.code as cc then {
      it -> cc.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '51848-0' "cd";
        it -> cg.display = 'Evaluation note' "dsp";
      } "coding";
      it -> cc.text = 'Case summary' "text";
    } "code";
    it -> obs then SetText(it, obs) "value";
  } "summary";
  qr.item as it where (linkId = 'formulation' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetExamCategory(qr, obs) "category";
    it -> obs.code as cc then {
      it -> cc.coding as cg then {
        it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/mental-wellness-codesystem' "sys";
        it -> cg.code = 'clinical-formulation' "cd";
        it -> cg.display = 'Clinical formulation' "dsp";
      } "coding";
      it -> cc.text = 'Psychological formulation' "text";
    } "code";
    it -> obs then SetText(it, obs) "value";
  } "formulation";
  qr.item as it where (linkId = 'intervention' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
    qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
    qr -> obs then SetTherapyCategory(qr, obs) "category";
    it -> obs.code as cc then {
      it -> cc.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '47042-7' "cd";
        it -> cg.display = 'Counseling note' "dsp";
      } "coding";
      it -> cc.text = 'Intervention / counselling' "text";
    } "code";
    it -> obs then SetText(it, obs) "value";
  } "intervention";

  // ── Impression: a Condition per provisional and per differential diagnosis ────
  qr.item as g where (linkId = 'impression') then {
    g.item as row where (linkId = 'impression/provisional') then {
      row.item as it where (linkId = 'impression/provisional/diagnosis' and answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Condition') as cond then {
        qr -> cond, entry then BuildConditionBase(qr, cond, entry) "base";
        it -> cond.clinicalStatus as cs then {
          it -> cs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "sys";
            it -> cg.code = 'active' "cd";
            it -> cg.display = 'Active' "dsp";
          } "coding";
        } "clinicalStatus";
        it -> cond.verificationStatus as vs then {
          it -> vs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-ver-status' "sys";
            it -> cg.code = 'provisional' "cd";
            it -> cg.display = 'Provisional' "dsp";
          } "coding";
        } "verificationStatus";
        it -> cond.category as cat then {
          it -> cat.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "sys";
            it -> cg.code = 'encounter-diagnosis' "cd";
            it -> cg.display = 'Encounter Diagnosis' "dsp";
          } "coding";
        } "category";
        // The ICD-11 code chosen from the search, with its display as the text.
        // A code only: these fields were never free text, so unlike the nursing
        // care plan's there are no saved words to read back, and a wrong-typed
        // answer makes no Condition.
        it.answer first as a then {
          a.value as c where ($this is Coding) -> cond.code as cc then {
            c -> cc.coding = c "icd11Coding";
            c.display as d -> cc.text = d "icd11Text";
          } "codedDiagnosis";
        } "answer";
      } "provisional";
    } "provisionalRow";
    g.item as row where (linkId = 'impression/differential') then {
      row.item as it where (linkId = 'impression/differential/diagnosis' and answer.value.ofType(Coding).exists()) -> bundle.entry as entry, entry.resource = create('Condition') as cond then {
        qr -> cond, entry then BuildConditionBase(qr, cond, entry) "base";
        it -> cond.clinicalStatus as cs then {
          it -> cs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-clinical' "sys";
            it -> cg.code = 'active' "cd";
            it -> cg.display = 'Active' "dsp";
          } "coding";
        } "clinicalStatus";
        it -> cond.verificationStatus as vs then {
          it -> vs.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-ver-status' "sys";
            it -> cg.code = 'differential' "cd";
            it -> cg.display = 'Differential' "dsp";
          } "coding";
        } "verificationStatus";
        it -> cond.category as cat then {
          it -> cat.coding as cg then {
            it -> cg.system = 'http://terminology.hl7.org/CodeSystem/condition-category' "sys";
            it -> cg.code = 'encounter-diagnosis' "cd";
            it -> cg.display = 'Encounter Diagnosis' "dsp";
          } "coding";
        } "category";
        // The ICD-11 code chosen from the search, with its display as the text.
        // A code only: these fields were never free text, so unlike the nursing
        // care plan's there are no saved words to read back, and a wrong-typed
        // answer makes no Condition.
        it.answer first as a then {
          a.value as c where ($this is Coding) -> cond.code as cc then {
            c -> cc.coding = c "icd11Coding";
            c.display as d -> cc.text = d "icd11Text";
          } "codedDiagnosis";
        } "answer";
      } "differential";
    } "differentialRow";
  } "impression";

  // ── Plan and recommendations ───────────────────────────────────────────────
  qr.item as it where (linkId = 'plan' and answer.value.ofType(string).exists()) -> bundle.entry as entry, entry.resource = create('CarePlan') as plan then {
    qr -> plan, entry then BuildCarePlanBase(qr, plan, entry) "base";
    it -> plan.status = 'active' "status";
    it -> plan.intent = 'plan' "intent";
    it -> plan.title = 'Plan and recommendations from the psychiatric clinical interview' "title";
    it -> plan.category as cat then {
      it -> cat.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '18776-5' "cd";
        it -> cg.display = 'Plan of care note' "dsp";
      } "coding";
    } "category";
    it.answer first as a then {
      a.value as t -> plan.description = t "description";
    } "answer";
  } "plan";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr -> obs.status = 'final' "status";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";
  // The hasValue() guard stops an unsaved response, posted straight to $extract,
  // from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source r : Observation, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

group BuildConditionBase(source qr : QR, target r : Condition, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetConditionFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Condition' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = s "subject";
  qr -> r then ConformCondition(qr, r) "profileConformance";
}

group SetConditionFullUrl(source r : Condition, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Condition/', id) "assignFullUrl";
}

group BuildCarePlanBase(source qr : QR, target r : CarePlan, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetCarePlanFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'CarePlan' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = s "subject";
  qr -> r then ConformCarePlan(qr, r) "profileConformance";
}

group SetCarePlanFullUrl(source r : CarePlan, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/CarePlan/', id) "assignFullUrl";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetSocialHistoryCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'social-history' "categoryCode";
      qr -> coding.display = 'Social History' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetExamCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'exam' "categoryCode";
      qr -> coding.display = 'Exam' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetTherapyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'therapy' "categoryCode";
      qr -> coding.display = 'Therapy' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// A string answer, as written.
group SetText(source it, target t) {
  it.answer first as a then {
    a.value as v -> t.value = v "value";
  } "answer";
}

// A coded answer kept as the coding the client sent, its display as the text.
group CopyCoding(source it, target t) {
  it.answer first as a then {
    a.value as cv -> t.value = create('CodeableConcept') as vc then {
      cv -> vc.coding = cv "valueCoding";
      cv.display as d -> vc.text = d "valueText";
    } "codedValue";
  } "answer";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'psychiatric-clinical-interview' "provenanceCode";
      qr -> t.display = 'Psychiatric clinical interview' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

// A participant in the author role. The actor is the response's author, or its
// source when it has no author.
group AuthorParticipant(source who, target p) {
  who as w -> p.actor = w "actor";
  who -> p.function as fn then {
    who -> fn.coding as cg then {
      who -> cg.system = 'http://terminology.hl7.org/CodeSystem/provenance-participant-type' "sys";
      who -> cg.code = 'author' "cd";
      who -> cg.display = 'Author' "dsp";
    } "coding";
  } "function";
}

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}

group ConformCondition(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = e "encounter";
  qr.authored as t -> r.recordedDate = t "recordedDate";
  qr.author as au where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.participant as p then AuthorParticipant(au, p) "participantFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.participant as p then AuthorParticipant(src, p) "participantFromSource";
  } "participantFallback";
}

group ConformCarePlan(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.contains('://').not() and reference.startsWith('#').not() and reference.startsWith('urn:').not())) or reference.empty())) -> r.encounter = e "encounter";
  qr.authored as t -> r.created = t "created";
  qr.questionnaire as qc -> r.instantiatesCanonical = qc "instantiatesCanonical";
  qr -> r.title = 'Care plan from the psychiatric clinical interview' "title";
  qr -> r.description = 'Recorded on the psychiatric clinical interview.' "description";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = au "custodianFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = src "custodianFromSource";
  } "custodianFallback";
}
