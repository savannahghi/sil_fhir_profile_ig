/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractPsychologicalReview"
/// name = "ExtractPsychologicalReview"
/// title = "Psychological Review Extraction"
/// status = "active"
/// description = "A SOAP note extracts as a ClinicalImpression whose summary is the assessment -- that is what ClinicalImpression.summary is for -- with the subjective and objective sections as Observations under LOINC 61150-9 and 61149-1 that the impression names in supportingInfo, and the plan as a CarePlan. Four resources rather than one narrative, because the point of SOAP is that a reader can find the assessment without reading the subjective account first, and because a plan a counsellor set at session four is a thing the next session has to review. LOINC has Subjective and Objective Narrative but no plain Assessment or Plan term, so those two carry local concept codes."

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/ClinicalImpression" alias ClinicalImpression as target
uses "http://hl7.org/fhir/StructureDefinition/CarePlan" alias CarePlan as target

group ExtractPsychologicalReview(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // The impression is anchored on the note itself, not on the session header.
  // The reviewed form has no 'session' group; a map that waited for it built
  // nothing but the plan. A response that still carries the header (an older
  // form version) gets the impression as before.
  qr where (item.where(linkId = 'session').exists() or item.where((linkId = 'subjective' or linkId = 'objective' or linkId = 'assessment') and answer.value.exists()).exists()) -> bundle.entry as entry, entry.resource = create('ClinicalImpression') as ci then {
    qr -> ci, entry then BuildClinicalImpressionBase(qr, ci, entry) "base";
    qr -> ci.status = 'completed' "status";
    qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> ci.encounter = e "encounter";
    qr.authored as t -> ci.date = t "date";
    qr -> ci.description = 'Psychological review, counselling session' "description";

    // The session header, where the response has one.
    qr.item as g where (linkId = 'session') then {
      // The counsellor is the performer, from the form's own signature line
      // rather than from qr.source: the person who keys a session note in is
      // not necessarily the person who held the session.
      g.item as it where (linkId = 'session/counsellor' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ci.performer = ref "performer";
        } "answer";
      } "counsellorRule";

      // Effective time is the session date. A note written up a week later is
      // still a note about that session.
      g.item as it where (linkId = 'session/date' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as v -> ci.effective = cast(v, 'dateTime') "effective";
        } "answer";
      } "sessionDateRule";
      g.item as it where (linkId = 'session/designation' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as txt -> ci.note as n, n.text = txt "designationNote";
        } "answer";
      } "designationRule";
      g.item as it where (linkId = 'session/ward-or-clinic' and answer.value.exists()) then {
        it.answer first as a then {
          a.value as txt -> ci.note as n, n.text = txt "wardNote";
        } "answer";
      } "wardRule";
    } "sessionDetails";

    // Without a counsellor on the form, the performer is the response's
    // author, else its source, where that is a type the element accepts.
    qr where (item.where(linkId = 'session').item.where(linkId = 'session/counsellor' and answer.value.exists()).exists().not()) then {
      qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ci.performer = au "performerFromAuthor";
      qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
        qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ci.performer = src "performerFromSource";
      } "performerSourceFallback";
    } "performerFallback";

    // Without a session date, the session is taken as the one the response
    // was written at.
    qr where (item.where(linkId = 'session').item.where(linkId = 'session/date' and answer.value.exists()).exists().not()) then {
      qr.authored as t -> ci.effective = t "effectiveFromAuthored";
    } "effectiveFallback";

    // The assessment as the impression's summary. This is the one section
    // with a native home on the resource, and putting it anywhere else would
    // leave ClinicalImpression.summary empty on an impression.
    qr.item as it where (linkId = 'assessment' and answer.value.exists()) then {
      it.answer first as a then {
        a.value as txt -> ci.summary = txt "summary";
      } "answer";
    } "assessmentRule";

    // The subjective and objective sections, created here so the impression
    // can name them. A reference to a resource created in a sibling rule is
    // not reachable -- the target variable does not exist there -- so they
    // have to be built inside this rule.
    qr.item as it where (linkId = 'subjective' and answer.value.exists()) -> bundle.entry as sentry, sentry.resource = create('Observation') as sobs then {
      qr -> sobs, sentry then BuildObsBase(qr, sobs, sentry) "base";
      qr -> sobs then SetSurveyCategory(qr, sobs) "category";
      it -> sobs.code as scc then {
        it -> scc.coding as scg then {
          it -> scg.system = 'http://loinc.org' "sys";
          it -> scg.code = '61150-9' "cd";
          it -> scg.display = 'Subjective Narrative' "dsp";
        } "coding";
        it -> scc.text = 'What the client reported at this session' "codeText";
      } "code";
      // The narrative is the Observation's value, so a reader of value[x] finds it.
      it.answer first as a then {
        a.value as txt where ($this is string) -> sobs.value = txt "text";
      } "answer";
      it -> ci.supportingInfo = create('Reference') as sref, sref.reference = reference(sobs) "linkSupporting";
    } "soap_subjective";

    qr.item as it where (linkId = 'objective' and answer.value.exists()) -> bundle.entry as sentry, sentry.resource = create('Observation') as sobs then {
      qr -> sobs, sentry then BuildObsBase(qr, sobs, sentry) "base";
      qr -> sobs then SetSurveyCategory(qr, sobs) "category";
      it -> sobs.code as scc then {
        it -> scc.coding as scg then {
          it -> scg.system = 'http://loinc.org' "sys";
          it -> scg.code = '61149-1' "cd";
          it -> scg.display = 'Objective Narrative' "dsp";
        } "coding";
        it -> scc.text = 'What the counsellor observed at this session' "codeText";
      } "code";
      // The narrative is the Observation's value, so a reader of value[x] finds it.
      it.answer first as a then {
        a.value as txt where ($this is string) -> sobs.value = txt "text";
      } "answer";
      it -> ci.supportingInfo = create('Reference') as sref, sref.reference = reference(sobs) "linkSupporting";
    } "soap_objective";

  } "psychologicalImpression";

  // ── The session number ──────────────────────────────────────────────────
  // Its own Observation. A counselling episode is a series and "which session
  // was this" is the question every review of that series starts from; there
  // is nowhere on ClinicalImpression that a query would find it.
  qr.item as g where (linkId = 'session') then {
    g.item as it where (linkId = 'session/number' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'soap-counselling-session-number' "cd";
          it -> cg.display = 'Counselling session number' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value as v -> obs.value = v "set";
      } "answer";
    } "measure_soap_component";

  } "sessionNumberGroup";

  // ── The plan ────────────────────────────────────────────────────────────
  // A CarePlan, because what a counsellor agrees at the end of a session is
  // what the next session opens by reviewing. As a note on the impression it
  // would be findable only by reading the last note.
  qr.item as it where (linkId = 'plan' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('CarePlan') as plan then {
    qr -> plan, entry then BuildCarePlanBase(qr, plan, entry) "base";
    it -> plan.status = 'active' "status";
    it -> plan.intent = 'plan' "intent";
    it -> plan.title = 'Plan agreed at psychological review' "title";
    qr.authored as t -> plan.created = t "created";
    qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> plan.encounter = e "encounter";
    it -> plan.category as cat then {
      it -> cat.coding as cg then {
        it -> cg.system = 'http://loinc.org' "sys";
        it -> cg.code = '18776-5' "cd";
        it -> cg.display = 'Plan of care note' "dsp";
      } "coding";
    } "category";
    it.answer first as a then {
      a.value as txt -> plan.description = txt "description";
    } "answer";
    qr.item as g where (linkId = 'session') then {
      g.item as c where (linkId = 'session/counsellor' and answer.value.exists()) then {
        c.answer first as a then {
          a.value as ref where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Device/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Organization/') or reference.startsWith('CareTeam/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Device') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/CareTeam'))))) -> plan.contributor = ref "contributor";
        } "answer";
      } "counsellorRule";
    } "sessionGroupForPlan";
    // No counsellor on the form: the contributor is the response's author,
    // else its source.
    qr where (item.where(linkId = 'session').item.where(linkId = 'session/counsellor' and answer.value.exists()).exists().not()) then {
      qr.author as au where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Device/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Organization/') or reference.startsWith('CareTeam/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Device') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/CareTeam'))))) -> plan.contributor = au "contributorFromAuthor";
      qr where (author.where(((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Device/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Organization/') or reference.startsWith('CareTeam/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Device') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/CareTeam'))))).exists().not()) then {
        qr.source as src where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/') or reference.startsWith('Device/') or reference.startsWith('RelatedPerson/') or reference.startsWith('Organization/') or reference.startsWith('CareTeam/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole') or ('/' + type).endsWith('/Device') or ('/' + type).endsWith('/RelatedPerson') or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/CareTeam'))))) -> plan.contributor = src "contributorFromSource";
      } "contributorSourceFallback";
    } "contributorFallback";
  } "psychologicalPlan";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Two notes on what the publisher's StructureMap validator says about this file.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = s "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = e "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The hasValue() guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.hasValue()) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group SetComponentValue(source it, target comp) {
  it.answer first as a then {
    a.value as v -> comp.value = v "plainValue";
  } "componentAnswer";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group BuildClinicalImpressionBase(source qr : QR, target r : ClinicalImpression, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetClinicalImpressionFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'ClinicalImpression' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/') or reference.startsWith('Group/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Group'))))) -> r.subject = s "subject";
  // The response's own time as a floor (a rule reading the form's own date
  // overwrites effective), its encounter, and who wrote the note, by the
  // identity rule: the author, else the source. The note had none of them.
  qr.authored as t -> r.date = t "date";
  qr.authored as t -> r.effective = t "effectiveFallback";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = e "encounter";
  qr.author as au where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}

group SetClinicalImpressionFullUrl(source r : ClinicalImpression, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/ClinicalImpression/', id) "assignFullUrl";
}

group BuildCarePlanBase(source qr : QR, target r : CarePlan, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr -> r.id = uuid() then SetCarePlanFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'CarePlan' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = s "subject";
  qr -> r then ConformCarePlan(qr, r) "profileConformance";
}

group SetCarePlanFullUrl(source r : CarePlan, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/CarePlan/', id) "assignFullUrl";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
//
// The code is the form's document type, not the questionnaire's id: every
// environment mints its own ids, and there is only one set of maps, so an id
// here would tie the tag to whichever environment stamped it.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'psychological-review' "provenanceCode";
      qr -> t.display = 'Psychological review notes' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}

// ── Conformance to the IG profiles ───────────────────────────────────────────
//
// What the IG's profiles require that the response itself can supply. Called at
// the end of each base group. The encounter and every who-element are the
// response's own; see mapmeta.py for what is and is not here.
// ── Conformance to the IG profiles ───────────────────────────────────────────

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = au "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = src "performerFromSource";
  } "performerFallback";
}

group ConformCarePlan(source qr : QR, target r) {
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> r.encounter = e "encounter";
  qr.authored as t -> r.created = t "created";
  qr.questionnaire as qc -> r.instantiatesCanonical = qc "instantiatesCanonical";
  qr -> r.title = 'Care plan from the psychological review notes' "title";
  qr -> r.description = 'Recorded on the psychological review notes.' "description";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = au "custodianFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.custodian = src "custodianFromSource";
  } "custodianFallback";
}
