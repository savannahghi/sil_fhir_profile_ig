/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractStandardTreatmentConsent"
/// name = "ExtractStandardTreatmentConsent"
/// title = "Standard Treatment Consent Extraction"
/// status = "active"
/// description = "The standard consent for medical investigation, treatment or operation as one Consent, written only once the patient or their representative has agreed and signed, with a provision per authorisation actually given: the procedure itself, each type of anaesthesia proposed, the additional-procedures and tissue-disposal clauses when ticked, and anything the patient asked not to be done without consultation. The surgeon who explained it (and the anaesthetist, where one signed) is the verifier; who signed is the grantor; the signing method and the witness ride along as provisions; and the date is the signing date on the form, not the transcription time."
//
// GATE: (item.where(linkId = 'patient').item.where(linkId = 'patient.signature.signed').answer.value = true) and (item.where(linkId = 'patient').item.where(linkId = 'patient.agree').answer.value = true)
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Consent" alias Consent as target

group ExtractStandardTreatmentConsent(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── The Consent ─────────────────────────────────────────────────────────
  // Guarded on the person consenting having agreed and signed. A Consent built
  // from a half-filled form asserts a permission that was never given.
  qr where ((item.where(linkId = 'patient').item.where(linkId = 'patient.signature.signed').answer.value = true) and (item.where(linkId = 'patient').item.where(linkId = 'patient.agree').answer.value = true)) -> bundle.entry as entry, entry.resource = create('Consent') as consent then {
    qr -> consent, entry then BuildConsentBase(qr, consent, entry) "base";
    qr -> consent.status = 'active' "status";
    qr -> consent.decision = 'permit' "decision";
    qr -> consent.category as cat then {
      qr -> cat.coding as cg then {
        qr -> cg.system = 'http://loinc.org' "sys";
        qr -> cg.code = '64293-4' "cd";
        qr -> cg.display = 'Procedure consent Document' "dsp";
      } "coding";
    } "category";

    // ── What the doctor proposed ──────────────────────────────────────────
    // The operation, investigation or treatment is the first provision; each
    // type of anaesthesia proposed is a provision of its own, so a consent to a
    // regional block cannot be read as consent to a general anaesthetic.
    qr.item as dg where (linkId = 'doctor') then {
      dg.item as it where (linkId = 'doctor.procedure' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.provision as prov, prov.code as pc, pc.text = txt "provisionText";
        } "answer";
      } "provision_doctor_procedure_1";
      dg.item as it where (linkId = 'doctor.anaesthesia') then {
        it.answer as a -> consent.provision as prov then {
          a.value : Coding as cv -> prov.code as pc then {
            cv -> pc.coding = cv "anaesthesiaCoding";
            cv.display as d -> pc.text = append('Anaesthesia proposed: ', d) "anaesthesiaText";
          } "anaesthesiaCode";
        } "anaesthesiaProvision";
      } "anaesthesiaRule";
      // The surgeon who explained the procedure and signed becomes the verifier,
      // dated to the doctor's date on the form.
      dg where (item.where(linkId = 'doctor.explained').answer.value = true and item.where(linkId = 'doctor.surgeonSigned').answer.value = true) then {
        dg.item as it where (linkId = 'doctor.surgeon' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : Reference as ref -> consent.verification as ver then {
              ref -> ver.verified = true "verified";
              ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ver.verifiedBy = create('Reference') as vb then {
                ref.reference as v -> vb.reference = v "reference";
                ref.type as v -> vb.type = v "type";
                ref.identifier as v -> vb.identifier = v "identifier";
                ref.display as v -> vb.display = v "display";
              } "verifiedBy";
              qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> ver.verifiedWith = create('Reference') as vw then {
                s.reference as v -> vw.reference = v "reference";
                s.type as v -> vw.type = v "type";
                s.identifier as v -> vw.identifier = v "identifier";
                s.display as v -> vw.display = v "display";
              } "verifiedWith";
              dg.item as dt where (linkId = 'doctor.date' and answer.value.exists()) then {
                dt.answer first as da then {
                  da.value : date as d -> ver.verificationDate = cast(d, 'dateTime') "verificationDate";
                } "dateAnswer";
              } "verificationDate_2";
            } "verification";
          } "answer";
        } "verification_doctor_surgeon_3";
      } "surgeonVerification";
      dg where (item.where(linkId = 'doctor.anaesthetistSigned').answer.value = true) then {
        dg.item as it where (linkId = 'doctor.anaesthetist' and answer.value.exists()) then {
          it.answer first as a then {
            a.value : Reference as ref -> consent.verification as ver then {
              ref -> ver.verified = true "verified";
              ref where (((reference.exists() and (reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> ver.verifiedBy = create('Reference') as vb then {
                ref.reference as v -> vb.reference = v "reference";
                ref.type as v -> vb.type = v "type";
                ref.identifier as v -> vb.identifier = v "identifier";
                ref.display as v -> vb.display = v "display";
              } "verifiedBy";
              qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> ver.verifiedWith = create('Reference') as vw then {
                s.reference as v -> vw.reference = v "reference";
                s.type as v -> vw.type = v "type";
                s.identifier as v -> vw.identifier = v "identifier";
                s.display as v -> vw.display = v "display";
              } "verifiedWith";
              dg.item as dt where (linkId = 'doctor.date' and answer.value.exists()) then {
                dt.answer first as da then {
                  da.value : date as d -> ver.verificationDate = cast(d, 'dateTime') "verificationDate";
                } "dateAnswer";
              } "verificationDate_4";
            } "verification";
          } "answer";
        } "verification_doctor_anaesthetist_5";
      } "anaesthetistVerification";
    } "doctorGroup";

    // ── What the patient agreed to ────────────────────────────────────────
    qr.item as pg where (linkId = 'patient') then {
      // Who consented becomes the grantor: the patient themselves, or the person who
      // signed on their behalf by name (and relationship) when someone else did.
      pg.item as it where (linkId = 'patient.signer' and answer.value.ofType(Coding).code = 'consenter-patient') then {
        qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> consent.grantor = create('Reference') as gr then {
          s.reference as v -> gr.reference = v "reference";
          s.type as v -> gr.type = v "type";
          s.identifier as v -> gr.identifier = v "identifier";
          s.display as v -> gr.display = v "display";
        } "grantorPatient";
      } "patientSignerRule";
      pg.item as it where (linkId = 'patient.signerName' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.grantor = create('Reference') as ref, ref.display = txt "grantorDisplay";
        } "answer";
      } "signerNameRule";
      pg.item as it where (linkId = 'patient.signer' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : Coding as cv -> consent.provision as prov, prov.code as pc then {
            cv -> pc.coding = cv "signerCoding";
            cv.display as d -> pc.text = d "signerText";
          } "signerProvision";
        } "answer";
      } "signerRule";
      pg.item as it where (linkId = 'patient.relationship' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.provision as prov, prov.code as pc, pc.text = append('Relationship to the patient: ', txt) "relationshipProvision";
        } "answer";
      } "relationshipRule";
      pg.item as it where (linkId = 'patient.additionalProcedures' and answer.value = true) -> consent.provision as prov then {
        it -> prov.code as pc, pc.text = 'Any procedures in addition to the investigation or treatment described, found necessary and in the patient\'s best interests during the procedure' "provisionText";
      } "provision_patient_additionalProcedures_6";
      pg.item as it where (linkId = 'patient.tissueDisposal' and answer.value = true) -> consent.provision as prov then {
        it -> prov.code as pc, pc.text = 'Disposal by the hospital authority of any body tissue or organ removed' "provisionText";
      } "provision_patient_tissueDisposal_7";
      pg.item as it where (linkId = 'patient.proceduresNotWanted' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.provision as prov, prov.code as pc, pc.text = append('Not to be carried out without being consulted first: ', txt) "provisionText";
        } "answer";
      } "provision_patient_proceduresNotWanted_8";
      // How the consent was signed (OTP, fingerprint, signed form, verbal), as a
      // provision so the record says what kind of signature stands behind it.
      pg.item as it where (linkId = 'patient.signature.method' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : Coding as cv -> consent.provision as prov, prov.code as pc then {
            cv -> pc.coding = cv "methodCoding";
            cv.display as d -> pc.text = append('Signed by: ', d) "methodText";
          } "methodProvision";
        } "answer";
      } "signingMethodRule";
      pg.item as it where (linkId = 'patient.signature.witnessName' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : string as txt -> consent.provision as prov, prov.code as pc, pc.text = append('Witnessed by: ', txt) "witnessProvision";
        } "answer";
      } "witnessRule";
      // The signing date from the form, not qr.authored: a consent taken the
      // evening before theatre and transcribed the next morning would otherwise
      // be dated to the transcription, which is the one date a dispute turns on.
      pg.item as it where (linkId = 'patient.signature.date' and answer.value.exists()) then {
        it.answer first as a then {
          a.value : date as d -> consent.date = d "signedDate";
        } "answer";
      } "signedDateRule";
    } "patientGroup";

    // ── Day surgery conditions ────────────────────────────────────────────
    // Recorded as one provision when the admission is a day case and all three
    // conditions were accepted.
    qr.item as ds where (linkId = 'daySurgery' and item.where(linkId = 'daySurgery.applies').answer.value = true and item.where(linkId = 'daySurgery.fasted').answer.value = true and item.where(linkId = 'daySurgery.escort').answer.value = true and item.where(linkId = 'daySurgery.restrictions').answer.value = true) -> consent.provision as prov then {
      ds -> prov.code as pc, pc.text = 'Day surgery conditions accepted: fasted as advised, a responsible person arranged to collect and stay with the patient, and no alcohol, driving, machinery or important decisions for 24 hours' "daySurgeryText";
    } "daySurgeryProvision";
  } "createConsent";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildConsentBase(source qr : QR, target r : Consent, target entry) {
  qr -> r then SetResponseProvenance(qr, r) "responseProvenance";
  qr.id as qid where ($this.toString().length() > 0) -> r.sourceReference = create('Reference') as srcRef, srcRef.reference = qid "linkQuestionnaireResponse";
  qr -> r.id = uuid() then SetConsentFullUrl(r, entry) "idAndFullUrl";
  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Consent' "requestUrl";
  } "entryRequest";
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> r.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr -> r then ConformConsent(qr, r) "profileConformance";
}

group SetConsentFullUrl(source r : Consent, target entry) {
  r.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Consent/', id) "assignFullUrl";
}

group ConformConsent(source qr : QR, target r) {
  qr.authored as t -> evaluate(t, $this.toString().substring(0, 10)) as day, r.date = cast(day, 'date') "date";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.grantee = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "granteeFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.grantee = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "granteeFromSource";
  } "granteeFallback";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'standard-treatment-consent' "provenanceCode";
      qr -> t.display = 'Standard consent for medical investigation, treatment or operation' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
