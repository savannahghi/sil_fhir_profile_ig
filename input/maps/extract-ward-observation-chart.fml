/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractWardObservationChart"
/// name = "ExtractWardObservationChart"
/// title = "Ward Observation Chart Extraction"
/// status = "active"
/// description = "One Observation per measured value per round, charted at the round\'s own time: the vital signs under their LOINC codes with the blood pressure paired, the pain score and blood sugar, the admission and post-operative day counts, the lines, tubes and bowels as one Observation with a component per event, and the position and state of the skin as examination findings. Blank cells produce nothing, so a chart with one temperature yields one Observation."
//
// GATE: item.where(linkId = 'reading').descendants().where(linkId != 'reading.dateTime').answer.value.exists()
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target

group ExtractWardObservationChart(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Each reading, at its own time ─────────────────────────────────────────
  // One Observation per measured value per round, charted at the round's time.
  // The blood pressure is paired; everything else is its own resource so a
  // temperature search finds temperatures and nothing else.
  qr.item as row where (linkId = 'reading') then {
    row.item as bp where (linkId = 'reading.bloodPressure') then {
      bp where ((item.where(linkId = 'reading.bloodPressure.systolic').answer.value.ofType(Quantity).exists() or item.where(linkId = 'reading.bloodPressure.diastolic').answer.value.ofType(Quantity).exists())) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        bp -> obs.code as cc then {
          bp -> cc.coding as cg then {
            bp -> cg.system = 'http://loinc.org' "sys";
            bp -> cg.code = '85354-9' "cd";
            bp -> cg.display = 'Blood pressure panel with all children optional' "dsp";
          } "coding";
        } "code";
        bp.item as ci where (linkId = 'reading.bloodPressure.systolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
          ci -> comp.code as cc then {
            ci -> cc.coding as cg then {
              ci -> cg.system = 'http://loinc.org' "sys";
              ci -> cg.code = '8480-6' "cd";
              ci -> cg.display = 'Systolic blood pressure' "dsp";
            } "coding";
          } "code";
          ci.answer first as a then {
            a.value : Quantity as v -> comp.value = v "value";
          } "answer";
        } "comp_8480_6_8";
        bp.item as ci where (linkId = 'reading.bloodPressure.diastolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
          ci -> comp.code as cc then {
            ci -> cc.coding as cg then {
              ci -> cg.system = 'http://loinc.org' "sys";
              ci -> cg.code = '8462-4' "cd";
              ci -> cg.display = 'Diastolic blood pressure' "dsp";
            } "coding";
          } "code";
          ci.answer first as a then {
            a.value : Quantity as v -> comp.value = v "value";
          } "answer";
        } "comp_8462_4_9";
        row -> obs then SetReadingTime(row, obs) "rowTime";
      } "panel_85354_9_10";
    } "bloodPressureGroup";
    row.item as it where (linkId = 'reading.pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8867-4' "cd";
          it -> cg.display = 'Heart rate' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_8867_4_11";
    row.item as it where (linkId = 'reading.temperature' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '8310-5' "cd";
          it -> cg.display = 'Body temperature' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_8310_5_12";
    row.item as it where (linkId = 'reading.respiratoryRate' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '9279-1' "cd";
          it -> cg.display = 'Respiratory rate' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_9279_1_13";
    row.item as it where (linkId = 'reading.spo2' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetVitalSignsCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '59408-5' "cd";
          it -> cg.display = 'Oxygen saturation in Arterial blood by Pulse oximetry' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_59408_5_14";
    row.item as it where (linkId = 'reading.painScore' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '72514-3' "cd";
          it -> cg.display = 'Pain severity - 0-10 verbal numeric rating [Score] - Reported' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_72514_3_15";
    row.item as it where (linkId = 'reading.bloodSugar' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetLaboratoryCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '15074-8' "cd";
          it -> cg.display = 'Glucose [Moles/volume] in Blood' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : Quantity as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_15074_8_16";
    row.item as it where (linkId = 'reading.admissionDay' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'obs-day-in-unit' "cd";
          it -> cg.display = 'Day in unit' "dsp";
        } "coding";
        it -> cc.text = 'Admission day' "codeText";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_obs_day_in_unit_17";
    row.item as it where (linkId = 'reading.postOpDay' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'postoperative-day' "cd";
          it -> cg.display = 'Post-operative day' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "obs_postoperative_day_18";

    // Lines, tubes and bowels at this reading: one Observation with a component
    // per event ticked, so a catheter change is findable against the round.
    row.item as ev where (linkId = 'reading.events' and item.answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      ev -> obs.code as cc then {
        ev -> cc.coding as cg then {
          ev -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          ev -> cg.code = 'ward-lines-tubes-and-bowels' "cd";
          ev -> cg.display = 'Lines, tubes and bowels at a ward round' "dsp";
        } "coding";
      } "code";
      ev.item as ci where (linkId = 'reading.events.urinaryCatheterInserted' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-urinary-catheter-inserted' "cd";
            ci -> cg.display = 'Urinary catheter inserted' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_urinary_catheter_inserted_1";
      ev.item as ci where (linkId = 'reading.events.urinaryCatheterRemoved' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-urinary-catheter-removed' "cd";
            ci -> cg.display = 'Urinary catheter removed' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_urinary_catheter_removed_2";
      ev.item as ci where (linkId = 'reading.events.ivLineInserted' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-iv-line-inserted' "cd";
            ci -> cg.display = 'IV line inserted' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_iv_line_inserted_3";
      ev.item as ci where (linkId = 'reading.events.ivLineRemoved' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-iv-line-removed' "cd";
            ci -> cg.display = 'IV line removed' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_iv_line_removed_4";
      ev.item as ci where (linkId = 'reading.events.cvLineInserted' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-cv-line-inserted' "cd";
            ci -> cg.display = 'Central venous line inserted' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_cv_line_inserted_5";
      ev.item as ci where (linkId = 'reading.events.ngTubeInserted' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'ward-event-ng-tube-inserted' "cd";
            ci -> cg.display = 'Nasogastric tube inserted' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_ward_event_ng_tube_inserted_6";
      ev.item as ci where (linkId = 'reading.events.stoolPassed' and answer.value.exists()) -> obs.component as comp then {
        ci -> comp.code as cc then {
          ci -> cc.coding as cg then {
            ci -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            ci -> cg.code = 'fluid-balance-stool-passed' "cd";
            ci -> cg.display = 'Stool passed' "dsp";
          } "coding";
        } "code";
        ci.answer first as a then {
          a.value : boolean as v -> comp.value = v "value";
        } "answer";
      } "comp_fluid_balance_stool_passed_7";
      row -> obs then SetReadingTime(row, obs) "rowTime";
    } "eventsPanel";

    row.item as pg where (linkId = 'reading.position') then {
      pg.item as it where (linkId = 'reading.position.position' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'icu-care-position-of-the-patient' "cd";
            it -> cg.display = 'Position of the patient' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "rowTime";
      } "obs_icu_care_position_of_the_patient_19";
      pg.item as it where (linkId = 'reading.position.skin' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'ward-state-of-skin' "cd";
            it -> cg.display = 'State of the skin' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetReadingTime(row, obs) "rowTime";
      } "obs_ward_state_of_skin_20";
    } "positionGroup";
  } "readingRow";
}

group SetReadingTime(source row, target obs : Observation) {
  row.item as it where (linkId = 'reading.dateTime' and answer.value.exists()) then {
    it.answer first as a then {
      a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "effective";
    } "answer";
  } "timeRule";
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared scaffolding. Repeated in each map rather than imported: the transform
// engine resolves `imports` against whatever StructureMaps happen to be on the
// server, and a form that stops extracting because a shared map was not
// uploaded is a worse failure than a duplicated group.
//
// Source parameters below are left untyped on purpose. Writing `: Element` makes
// the validator compare QuestionnaireResponse.item against the literal 'Element'
// and report them as incompatible with each other, which is noise, not a finding.
//
// `evaluate(context, expression)` is flagged as "takes 1 parameter but 2 were
// found". Leave it. The FML parser in the same jar refuses the one-argument form
// outright -- it wants a parameter, a comma, then the FHIRPath -- so the
// publisher is objecting to what its own compiler emits. Two arguments is the
// only form that compiles, and it is what the R5 transform engine executes.
// ─────────────────────────────────────────────────────────────────────────────

group BuildObsBase(source qr : QR, target obs : Observation, target entry) {
  qr -> obs then SetResponseProvenance(qr, obs) "responseProvenance";
  qr -> obs.id = uuid() then SetObservationFullUrl(obs, entry) "idAndFullUrl";

  qr -> entry.request as request then {
    qr -> request.method = 'POST' "requestMethod";
    qr -> request.url = 'Observation' "requestUrl";
  } "entryRequest";

  qr -> obs.status = 'final' "status";
  // The response's subject is Reference(Any); the guard keeps Patients and the
  // copy, field by field, is what satisfies a type checker that cannot see the
  // guard. Same for the encounter.
  qr.subject as s where (((reference.exists() and (reference.startsWith('Patient/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Patient'))))) -> obs.subject = create('Reference') as ref then {
    s.reference as v -> ref.reference = v "reference";
    s.type as v -> ref.type = v "type";
    s.identifier as v -> ref.identifier = v "identifier";
    s.display as v -> ref.display = v "display";
  } "subject";
  qr.encounter as e where (((reference.exists() and (reference.startsWith('Encounter/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Encounter'))))) -> obs.encounter = create('Reference') as ref then {
    e.reference as v -> ref.reference = v "reference";
    e.type as v -> ref.type = v "type";
    e.identifier as v -> ref.identifier = v "identifier";
    e.display as v -> ref.display = v "display";
  } "encounter";

  // A stored response's id already reads "QuestionnaireResponse/<id>", so it is
  // a relative reference as it stands. The length guard is what stops an
  // unsaved response -- one posted straight to $extract rather than saved first
  // -- from writing "QuestionnaireResponse/null" into the record.
  qr.id as qid where ($this.toString().length() > 0) -> obs.derivedFrom = create('Reference') as ref, ref.reference = qid "linkQuestionnaireResponse";
  qr -> obs then ConformObservation(qr, obs) "profileConformance";
}

group SetObservationFullUrl(source obs : Observation, target entry) {
  obs.id as id -> entry.fullUrl = append('https://fhir.slade360.co.ke/fhir/Observation/', id) "assignFullUrl";
}

// The two answer shapes a component can carry. Both read the answer through the
// untyped `.value` accessor: reading `valueCoding` or `valueQuantity` by its
// typed property name fails at transform time on HAPI R5 with "Attempt to read
// invalid property ... on QuestionnaireResponse.item.answer".
group SetComponentCodedValue(source it, target comp) {
  it.answer first as a then {
    a.value : Coding as cv -> comp.value = create('CodeableConcept') as cc then {
      cv -> cc.coding = cv "valueCoding";
      cv.display as d -> cc.text = d "valueText";
    } "codedValue";
  } "componentAnswer";
}

group ConformObservation(source qr : QR, target r) {
  qr.authored as t where ($this.toString().length() >= 20) -> r.issued = cast(t, 'instant') "issued";
  qr.authored as t -> r.effective = t "effective";
  qr.author as au where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
    au.reference as v -> ref.reference = v "reference";
    au.type as v -> ref.type = v "type";
    au.identifier as v -> ref.identifier = v "identifier";
    au.display as v -> ref.display = v "display";
  } "performerFromAuthor";
  qr where (author.where(((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))).exists().not()) then {
    qr.source as src where (((reference.exists() and (reference.startsWith('Organization/') or reference.startsWith('Patient/') or reference.startsWith('Practitioner/') or reference.startsWith('PractitionerRole/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization') or ('/' + type).endsWith('/Patient') or ('/' + type).endsWith('/Practitioner') or ('/' + type).endsWith('/PractitionerRole'))))) -> r.performer = create('Reference') as ref then {
      src.reference as v -> ref.reference = v "reference";
      src.type as v -> ref.type = v "type";
      src.identifier as v -> ref.identifier = v "identifier";
      src.display as v -> ref.display = v "display";
    } "performerFromSource";
  } "performerFallback";
}

group SetSurveyCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'survey' "categoryCode";
      qr -> coding.display = 'Survey' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetVitalSignsCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'vital-signs' "categoryCode";
      qr -> coding.display = 'Vital Signs' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetLaboratoryCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'laboratory' "categoryCode";
      qr -> coding.display = 'Laboratory' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

group SetExamCategory(source qr : QR, target obs : Observation) {
  qr -> obs.category as cat then {
    qr -> cat.coding as coding then {
      qr -> coding.system = 'http://terminology.hl7.org/CodeSystem/observation-category' "categorySystem";
      qr -> coding.code = 'exam' "categoryCode";
      qr -> coding.display = 'Exam' "categoryDisplay";
    } "categoryCoding";
  } "category";
}

// ── Provenance and tenancy ───────────────────────────────────────────────────
//
// Two tags on everything this map creates. The first says which questionnaire
// produced it, so a form that reopens mid-admission recalls its own earlier
// entries and not another form's. The second copies the tenant tags off the
// response, because nothing else on the path puts them there. The response's
// identifier is copied the same way.
// ── Provenance and tenancy ───────────────────────────────────────────────────

group SetResponseProvenance(source qr : QR, target r) {
  qr -> r.meta as m then {
    qr -> m.tag as t then {
      qr -> t.system = 'http://slade360edi.com/questionnaire-provenance' "provenanceSystem";
      qr -> t.code = 'ward-observation-chart' "provenanceCode";
      qr -> t.display = 'Ward observation chart' "provenanceDisplay";
    } "provenanceTag";
  } "provenanceMeta";

  // Every tag the response carries, onto the resource. `meta` is 0..1, so this
  // lands on the same meta the rule above created rather than a second one.
  qr.meta as qm then {
    qm.tag as qt -> r.meta as m, m.tag = qt "copyTag";
  } "tenantTags";

  // The response's identifiers, as they are. Every profile wants one, and it is
  // the response's to give: nothing here mints one, so a response without an
  // identifier extracts resources without one. One whose assigner is not of a
  // type the profiles allow there is left behind whole, not altered.
  qr.identifier as qid where (assigner.empty() or assigner.where(((reference.exists() and (reference.startsWith('Organization/'))) or (reference.empty() and (type.empty() or ('/' + type).endsWith('/Organization'))))).exists()) -> r.identifier = qid "identifier";
}
