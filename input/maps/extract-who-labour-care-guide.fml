/// url = "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractWhoLabourCareGuide"
/// name = "ExtractWhoLabourCareGuide"
/// title = "WHO Labour Care Guide Extraction"
/// status = "active"
/// description = "One Observation per answer, coded like the labour-care-guide row it is charted on: the labour details once, and every hourly value at its own time -- supportive care, the baby (the fetal heart rate with the guide\'s alert as its interpretation and reference range, decelerations, liquor, position, caput and moulding each flagged abnormal at the guide\'s alert value), the woman (pulse and temperature with their alert ranges, the blood pressure paired, urine protein and acetone), contractions, cervical dilatation and descent, the medication columns and the assessment and plan. The summary of labour, once recorded, adds the stage facts, the mother\'s observations, the baby\'s facts (on the mother\'s record, with a note saying so; no Patient is minted for the newborn) and the delivery as an obstetric Procedure coded by its mode."
//
// GATE: (item.where(linkId = 'labour').item.answer.value.exists()) or (item.where(linkId = 'hour').descendants().where(linkId != 'hour.time' and linkId != 'hour.stage' and linkId != 'hour.hourNumber').answer.value.exists()) or (item.where(linkId = 'summary').item.where(linkId = 'summary.record').answer.value = true)
//
// The extraction gate: a FHIRPath over the QuestionnaireResponse that is
// true exactly when this map will produce at least one resource. Tooling
// evaluates it to predict extraction without running the transform; keep it
// in step with the creation guards below.

uses "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse" alias QR as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target
uses "http://hl7.org/fhir/StructureDefinition/Observation" alias Observation as target
uses "http://hl7.org/fhir/StructureDefinition/Procedure" alias Procedure as target

group ExtractWhoLabourCareGuide(source qr : QR, target bundle : Bundle) {
  qr -> bundle.type = 'transaction' "setBundleType";

  // ── Labour details, once ──────────────────────────────────────────────
  qr.item as g where (linkId = 'labour') then {
    g.item as it where (linkId = 'labour.parity' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11977-6' "cd";
          it -> cg.display = 'Parity' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
    } "obs_11977_6_1";
    g.item as it where (linkId = 'labour.gravida' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '11996-6' "cd";
          it -> cg.display = 'Pregnancies' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : integer as v -> obs.value = v "value";
      } "answer";
    } "obs_11996_6_2";
    g.item as it where (linkId = 'labour.onset' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'labour-began' "cd";
          it -> cg.display = 'Labour began' "dsp";
        } "coding";
      } "code";
      it -> obs.value = true "happened";
      it.answer first as a then {
        a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
      } "answer";
    } "obs_labour_began_3";
    g.item as it where (linkId = 'labour.activeLabourDiagnosis' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-active-labour' "cd";
          it -> cg.display = 'Active first stage of labour diagnosed' "dsp";
        } "coding";
      } "code";
      it -> obs.value = true "happened";
      it.answer first as a then {
        a.value : dateTime as v where ($this.toString().length() >= 20) -> obs.effective = v "when";
      } "answer";
    } "obs_lcg_active_labour_4";
    g.item as it where (linkId = 'labour.rupturedMembranes' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'http://loinc.org' "sys";
          it -> cg.code = '56829-5' "cd";
          it -> cg.display = 'Ruptured membranes' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : date as v -> obs.value = cast(v, 'dateTime') "value";
      } "answer";
    } "obs_56829_5_5";
    g.item as it where (linkId = 'labour.riskFactors' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
      qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
      qr -> obs then SetSurveyCategory(qr, obs) "category";
      it -> obs.code as cc then {
        it -> cc.coding as cg then {
          it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
          it -> cg.code = 'lcg-risk-factors' "cd";
          it -> cg.display = 'Risk factors in labour' "dsp";
        } "coding";
      } "code";
      it.answer first as a then {
        a.value : string as v -> obs.value = v "value";
      } "answer";
    } "obs_lcg_risk_factors_6";
  } "labourGroup";

  // ── Each hour, charted at its own time ────────────────────────────────
  // One Observation per charted value, coded like the labour-care-guide row it
  // is charted on, at the hour's time. The stage and hour number ride on each
  // as notes are not needed: the time orders them. Empty cells produce nothing.
  qr.item as row where (linkId = 'hour') then {
    row.item as g where (linkId = 'hour.supportiveCare') then {
      g.item as it where (linkId = 'hour.supportiveCare.companion' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-companion' "cd";
            it -> cg.display = 'Companion present' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_companion_7";
      g.item as it where (linkId = 'hour.supportiveCare.painRelief' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-pain-relief' "cd";
            it -> cg.display = 'Pain relief' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_pain_relief_8";
      g.item as it where (linkId = 'hour.supportiveCare.oralFluid' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-oral-fluid' "cd";
            it -> cg.display = 'Oral fluid' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_oral_fluid_9";
      g.item as it where (linkId = 'hour.supportiveCare.posture' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetSurveyCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-posture' "cd";
            it -> cg.display = 'Posture' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_posture_10";
    } "supportiveCareGroup";

    row.item as g where (linkId = 'hour.baby') then {
      // The fetal heart rate carries the guide's alert as its interpretation.
      g.item as it where (linkId = 'hour.baby.baselineFhr' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '55283-6' "cd";
            it -> cg.display = 'Fetal Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        it -> obs.referenceRange as rr then {
          it -> rr.low = create('Quantity') as lo then {
            it -> lo.value = '110' "loValue";
            it -> lo.unit = 'beats/min' "loUnit";
            it -> lo.system = 'http://unitsofmeasure.org' "loSystem";
            it -> lo.code = '/min' "loCode";
          } "low";
          it -> rr.high = create('Quantity') as hi then {
            it -> hi.value = '159' "hiValue";
            it -> hi.unit = 'beats/min' "hiUnit";
            it -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
            it -> hi.code = '/min' "hiCode";
          } "high";
          it -> rr.text = 'WHO Labour Care Guide: alert below 110 or at 160 and above' "rrText";
        } "referenceRange";
        it.answer first as a then {
          a.value : Quantity as v where ($this.value < 110) -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'L' "cd";
              v -> icg.display = 'Low' "dsp";
            } "coding";
          } "interp_11";
        } "interpAnswer_12";
        it.answer first as a then {
          a.value : Quantity as v where ($this.value >= 160) -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'H' "cd";
              v -> icg.display = 'High' "dsp";
            } "coding";
          } "interp_13";
        } "interpAnswer_14";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_55283_6_15";
      g.item as it where (linkId = 'hour.baby.fhrDeceleration' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-fhr-deceleration' "cd";
            it -> cg.display = 'Fetal heart rate deceleration' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        it.answer first as a then {
          a.value : Coding as v where (code = 'fhr-decel-late') -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'A' "cd";
              v -> icg.display = 'Abnormal' "dsp";
            } "coding";
          } "interp_16";
        } "interpAnswer_17";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_fhr_deceleration_18";
      g.item as it where (linkId = 'hour.baby.amnioticFluid' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-amniotic-fluid' "cd";
            it -> cg.display = 'Amniotic fluid' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        it.answer first as a then {
          a.value : Coding as v where (code = 'amniotic-meconium-thick' or code = 'amniotic-blood') -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'A' "cd";
              v -> icg.display = 'Abnormal' "dsp";
            } "coding";
          } "interp_19";
        } "interpAnswer_20";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_amniotic_fluid_21";
      g.item as it where (linkId = 'hour.baby.fetalPosition' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-fetal-position' "cd";
            it -> cg.display = 'Fetal position' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        it.answer first as a then {
          a.value : Coding as v where (code = 'fetal-position-posterior' or code = 'fetal-position-transverse') -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'A' "cd";
              v -> icg.display = 'Abnormal' "dsp";
            } "coding";
          } "interp_22";
        } "interpAnswer_23";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_fetal_position_24";
      g.item as it where (linkId = 'hour.baby.caput' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-caput' "cd";
            it -> cg.display = 'Caput' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        it.answer first as a then {
          a.value : Coding as v where (code = 'plus-3') -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'A' "cd";
              v -> icg.display = 'Abnormal' "dsp";
            } "coding";
          } "interp_25";
        } "interpAnswer_26";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_caput_27";
      g.item as it where (linkId = 'hour.baby.moulding' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetExamCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'https://fhir.slade360.co.ke/fhir/CodeSystem/concept-codesystem' "sys";
            it -> cg.code = 'lcg-moulding' "cd";
            it -> cg.display = 'Moulding' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Coding as cv -> obs.value = create('CodeableConcept') as vc then {
            cv -> vc.coding = cv "valueCoding";
            cv.display as d -> vc.text = d "valueText";
          } "codedValue";
        } "answer";
        it.answer first as a then {
          a.value : Coding as v where (code = 'plus-3') -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'A' "cd";
              v -> icg.display = 'Abnormal' "dsp";
            } "coding";
          } "interp_28";
        } "interpAnswer_29";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_lcg_moulding_30";
    } "babyGroup";

    row.item as g where (linkId = 'hour.woman') then {
      g.item as it where (linkId = 'hour.woman.pulse' and answer.value.ofType(Quantity).exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        it -> obs.code as cc then {
          it -> cc.coding as cg then {
            it -> cg.system = 'http://loinc.org' "sys";
            it -> cg.code = '8867-4' "cd";
            it -> cg.display = 'Heart rate' "dsp";
          } "coding";
        } "code";
        it.answer first as a then {
          a.value : Quantity as v -> obs.value = v "value";
        } "answer";
        it -> obs.referenceRange as rr then {
          it -> rr.low = create('Quantity') as lo then {
            it -> lo.value = '60' "loValue";
            it -> lo.unit = 'beats/min' "loUnit";
            it -> lo.system = 'http://unitsofmeasure.org' "loSystem";
            it -> lo.code = '/min' "loCode";
          } "low";
          it -> rr.high = create('Quantity') as hi then {
            it -> hi.value = '119' "hiValue";
            it -> hi.unit = 'beats/min' "hiUnit";
            it -> hi.system = 'http://unitsofmeasure.org' "hiSystem";
            it -> hi.code = '/min' "hiCode";
          } "high";
          it -> rr.text = 'WHO Labour Care Guide: alert below 60 or at 120 and above' "rrText";
        } "referenceRange";
        it.answer first as a then {
          a.value : Quantity as v where ($this.value < 60) -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'L' "cd";
              v -> icg.display = 'Low' "dsp";
            } "coding";
          } "interp_31";
        } "interpAnswer_32";
        it.answer first as a then {
          a.value : Quantity as v where ($this.value >= 120) -> obs.interpretation as interp then {
            v -> interp.coding as icg then {
              v -> icg.system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' "sys";
              v -> icg.code = 'H' "cd";
              v -> icg.display = 'High' "dsp";
            } "coding";
          } "interp_33";
        } "interpAnswer_34";
        row -> obs then SetHourTime(row, obs) "rowTime";
      } "obs_8867_4_35";
      g where ((item.where(linkId = 'hour.woman.systolic').answer.value.ofType(Quantity).exists() or item.where(linkId = 'hour.woman.diastolic').answer.value.ofType(Quantity).exists())) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
        qr -> obs, entry then BuildObsBase(qr, obs, entry) "base";
        qr -> obs then SetVitalSignsCategory(qr, obs) "category";
        g -> obs.code as cc then {
          g -> cc.coding as cg then {
            g -> cg.system = 'http://loinc.org' "sys";
            g -> cg.code = '85354-9' "cd";
            g -> cg.display = 'Blood pressure panel with all children optional' "dsp";
          } "coding";
        } "code";
        g.item as ci where (linkId = 'hour.woman.systolic' and answer.value.ofType(Quantity).exists()) -> obs.component as comp then {
          ci -> comp.code as cc then {
            ci -> cc.coding as cg then {
              ci -> cg.system = 'http://loinc.org' "sys";
              ci -> cg.code = '8480-6' "cd";
              ci -> cg.display = 'Systolic blood pressure' "dsp";
            } "coding";
          } "code";
