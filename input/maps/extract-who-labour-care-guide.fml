              cv.display as d -> vc.text = d "valueText";
            } "codedValue";
          } "answer";
          it -> obs.note as sn, sn.text = 'Recorded on the mother\'s record. This is a fact about the baby; the newborn\'s own chart is the authoritative record for it.' "subjectNote";
        } "obs_76689_9_83";
        g.item as it where (linkId = 'summary.baby.apgar1' and answer.value.exists()) -> bundle.entry as entry, entry.resource = create('Observation') as obs then {
