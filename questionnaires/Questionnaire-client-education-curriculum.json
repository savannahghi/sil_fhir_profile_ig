          "required": true
        },
        {
          "linkId": "client.admissionNumber",
          "type": "string",
          "text": "Admission number",
          "required": true
        }
      ]
    },
    {
      "linkId": "stageA",
      "type": "group",
      "text": "Early recovery therapy (4 weeks)",
      "item": [
        {
          "linkId": "stageA.orientation",
          "prefix": "1",
          "type": "date",
          "text": "Orientation"
        },
        {
          "linkId": "stageA.orientation.goal",
          "type": "display",
          "text": "3 days · Goal: Clients familiar with the programme"
        },
        {
          "linkId": "stageA.selfAcceptance",
          "prefix": "2",
          "type": "date",
          "text": "Self-acceptance and denial management"
        },
        {
          "linkId": "stageA.selfAcceptance.goal",
          "type": "display",
          "text": "2 days · Goal: Realisation of the addiction problem"
        },
        {
          "linkId": "stageA.rootCause",
          "prefix": "3",
          "type": "date",
          "text": "Identifying the root cause of addiction"
        },
        {
          "linkId": "stageA.rootCause.goal",
          "type": "display",
          "text": "2 days · Goal: Primary cause of addiction noted"
        },
        {
          "linkId": "stageA.understandingAddiction",
          "prefix": "4",
          "type": "date",
          "text": "Understanding addiction"
        },
        {
          "linkId": "stageA.understandingAddiction.goal",
          "type": "display",
          "text": "1 week · Goal: Clients equipped with drug and substance abuse information"
        },
        {
          "linkId": "stageA.effects",
          "prefix": "5",
          "type": "date",
          "text": "Effects of drugs and alcohol, including the correlation with HIV/AIDS"
        },
        {
          "linkId": "stageA.effects.goal",
          "type": "display",
          "text": "1 week · Goal: Clients informed on the advantages and disadvantages of drug and substance abuse"
        },
        {
          "linkId": "stageA.selfEsteem",
          "prefix": "6",
          "type": "date",
          "text": "Low self-esteem"
        },
        {
          "linkId": "stageA.selfEsteem.goal",
          "type": "display",
          "text": "2 days · Goal: Appreciation of self"
        },
        {
          "linkId": "stageA.timeAndLeisure",
          "prefix": "7",
          "type": "date",
          "text": "Time and leisure management"
        },
        {
          "linkId": "stageA.timeAndLeisure.goal",
          "type": "display",
          "text": "2 days · Goal: Constructive use of leisure in the centre"
        },
        {
          "linkId": "stageA.higherPower",
          "prefix": "8",
          "type": "date",
          "text": "The concept of a higher power or God"
        },
        {
          "linkId": "stageA.higherPower.goal",
          "type": "display",
          "text": "1 day · Goal: Appreciation of the existence of a higher power"
        },
        {
          "linkId": "stageA.prayer",
          "prefix": "9",
          "type": "date",
          "text": "Prayer, meditation and devotion"
        },
        {
          "linkId": "stageA.prayer.goal",
          "type": "display",
          "text": "1 day · Goal: Enhancing and understanding self"
        },
        {
          "linkId": "stageA.summaryEarly",
          "prefix": "10",
          "type": "date",
          "text": "Summary and preparation for late recovery"
        },
        {
          "linkId": "stageA.summaryEarly.goal",
          "type": "display",
          "text": "1 day · Goal: Clients are ready for the next stage"
        }
      ]
    },
    {
      "linkId": "stageB",
