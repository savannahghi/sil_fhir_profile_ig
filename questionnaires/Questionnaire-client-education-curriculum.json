      "text": "Late recovery therapy (1 to 2 months)",
      "item": [
        {
          "linkId": "stageB.anger",
          "prefix": "1",
          "type": "date",
          "text": "Anger and emotion management"
        },
        {
          "linkId": "stageB.anger.goal",
          "type": "display",
          "text": "1 week · Goal: Emotional stability and non-chemical means of coping with extreme emotions"
        },
        {
          "linkId": "stageB.characterDefects",
          "prefix": "2",
          "type": "date",
          "text": "Identifying and overcoming character and personality defects"
        },
        {
          "linkId": "stageB.characterDefects.goal",
          "type": "display",
          "text": "1 week · Goal: Self-awareness"
        },
        {
          "linkId": "stageB.personalityPrinciples",
          "prefix": "3",
          "type": "date",
          "text": "Personality and principles"
        },
        {
          "linkId": "stageB.personalityPrinciples.goal",
          "type": "display",
          "text": "1 week · Goal: Guidelines to an addiction-free life"
        },
        {
          "linkId": "stageB.guiltShameStress",
          "prefix": "4",
          "type": "date",
          "text": "Managing guilt, shame and stress"
        },
        {
          "linkId": "stageB.guiltShameStress.goal",
          "type": "display",
          "text": "1 week · Goal: Self-worth"
        },
        {
          "linkId": "stageB.virtuesValues",
          "prefix": "5",
          "type": "date",
          "text": "Virtues, values and attitude"
        },
        {
          "linkId": "stageB.virtuesValues.goal",
          "type": "display",
          "text": "1 week · Goal: New value systems practised"
        },
        {
          "linkId": "stageB.summaryLate",
          "prefix": "6",
          "type": "date",
          "text": "Summary and preparation for the maintenance stage"
        },
        {
          "linkId": "stageB.summaryLate.goal",
          "type": "display",
          "text": "1 week · Goal: Clients feel ready for the next stage"
        }
      ]
    },
    {
      "linkId": "stageC",
      "type": "group",
      "text": "Maintenance stage therapy (up to six months)",
      "item": [
        {
          "linkId": "stageC.familyCommunity",
          "prefix": "1",
          "type": "date",
          "text": "Family, friends and community"
        },
        {
          "linkId": "stageC.familyCommunity.goal",
          "type": "display",
          "text": "1 week · Goal: Better relationships with significant others"
        },
        {
          "linkId": "stageC.selfWorth",
          "prefix": "2",
          "type": "date",
          "text": "Self-worth and respect"
        },
        {
          "linkId": "stageC.selfWorth.goal",
          "type": "display",
          "text": "1 week · Goal: High self-esteem"
        },
        {
          "linkId": "stageC.lifeSkills",
          "prefix": "3",
          "type": "date",
          "text": "Life skills training"
        },
        {
          "linkId": "stageC.lifeSkills.goal",
          "type": "display",
          "text": "2 weeks · Goal: Knowledge of living with self and others"
        },
        {
          "linkId": "stageC.relapsePrevention",
          "prefix": "4",
          "type": "date",
          "text": "Slip and relapse prevention and management"
        },
        {
          "linkId": "stageC.relapsePrevention.goal",
          "type": "display",
          "text": "3 weeks · Goal: Managing peer influence and avoiding trigger factors"
        },
        {
          "linkId": "stageC.vocation",
          "prefix": "5",
          "type": "date",
          "text": "Vocation and preparation for re-integration"
        },
        {
          "linkId": "stageC.vocation.goal",
          "type": "display",
          "text": "Throughout treatment · Goal: Job placements, occupation plan and referrals, client by client"
        },
        {
          "linkId": "stageC.celebrating",
          "prefix": "6",
          "type": "date",
          "text": "Celebrating recovery"
        },
        {
          "linkId": "stageC.celebrating.goal",
          "type": "display",
          "text": "1 week to graduation · Goal: Co-counselling"
        },
        {
          "linkId": "stageC.summaryGraduation",
          "prefix": "7",
          "type": "date",
          "text": "Summary and preparation for graduation"
        },
        {
          "linkId": "stageC.summaryGraduation.goal",
          "type": "display",
          "text": "2 days before graduation · Goal: Client prepared for termination"
        },
        {
          "linkId": "stageC.graduation",
          "prefix": "8",
          "type": "date",
          "text": "Graduation from the programme"
        },
        {
          "linkId": "stageC.graduation.goal",
          "type": "display",
          "text": "After 3 months · Goal: Rejoining family and friends"
        }
