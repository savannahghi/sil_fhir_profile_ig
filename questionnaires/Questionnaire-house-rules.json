  "status": "draft",
  "subjectType": [
    "Patient"
  ],
  "date": "2026-09-17",
  "description": "The cardinal rules and ground norms of the centre, acknowledged by the client. Distinct from the admission consent form, which carries the same rules alongside consent to treatment.",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-targetStructureMap",
      "valueCanonical": "https://fhir.slade360.co.ke/fhir/StructureMap/ExtractHouseRules"
    }
  ],
  "item": [
    {
      "linkId": "client",
      "type": "group",
      "text": "Client",
      "item": [
        {
          "linkId": "client.name",
          "type": "string",
          "text": "Name",
          "required": true
        },
        {
          "linkId": "client.admissionNumber",
          "type": "string",
          "text": "Admission number",
          "required": true
        }
      ]
    },
    {
      "linkId": "cardinalRules",
      "type": "group",
      "text": "Cardinal rules",
      "item": [
        {
          "linkId": "cardinalRules.drugs",
          "type": "boolean",
          "text": "Drugs: I shall not at any time use or be found in possession of drugs, within or outside the premises, during the treatment period."
        },
        {
          "linkId": "cardinalRules.sex",
          "type": "boolean",
          "text": "Sex: no sexual act of any kind is acceptable during the treatment period."
        },
        {
          "linkId": "cardinalRules.violence",
          "type": "boolean",
          "text": "Violence: no verbal, physical or emotional abuse, including threats to staff or fellow clients, is allowed."
        },
        {
          "linkId": "cardinalRules.property",
          "type": "boolean",
          "text": "Destruction of property: I shall respect the property of clients, staff, the centre and the neighbourhood; destroying it will be penalised."
        },
        {
          "linkId": "cardinalRules.theft",
          "type": "boolean",
          "text": "Theft: no theft of property belonging to fellow clients, staff, the centre or neighbours will be tolerated during the treatment period."
        }
      ]
    },
    {
      "linkId": "groundNorms",
      "type": "group",
      "text": "Ground norms",
      "item": [
        {
          "linkId": "groundNorms.permission",
          "type": "boolean",
          "text": "I shall never leave the compound without permission from staff."
        },
        {
          "linkId": "groundNorms.stealing",
          "type": "boolean",
          "text": "I shall not steal or abuse."
        },
        {
          "linkId": "groundNorms.hygiene",
          "type": "boolean",
          "text": "I shall maintain the required standards of hygiene."
        },
        {
          "linkId": "groundNorms.abstinence",
          "type": "boolean",
          "text": "I shall abstain from all mood-altering substances."
        },
        {
          "linkId": "groundNorms.programme",
          "type": "boolean",
          "text": "I shall adhere to the daily programme and all required activities, and shall not abscond from the programme or any of its activities."
        },
        {
          "linkId": "groundNorms.conduct",
          "type": "boolean",
          "text": "I shall be responsible and uphold the set virtues and the moral and spiritual standards."
        },
        {
          "linkId": "groundNorms.prohibitedItems",
          "type": "boolean",
          "text": "I shall not be found in possession of illegal items, for example knives or drugs."
        }
      ]
    },
    {
      "linkId": "virtues",
      "type": "display",
      "text": "Key virtues: honesty, humility and self-acceptance."
    },
    {
      "linkId": "signature",
      "type": "group",
      "text": "Signature",
      "item": [
        {
          "linkId": "signature.signed",
          "type": "boolean",
          "text": "The client has signed this form"
        },
        {
          "linkId": "signature.date",
          "type": "date",
          "text": "Date signed",
          "required": true
        }
      ]
    }
  ],
